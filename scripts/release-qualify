#!/usr/bin/env python3
"""Qualify a release candidate; --self-test replaces only authenticated wake.

Logs and environment records are retained; short /tmp scratch roots are cleaned.
A failed step never suppresses other independent checks. Run from a Herdr pane for live qualification.
"""
from __future__ import annotations

import argparse
import concurrent.futures
import json
import os
import selectors
import signal
import shutil
from pathlib import Path
import subprocess
import sys
import tempfile
import threading
import time
import uuid

ROOT = Path(__file__).resolve().parent.parent


def newest_release(table: Path) -> str:
    versions = {line.split('\t')[0] for line in table.read_text().splitlines()
                if line.strip() and not line.startswith('#')}
    return max(versions, key=lambda v: tuple(map(int, v.split('.'))))


DOCTOR_PROBE_TIMEOUT = 5.0
DOCTOR_OUTPUT_LIMIT = 256 * 1024

def _unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError('ambiguous duplicate JSON key')
        result[key] = value
    return result


def _doctor_report(command=None):
    """Private bounded read-only probe; never retain its raw output or paths."""
    command = command or [str(ROOT / 'bin/herdr-threads'), 'doctor', '--json']
    child = subprocess.Popen(command, cwd=ROOT, env=os.environ.copy(), stdin=subprocess.DEVNULL,
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, start_new_session=True)
    output = bytearray()
    deadline = time.monotonic() + DOCTOR_PROBE_TIMEOUT
    selector = selectors.DefaultSelector()
    selector.register(child.stdout, selectors.EVENT_READ)
    try:
        while True:
            left = deadline - time.monotonic()
            if left <= 0:
                raise RuntimeError('queue mode canonical probe timed out')
            if not selector.select(left):
                raise RuntimeError('queue mode canonical probe timed out')
            chunk = os.read(child.stdout.fileno(), min(65536, DOCTOR_OUTPUT_LIMIT + 1 - len(output)))
            if not chunk:
                break
            output.extend(chunk)
            if len(output) > DOCTOR_OUTPUT_LIMIT:
                raise RuntimeError('queue mode canonical output bound exceeded')
        try:
            child.wait(timeout=max(0.001, deadline - time.monotonic()))
        except subprocess.TimeoutExpired:
            raise RuntimeError('queue mode canonical probe timed out') from None
        try:
            return json.loads(output, object_pairs_hook=_unique_object)
        except (ValueError, UnicodeError):
            raise RuntimeError('queue mode canonical probe returned invalid JSON') from None
    finally:
        selector.close()
        child.stdout.close()
        if child.poll() is None:
            try:
                os.killpg(child.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            child.wait(timeout=2)


def operator_programmatic_wake():
    report = _doctor_report()
    doctor = report.get('doctor') if isinstance(report, dict) else None
    node = doctor.get('node_dir') if isinstance(doctor, dict) else None
    if not isinstance(node, str) or not Path(node).is_absolute():
        raise RuntimeError('queue mode canonical node directory unresolved')
    try:
        with (Path(node) / 'settings.json').open('rb') as settings:
            raw = settings.read(4097)
    except FileNotFoundError:
        return False
    except (OSError, ValueError):
        raise RuntimeError('queue mode operator settings unreadable') from None
    if len(raw) > 4096:
        raise RuntimeError('queue mode operator settings bound exceeded')
    try:
        settings = json.loads(raw, object_pairs_hook=_unique_object)
    except (ValueError, UnicodeError):
        raise RuntimeError('queue mode operator settings invalid JSON') from None
    if not isinstance(settings, dict) or type(settings.get('programmatic_wake', False)) is not bool:
        raise RuntimeError('queue mode programmatic_wake must be a boolean')
    return settings.get('programmatic_wake', False)


def qualify(evidence: Path, self_test: bool, queue_proof: bool = False) -> int:
    evidence.mkdir(parents=True, exist_ok=True)
    results = []
    scratch_roots = []
    lock = threading.Lock()

    def environment(branch):
        scratch = Path(tempfile.mkdtemp(prefix='rq.', dir='/tmp'))
        scratch_roots.append(scratch)
        env = os.environ.copy()
        env.update(TMPDIR=str(scratch), TMP=str(scratch), TEMP=str(scratch),
                   HT_LEAK_RUN_ID=str(uuid.uuid4()),
                   HERDR_PLUGIN_STATE_DIR=str(scratch / 'state'),
                   XDG_STATE_HOME=str(scratch / 'xdg-state'),
                   HT_HERDR_RELEASE_CACHE=str(evidence / branch / 'herdr-cache'))
        (evidence / f'{branch}-environment.json').write_text(json.dumps(
            {k: env[k] for k in ('TMPDIR', 'HT_LEAK_RUN_ID', 'HERDR_PLUGIN_STATE_DIR')}, indent=2))
        return env

    def step(name, argv, env, budget=None):
        start = time.monotonic()
        with (evidence / f'{name}.log').open('w') as log:
            log.write('$ ' + ' '.join(argv) + '\n')
            log.flush()
            try:
                rc = subprocess.run(argv, cwd=ROOT, env=env, stdout=log,
                                    stderr=subprocess.STDOUT, check=False).returncode
            except OSError as error:
                log.write(str(error) + '\n')
                rc = 127
        elapsed = time.monotonic() - start
        result = dict(step=name, command=argv, exit=rc, seconds=round(elapsed, 2),
                      status='PASS' if rc == 0 and (budget is None or elapsed < budget) else 'FAIL')
        with lock:
            results.append(result)
        return result['status'] == 'PASS'

    def leak(name, env):
        if not step(name + '-leaks', ['scripts/check-no-leaked-processes', '--run-id',
                                      env['HT_LEAK_RUN_ID'], '--grace', '15'], env):
            step(name + '-cleanup', ['scripts/check-no-leaked-processes', '--run-id',
                                    env['HT_LEAK_RUN_ID'], '--kill'], env)

    env = environment('compiler')
    for name, argv in [
        ('fmt', ['cargo', 'fmt', '--all', '--', '--check']),
        ('neutral', ['scripts/check-harness-neutral']),
        ('wire-compat', ['scripts/check-wire-compat']),
        ('clippy-all', ['nice', 'cargo', 'clippy', '--locked', '--all-targets', '--all-features', '--', '-D', 'warnings']),
        ('clippy-default', ['nice', 'cargo', 'clippy', '--locked', '--all-targets', '--', '-D', 'warnings']),
        ('default-features', ['nice', 'scripts/check-default-features']),
        ('prebuild-tests', ['nice', 'cargo', 'nextest', 'run', '--locked', '--all-targets', '--all-features', '--no-run']),
        ('prebuild-proof', ['nice', 'sh', 'tests/service/check_failpoints_absent.sh', '--prebuild']),
    ]:
        step(name, argv, env)
    suite_env = environment('suite')
    try:
        step('suite', ['nice', 'cargo', 'nextest', 'run', '--locked', '--all-targets', '--all-features'], suite_env, 300)
    finally:
        leak('suite', suite_env)
    candidate_ok = step('candidate', ['nice', 'scripts/build.sh'], env)

    def blocked(name, reason='candidate build failed'):
        results.append(dict(step=name, command=[], exit=1, seconds=0, status='BLOCKED', error=reason))

    def matrix():
        branch = environment('matrix')
        try:
            step('upstream', ['scripts/herdr-release-smoke', '--check-upstream'], branch)
            step('matrix', ['scripts/herdr-release-smoke', '--jobs', '1', '--report', str(evidence / 'matrix.md'),
                            '--logs-dir', str(evidence / 'matrix-logs')], branch)
        finally:
            leak('matrix', branch)

    def wake():
        # Resolve under the untouched operator environment, before the isolated
        # branch gets its own state/XDG roots. Explicit proof never reads config.
        required = queue_proof
        mode_ok = True
        if not self_test and candidate_ok and not queue_proof and sys.platform == 'linux':
            started = time.monotonic()
            try:
                required = operator_programmatic_wake()
                results.append(dict(step='queue-mode', command=[], exit=0, seconds=round(time.monotonic()-started, 3),
                                    status='PASS', source='operator settings', programmatic_wake=required))
            except (OSError, RuntimeError) as error:
                mode_ok = False
                results.append(dict(step='queue-mode', command=[], exit=1, seconds=round(time.monotonic()-started, 3),
                                    status='FAIL', error=str(error) if isinstance(error, RuntimeError) else 'queue mode canonical probe unavailable'))
        branch = environment('wake')
        try:
            ready = step('wake-self-test', ['python3', 'scripts/wake-e2e.py', '--self-test'], branch)
            if not self_test and not candidate_ok:
                blocked('wake')
            elif not self_test and not mode_ok:
                blocked('wake', 'queue mode selection failed')
            elif not self_test and ready:
                step('wake', ['scripts/wake-e2e-herdr', newest_release(ROOT / 'tests/herdr-releases.tsv'),
                              '--evidence-dir', str(evidence / 'wake')] + (['--queue-proof'] if required else []), branch)
        finally:
            leak('wake', branch)

    # Only these two isolated branches overlap. Installers and lifecycle also
    # contain timing-sensitive tests, so they wait until the matrix has ended.
    with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
        futures = [pool.submit(matrix), pool.submit(wake)]
        for future in futures:
            try:
                future.result()
            except Exception as error:
                results.append(dict(step='branch-error', command=[], exit=1, seconds=0,
                                    status='FAIL', error=str(error)))
    branch = environment('package')
    try:
        step('package', ['nice', 'cargo', 'test', '--locked', '--all-features', '--test', 'package',
                         'install::clean_package_install_lifecycle', '--', '--ignored', '--exact', '--nocapture'], branch)
        for name in ('alias', 'integrations', 'daemon', 'terminal', 'backup'):
            argv = ['python3', f'tests/release/installer_{name}_test.py']
            if name in ('terminal', 'backup'):
                argv.append('bin/herdr-threads')
            if name in ('terminal', 'backup') and not candidate_ok:
                blocked('installer-' + name)
            else:
                step('installer-' + name, argv, branch)
        if candidate_ok:
            step('installer-shell', ['tests/release/install_test.sh', 'bin/herdr-threads'], branch)
        else:
            blocked('installer-shell')
    finally:
        leak('package', branch)
    for scratch in scratch_roots:
        try:
            shutil.rmtree(scratch)
        except OSError as error:
            results.append(dict(step='scratch-cleanup', command=[], exit=1, seconds=0,
                                status='FAIL', error=f'{scratch}: {error}'))
    summary = dict(mode='self-test (no live wake qualification)' if self_test else 'live', results=results)
    (evidence / 'summary.json').write_text(json.dumps(summary, indent=2) + '\n')
    print(summary['mode'])
    for result in results:
        print(f"{result['status']:4} {result['step']} ({result['seconds']}s, exit {result['exit']})")
    print(f'Evidence: {evidence}')
    return int(any(r['status'] != 'PASS' for r in results))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--self-test', action='store_true', help='replace authenticated wake only; all other commands run')
    parser.add_argument('--evidence-dir', type=Path)
    parser.add_argument('--queue-proof', action='store_true',
                        help='require Codex queue transport proof for supported Linux qualification')
    args = parser.parse_args()
    if args.queue_proof and sys.platform != 'linux':
        parser.error('--queue-proof requires Linux; use native qualification without this flag')
    evidence = (args.evidence_dir or Path(tempfile.mkdtemp(prefix='release-qualify-', dir='/tmp'))).resolve()
    return qualify(evidence, args.self_test, queue_proof=args.queue_proof)


if __name__ == '__main__':
    raise SystemExit(main())
