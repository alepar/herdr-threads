#!/bin/sh
# Validate and test the Claude Code mod (integrations/claude/mod) with the
# `claude` CLI under an isolated CLAUDE_CONFIG_DIR. Prints `skipped: <reason>`
# and exits 0 when `claude` is missing or older than the first build with
# `claude plugin test` (2.1.287).
set -u

MIN_VERSION=2.1.287
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mod="$root/integrations/claude/mod"

if ! command -v claude >/dev/null 2>&1; then
  echo "skipped: claude CLI not found on PATH"
  exit 0
fi

version=$(claude --version 2>/dev/null | sed -n 's/^\([0-9][0-9.]*\).*/\1/p' | head -n 1)
if [ -z "$version" ]; then
  echo "skipped: could not read the claude version"
  exit 0
fi

# true when $1 >= $2, comparing dotted numbers field by field
version_at_least() {
  have=$1
  want=$2
  for i in 1 2 3 4; do
    h=$(echo "$have" | cut -d. -f"$i")
    w=$(echo "$want" | cut -d. -f"$i")
    h=${h:-0}
    w=${w:-0}
    if [ "$h" -gt "$w" ]; then return 0; fi
    if [ "$h" -lt "$w" ]; then return 1; fi
  done
  return 0
}

if ! version_at_least "$version" "$MIN_VERSION"; then
  echo "skipped: claude $version is older than $MIN_VERSION (no claude plugin test)"
  exit 0
fi

config=$(mktemp -d "${TMPDIR:-/tmp}/ht-claude-mod.XXXXXX") || exit 1
trap 'rm -rf "$config"' EXIT INT TERM
CLAUDE_CONFIG_DIR=$config
export CLAUDE_CONFIG_DIR

echo "== claude plugin validate --strict ($version)"
claude plugin validate --strict "$mod" || exit 1
echo "== claude plugin test"
claude plugin test "$mod" || exit 1
