{
  "format": "agy-fake-gemini/1",
  "name": "wake-subagent",
  "aux_text": "Gate wake subagent title",
  "default": {"text": "WAKE-SUBAGENT-UNEXPECTED"},
  "vars": {"cwd": "/unset", "thread": "/unset"},
  "steps": [
    {"label": "f-parent-call", "match": {"contains": ["WAKE-PGEN"], "not_contains": ["WAKE-KIDGEN"]},
     "reply": {"call": "invoke_subagent",
               "args": {"Subagents": [{"Model": "inherit", "Prompt": "WAKE-KIDGEN say hi",
                                       "Role": "Gate Child", "TypeName": "self"}],
                        "toolAction": "Invoking subagent", "toolSummary": "spawn"}}},
    {"label": "f-child", "match": {"contains": ["WAKE-KIDGEN"]}, "delay_ms": 30000,
     "reply": {"text": "WAKE-KIDGEN-DONE"}},
    {"label": "f-parent-final", "match": {"contains": ["WAKE-PGEN"], "not_contains": ["WAKE-KIDGEN"]},
     "reply": {"text": "WAKE-F-DONE"}},
    {"label": "f-parent-after", "match": {"contains": ["WAKE-PGEN", "WAKE-KIDGEN-DONE"]},
     "reply": {"text": "WAKE-F-AFTER"}},
    {"label": "g-parent-call", "match": {"contains": ["WAKE-PTOOL"], "not_contains": ["WAKE-KIDTOOL"]},
     "reply": {"call": "invoke_subagent",
               "args": {"Subagents": [{"Model": "inherit", "Prompt": "WAKE-KIDTOOL run it",
                                       "Role": "Gate Child", "TypeName": "self"}],
                        "toolAction": "Invoking subagent", "toolSummary": "spawn"}}},
    {"label": "g-child-call", "match": {"contains": ["WAKE-KIDTOOL"]},
     "reply": {"call": "run_command",
               "args": {"CommandLine": "herdr-threads read {var.thread} --follow", "Cwd": "{var.cwd}",
                        "WaitMsBeforeAsync": 25000, "toolAction": "gate", "toolSummary": "gate"}}},
    {"label": "g-child-final", "match": {"contains": ["WAKE-KIDTOOL"]}, "reply": {"text": "WAKE-KIDTOOL-DONE"}},
    {"label": "g-parent-final", "match": {"contains": ["WAKE-PTOOL"], "not_contains": ["WAKE-KIDTOOL"]},
     "reply": {"text": "WAKE-G-DONE"}},
    {"label": "g-parent-after", "match": {"contains": ["WAKE-PTOOL", "WAKE-KIDTOOL-DONE"]},
     "reply": {"text": "WAKE-G-AFTER"}}
  ]
}
