{
  "format": "agy-fake-gemini/1",
  "name": "permission",
  "aux_text": "Gate permission title",
  "default": {
    "text": "PERMISSION-UNEXPECTED"
  },
  "steps": [
    {
      "label": "allowed-call",
      "match": {
        "contains": [
          "PERM-ALLOWED"
        ]
      },
      "reply": {
        "call": "run_command",
        "args": {
          "CommandLine": "herdr-threads --version"
        }
      }
    },
    {
      "label": "allowed-final",
      "match": {
        "contains": [
          "PERM-ALLOWED"
        ]
      },
      "reply": {
        "text": "PERM-ALLOWED-DONE"
      }
    },
    {
      "label": "denied-call",
      "match": {
        "contains": [
          "PERM-DENIED"
        ]
      },
      "reply": {
        "call": "run_command",
        "args": {
          "CommandLine": "herdr-threads --version; true"
        }
      }
    },
    {
      "label": "denied-final",
      "match": {
        "contains": [
          "PERM-DENIED"
        ]
      },
      "reply": {
        "text": "PERM-DENIED-DONE"
      }
    }
  ]
}
