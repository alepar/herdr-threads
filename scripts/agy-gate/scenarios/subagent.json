{
  "format": "agy-fake-gemini/1",
  "name": "subagent",
  "aux_text": "Gate subagent title",
  "default": {"text": "SUBAGENT-UNEXPECTED"},
  "steps": [
    {"label": "parent-call",
     "match": {"contains": ["PARENT-GO"], "not_contains": ["CHILD-PROMPT"]},
     "reply": {"call": "invoke_subagent",
               "args": {"Subagents": [{"Model": "inherit", "Prompt": "CHILD-PROMPT say hi",
                                       "Role": "Gate Child", "TypeName": "self"}]}}},
    {"label": "child",
     "match": {"contains": ["CHILD-PROMPT"]},
     "reply": {"text": "CHILD-OK"}},
    {"label": "parent-final",
     "match": {"contains": ["PARENT-GO"], "not_contains": ["CHILD-PROMPT"]},
     "reply": {"text": "PARENT-DONE"}}
  ]
}
