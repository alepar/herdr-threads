#!/usr/bin/env python3
"""E2E smoke against every official Herdr release the plugin supports.

  herdr-release-smoke [--versions V...] [--cache DIR] [--report FILE]
  herdr-release-smoke --check-upstream     # fail when GitHub has a release not listed
  herdr-release-smoke --update             # rewrite the list from GitHub (>= the floor)
  herdr-release-smoke --list

Releases and checksums come from tests/herdr-releases.tsv. For each version the
official binary for this host is downloaded once into the cache
(default ~/.cache/herdr-threads/herdr-releases/<version>/<asset>/herdr), its
SHA-256 checked against the list on every run, and the ignored test
`herdr_release_smoke::herdr_release_smoke` (tests/integration) runs with that
binary first on PATH. Every server and daemon lives in a private IsolatedHerdr
root; the shared Herdr server is never touched. Exit 0 only when every
selected release passes; the matrix is printed (and written to --report as
Markdown) either way.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import platform
import subprocess
import sys
import time
import urllib.request
import uuid
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LIST = ROOT / "tests" / "herdr-releases.tsv"
REPO = "herdrdev/herdr"
FLOOR = (0, 9, 1)
ASSETS = ("herdr-linux-aarch64", "herdr-linux-x86_64", "herdr-macos-aarch64", "herdr-macos-x86_64")
TEST = ["--test", "integration", "herdr_release_smoke", "--", "--ignored", "--exact",
        "herdr_release_smoke::herdr_release_smoke", "--nocapture"]


def vkey(v: str) -> tuple[int, ...]:
    return tuple(int(p) for p in v.split("."))


def host_asset() -> str:
    os_name = {"Darwin": "macos", "Linux": "linux"}.get(platform.system())
    arch = {"arm64": "aarch64", "aarch64": "aarch64", "x86_64": "x86_64"}.get(platform.machine())
    if not os_name or not arch:
        sys.exit(f"herdr-release-smoke: no official Herdr asset for {platform.system()} {platform.machine()}")
    return f"herdr-{os_name}-{arch}"


def read_list() -> dict[str, dict[str, str]]:
    releases: dict[str, dict[str, str]] = {}
    for line in LIST.read_text().splitlines():
        if line.strip() and not line.startswith("#"):
            version, asset, digest = line.split("\t")
            releases.setdefault(version, {})[asset] = digest
    return dict(sorted(releases.items(), key=lambda kv: vkey(kv[0])))


def upstream() -> dict[str, dict[str, str]]:
    """Official (non-draft, non-prerelease) vX.Y.Z releases at or above the floor."""
    releases: dict[str, dict[str, str]] = {}
    url = f"https://api.github.com/repos/{REPO}/releases?per_page=100"
    headers = {"Accept": "application/vnd.github+json"}
    if os.environ.get("GITHUB_TOKEN"):
        headers["Authorization"] = f"Bearer {os.environ['GITHUB_TOKEN']}"
    with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=60) as response:
        payload = json.load(response)
    for release in payload:
        tag = release["tag_name"]
        if release["draft"] or release["prerelease"] or not tag.startswith("v"):
            continue
        version = tag[1:]
        try:
            if vkey(version) < FLOOR:
                continue
        except ValueError:
            continue
        for asset in release["assets"]:
            digest = asset.get("digest") or ""
            if asset["name"] in ASSETS and digest.startswith("sha256:"):
                releases.setdefault(version, {})[asset["name"]] = digest.split(":", 1)[1]
    return dict(sorted(releases.items(), key=lambda kv: vkey(kv[0])))


def write_list(releases: dict[str, dict[str, str]]) -> None:
    header = [line for line in LIST.read_text().splitlines() if line.startswith("#")]
    rows = [f"{v}\t{a}\t{d}" for v, assets in releases.items() for a, d in sorted(assets.items())]
    LIST.write_text("\n".join(header + rows) + "\n")


def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def fetch(version: str, asset: str, digest: str, cache: Path) -> Path:
    """The cached official binary, downloaded when absent; always checksum-verified."""
    binary = cache / version / asset.removeprefix("herdr-") / "herdr"
    if not binary.exists():
        binary.parent.mkdir(parents=True, exist_ok=True)
        part = binary.with_suffix(".part")
        url = f"https://github.com/{REPO}/releases/download/v{version}/{asset}"
        with urllib.request.urlopen(url, timeout=300) as response, part.open("wb") as out:
            while chunk := response.read(1 << 20):
                out.write(chunk)
        part.rename(binary)
    actual = sha256(binary)
    if actual != digest:
        binary.unlink()
        raise RuntimeError(f"checksum mismatch for {asset} {version}: {actual} != {digest} (cache entry removed)")
    binary.chmod(0o755)
    reported = subprocess.run([str(binary), "--version"], capture_output=True, text=True).stdout.strip()
    if reported != f"herdr {version}":
        raise RuntimeError(f"{binary} reports {reported!r}, expected 'herdr {version}'")
    return binary


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--versions", nargs="+", help="subset of listed versions (default: all)")
    parser.add_argument("--cache", type=Path, default=Path(os.environ.get(
        "HT_HERDR_RELEASE_CACHE", Path.home() / ".cache/herdr-threads/herdr-releases")))
    parser.add_argument("--report", type=Path, help="also write the matrix as Markdown")
    parser.add_argument("--list", action="store_true", help="print the listed versions")
    parser.add_argument("--check-upstream", action="store_true",
                        help="fail when GitHub's official releases differ from the list")
    parser.add_argument("--update", action="store_true", help="rewrite the list from GitHub")
    args = parser.parse_args()

    listed = read_list()
    if args.list:
        print("\n".join(listed))
        return 0
    if args.check_upstream or args.update:
        remote = upstream()
        if args.update:
            write_list(remote)
            print(f"wrote {LIST.relative_to(ROOT)}: {', '.join(remote)}")
            return 0
        problems = [f"missing from list: {v}" for v in remote if v not in listed]
        problems += [f"digest differs: {v} {a}" for v, assets in remote.items() if v in listed
                     for a, d in assets.items() if listed[v].get(a) != d]
        problems += [f"listed but not an official release: {v}" for v in listed if v not in remote]
        for problem in problems:
            print(f"herdr-release-smoke: {problem}", file=sys.stderr)
        print(f"upstream official releases >= {'.'.join(map(str, FLOOR))}: {', '.join(remote)}")
        return 1 if problems else 0

    versions = args.versions or list(listed)
    unknown = [v for v in versions if v not in listed]
    if unknown:
        sys.exit(f"herdr-release-smoke: not in {LIST.name}: {', '.join(unknown)}")
    asset = host_asset()
    head = subprocess.run(["git", "rev-parse", "--short", "HEAD"], cwd=ROOT,
                          capture_output=True, text=True).stdout.strip()
    env = dict(os.environ)
    env.setdefault("HT_LEAK_RUN_ID", str(uuid.uuid4()))
    build = subprocess.run(["cargo", "test", "--locked", "--all-features", "--no-run", "--test", "integration"],
                           cwd=ROOT, env=env)
    if build.returncode != 0:
        return build.returncode

    results: list[tuple[str, str, float, str]] = []
    for version in versions:
        started = time.monotonic()
        try:
            binary = fetch(version, asset, listed[version][asset], args.cache)
        except (RuntimeError, OSError, KeyError) as error:
            results.append((version, "ERROR", 0.0, str(error)))
            continue
        run_env = dict(env, PATH=f"{binary.parent}{os.pathsep}{env['PATH']}", HT_HERDR_SMOKE_VERSION=version)
        sys.stdout.flush(); print(f"=== herdr {version} ({asset}) ===", flush=True)
        run = subprocess.run(["cargo", "test", "--locked", "--all-features", *TEST], cwd=ROOT, env=run_env,
                             capture_output=True, text=True)
        sys.stdout.write(run.stdout[-6000:])
        sys.stderr.write(run.stderr[-6000:])
        detail = ""
        if run.returncode != 0:
            panics = [line for line in (run.stdout + run.stderr).splitlines() if "panicked at" in line
                      or "failed (" in line or "timed out" in line]
            detail = (panics[-1] if panics else f"exit {run.returncode}")[:300]
        results.append((version, "PASS" if run.returncode == 0 else "FAIL", time.monotonic() - started, detail))

    leak = subprocess.run([str(ROOT / "scripts/check-no-leaked-processes"), "--run-id", env["HT_LEAK_RUN_ID"]],
                          cwd=ROOT)
    lines = [f"Herdr release smoke at {head} on {asset}", "",
             "| Herdr | Result | Time | Detail |", "| --- | --- | --- | --- |"]
    lines += [f"| {v} | {r} | {t:.1f}s | {d.replace('|', '/')} |" for v, r, t, d in results]
    lines += ["", f"Leak check: {'clean' if leak.returncode == 0 else 'LEAKS (see above)'}"]
    print("\n".join(lines))
    if args.report:
        args.report.write_text("\n".join(lines) + "\n")
    ok = all(r == "PASS" for _, r, _, _ in results) and leak.returncode == 0
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
