<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>herdr-threads third-party licenses</title></head>
<body>
<h1>Third-party licenses</h1>
<p>herdr-threads statically links the following crates.</p>
<h2>License summary</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<h3>Used by</h3>
<ul>
{{#each used_by}}
<li>{{crate.name}} {{crate.version}}{{#if crate.repository}} (<a href="{{crate.repository}}">{{crate.repository}}</a>){{/if}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
