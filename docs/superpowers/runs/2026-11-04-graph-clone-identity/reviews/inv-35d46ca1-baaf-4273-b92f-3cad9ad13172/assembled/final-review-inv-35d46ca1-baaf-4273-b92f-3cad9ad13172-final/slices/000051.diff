+test('a pane seat: the continuity key is forwarded, and the seat is still a pane seat', async ($, on) => {
+  const spawned = await startMod($, on, { HERDR_THREADS_CONTINUITY_KEY: 'clone-1' }, [connected])
+  expect(spawned[0].argv).toEqual(['ht-named', 'watch', '--harness', 'claude', '--session', 'named-1'])
+  expect(spawned[0].env).toEqual({ HERDR_THREADS_CONTINUITY_KEY: 'clone-1' })
+})
+
+test('a pane seat with a key still stops permanently on no_pane', async () => {
+  const h = await coreWith({ HERDR_THREADS_CONTINUITY_KEY: 'clone-1' })
+  h.spawns[0].cb.line(status('refused', 'no_pane', 3))
+  h.spawns[0].cb.exit(3)
+  await h.advance(60_000)
+  expect(h.core.snapshot().stopped).toBe(true)
+  h.core.dispose()
+})
