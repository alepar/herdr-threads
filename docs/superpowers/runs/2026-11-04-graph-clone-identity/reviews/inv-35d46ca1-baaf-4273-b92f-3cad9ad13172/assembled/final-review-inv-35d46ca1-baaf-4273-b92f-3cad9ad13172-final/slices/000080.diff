+    /// Kills: a keyless request's bytes changing, or a key not reaching the wire.
+    #[test]
+    fn continuity_key_is_absent_from_the_wire_when_none() {
+        let commands = |key: Option<ContinuityKey>| {
+            [
+                Command::CheckIn(CheckIn {
+                    claim: claim(),
+                    mode: CheckInMode::Current,
+                    operation: OperationId::new("op"),
+                    lineage_parent: None,
+                    readonly: false,
+                    continuity_key: key.clone(),
+                }),
+                Command::ResolveSeat(ResolveSeat {
+                    target: HostTargetId::new("w1:p1"),
+                    host: host("/explicit.sock"),
+                    operation: OperationId::new("op"),
+                    locator_hint: None,
+                    tmux_hint: None,
+                    continuity_key: key.clone(),
+                }),
+                Command::ContinuityCheckIn(ContinuityCheckIn {
+                    target: HostTargetId::new("w1:p1"),
+                    host: host("/explicit.sock"),
+                    harness: Harness::Codex,
+                    native_session: NativeSessionId::new("n"),
+                    source: "resume".into(),
+                    operation: OperationId::new("op"),
+                    execution: ExecutionId::new("e"),
+                    liveness: None,
+                    continuity_key: key,
+                }),
+            ]
+        };
+        for command in commands(None) {
+            let wire = serde_json::to_value(&command).unwrap();
+            let args = wire["args"].as_object().unwrap();
+            assert!(!args.contains_key("continuity_key"), "{wire}");
+        }
+        for command in commands(Some(ContinuityKey::new("clone-1"))) {
+            let wire = serde_json::to_value(&command).unwrap();
+            assert_eq!(wire["args"]["continuity_key"], "clone-1", "{wire}");
+            assert_eq!(serde_json::from_value::<Command>(wire).unwrap(), command);
+        }
+    }
+
