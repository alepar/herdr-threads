+/// Whether the running command's caller is a top-level session: a person, an unattributed plain
+/// call or a top-level agent. A subagent and a refused origin are not.
+pub(super) fn active_is_top_level() -> bool {
+    is_top_level(active().as_ref())
+}
+
+/// Whether `origin` is a top-level session, as [`active_is_top_level`] words it, for a branch that
+/// runs outside the caller guard and derives the origin itself.
+pub(super) fn is_top_level(origin: Option<&CallerOrigin>) -> bool {
+    match origin {
+        Some(CallerOrigin::Agent(claim)) => claim.role == CallerRole::TopLevel,
+        Some(CallerOrigin::Refused(_)) => false,
+        _ => true,
+    }
+}
