+    /// The key `event` presents: a top-level, non-subagent event's, when the daemon advertises
+    /// `seat.continuity_key_v1`.
+    fn continuity_key(
+        &self,
+        event: &LifecycleEvent,
+    ) -> Option<crate::protocol::ids::ContinuityKey> {
+        super::site_capability::presented_continuity_key(
+            &self.caller,
+            event.role == Role::TopLevel && event.agent_id.is_none(),
+            self.client,
+            &budget(self.deadline, self.clock.as_ref()),
+        )
+    }
+
+    /// [`Self::continuity_key`] for an enrollment, which tells an unread capability from a no.
+    fn key_presentation(&self, event: &LifecycleEvent) -> super::site_capability::PresentedKey {
+        super::site_capability::continuity_key_presentation(
+            &self.caller,
+            event.role == Role::TopLevel && event.agent_id.is_none(),
+            self.client,
+            &budget(self.deadline, self.clock.as_ref()),
+        )
+    }
+
+    /// A pane reading resolved may be a restored one (the same pane id, a new incarnation) the
+    /// daemon has not reconciled yet. Resume probes it, and so does a lifecycle event presenting a
+    /// key: a fresh agent has no later event to wait for, so its claim must reach the daemon, which
+    /// keeps it through the lag. A current mapping refuses the claim and takes the ordinary check-in.
+    fn probes_resolved_pane(&self, event: &LifecycleEvent) -> bool {
+        event.kind == EventKind::Resume
+            || (event.kind.mode() == crate::harness::context::CheckInMode::Lifecycle
+                && self.continuity_key(event).is_some())
+    }
+
+    /// A claim left pending: the kept intent retries on the next event. A keyed one is unseen by
+    /// the model and never falls back to a keyless enrollment.
+    fn pending_failure(&self, event: &LifecycleEvent, detail: &str) -> Failure {
+        if self.continuity_key(event).is_some() {
+            Failure::Quiet(detail.into())
+        } else {
+            Failure::Unavailable(detail.into())
+        }
+    }
