+/// The public `SeatInspect` read of `seat`.
+fn inspect(node: &N, seat: &SeatId) -> crate::protocol::results::SeatInspection {
+    use crate::protocol::{
+        commands::{Command, SeatInspectQuery},
+        pagination::PageRequest,
+        results::CommandResult,
+        time::{CallBudget, Cancellation},
+    };
+    let result = crate::store::queries::query(
+        node.ctx(),
+        &node.instance,
+        &Command::SeatInspect(SeatInspectQuery {
+            seat: seat.clone(),
+            page: PageRequest::default(),
+        }),
+        &CallBudget {
+            deadline: MonoInstant(u64::MAX),
+            cancellation: Cancellation::default(),
+        },
+    )
+    .unwrap();
+    let CommandResult::SeatInspect(inspection) = result else {
+        panic!("seat inspect answered {result:?}");
+    };
+    inspection
+}
+
+/// The `operator_retire` decision in `seat`'s history, which must read `-` for both empty ids.
+fn assert_operator_retire_has_no_evidence(node: &N, seat: &SeatId) {
+    use crate::protocol::results::{SeatHistoryItem, SeatRetirementState};
+    let inspection = inspect(node, seat);
+    assert_eq!(
+        inspection.retirement_state,
+        Some(SeatRetirementState::Final)
+    );
+    let decision = inspection
+        .history
+        .items
+        .iter()
+        .find_map(|item| match item {
+            SeatHistoryItem::Repair(repair) if repair.decision_kind == "operator_retire" => {
+                Some(repair)
+            }
+            _ => None,
+        })
+        .expect("the operator_retire decision");
+    assert_eq!(decision.target.as_str(), "-");
+    assert_eq!(decision.host_boot.as_str(), "-");
+}
+
+/// Kills: the history read panicking on the empty ids `operator::retire_seat` writes for a seat with
+/// no target and no binding.
+#[test]
+fn operator_retire_of_a_seat_with_no_target_reads_back() {
+    let home = node(108, 1);
+    let seat = SeatId::new(generate_public_id(prefix::SEAT, &tag_for(home.id, 0)));
+    home.ctx()
+        .open_writer()
+        .unwrap()
+        .execute(
+            "INSERT INTO seats(id,instance_id,state,unresolved_reason,role,generation,target_generation,created_at,home_node,is_local,host_id) \
+             VALUES (?1,?2,'unresolved','other','native',1,1,0,?2,1,(SELECT min(host_id) FROM herdr_hosts))",
+            params![seat.as_str(), home.instance],
+        )
+        .unwrap();
+    let mut db = home.ctx().open_writer().unwrap();
+    crate::store::seats::mutate_operator(
+        home.ctx(),
+        &mut db,
+        &home.instance,
+        crate::ports::OperatorRequest::Retire(OperatorRetire {
+            seat: seat.clone(),
+            operation: OperationId::new("retire"),
+        }),
+        operator_actor(),
+        None,
+    )
+    .unwrap();
+    assert_operator_retire_has_no_evidence(&home, &seat);
+}
