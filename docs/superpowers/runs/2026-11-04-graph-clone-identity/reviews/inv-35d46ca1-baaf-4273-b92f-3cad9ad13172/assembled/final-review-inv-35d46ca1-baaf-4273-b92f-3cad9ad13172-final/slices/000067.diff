+/// What a caller may present to this daemon. `Unknown` is a key whose capability could not be read:
+/// an enrollment waits for the next event rather than go keyless (spec 4.2).
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum PresentedKey {
+    Absent,
+    Present(ContinuityKey),
+    Unknown,
+}
+
+/// The presentation of a caller's key ([`caller_continuity_key`]). A caller with no valid key and a
+/// subagent ask the daemon nothing, so their requests and round trips are unchanged. The client
+/// caches a failed read as no capabilities, so a keyed caller on a daemon not known to advertise
+/// asks afresh: only a definitive answer is a no. A fresh list naming the capability is `Unknown`
+/// too: this process's cached reading stands for every other key it sends, and the next event
+/// reads again.
+pub(crate) fn continuity_key_presentation<C: LocalClient + ?Sized>(
+    env: &CallerEnv,
+    top_level: bool,
+    client: &C,
+    budget: &CallBudget,
+) -> PresentedKey {
+    if !env.may_present_key(top_level) {
+        return PresentedKey::Absent;
+    }
+    if client.supports_capability(SEAT_CONTINUITY_KEY_V1, budget) {
+        return caller_continuity_key(env, top_level, true)
+            .map_or(PresentedKey::Absent, PresentedKey::Present);
+    }
+    match client.call_definitive(Command::Capabilities, budget) {
+        Ok(Ok(CommandResult::Capabilities(list)))
+            if !list
+                .capabilities
+                .iter()
+                .any(|c| c == SEAT_CONTINUITY_KEY_V1) =>
+        {
+            PresentedKey::Absent
+        }
+        Ok(Err(error))
+            if matches!(
+                error.code,
+                ErrorCode::UnknownWireVersion | ErrorCode::Unsupported
+            ) =>
+        {
+            PresentedKey::Absent
+        }
+        _ => PresentedKey::Unknown,
+    }
+}
+
+/// [`continuity_key_presentation`] for a caller that only sends the key: `Unknown` sends none.
+pub(crate) fn presented_continuity_key<C: LocalClient + ?Sized>(
+    env: &CallerEnv,
+    top_level: bool,
+    client: &C,
+    budget: &CallBudget,
+) -> Option<ContinuityKey> {
+    match continuity_key_presentation(env, top_level, client, budget) {
+        PresentedKey::Present(key) => Some(key),
+        PresentedKey::Absent | PresentedKey::Unknown => None,
+    }
+}
+
+/// The key a plain CLI resolve of `target` presents: the caller's own pane on its own server only,
+/// never a pane it resolves for someone else. Unknown or subagent callers present nothing. A plain
+/// call offers no evidence to reattach on, so a key bound elsewhere refuses and mints no seat
+/// (spec 4.2).
+pub(crate) fn own_pane_continuity_key<C: LocalClient + ?Sized>(
+    env: &CallerEnv,
+    target: &HostTargetId,
+    top_level: bool,
+    on_own_server: bool,
+    client: &C,
+    budget: &CallBudget,
+) -> Option<ContinuityKey> {
+    presented_continuity_key(
+        env,
+        top_level && env.is_own_pane(target, on_own_server),
+        client,
+        budget,
+    )
+}
+
+/// The key of a resolve that runs outside the caller guard, so `caller::active` no longer answers:
+/// its top-level test derives the origin from `parsed`.
+pub(crate) fn resolve_arm_key<C: LocalClient + ?Sized>(
+    parsed: &ParsedCli,
+    env: &CallerEnv,
+    target: &HostTargetId,
+    on_own_server: bool,
+    client: &C,
+    budget: &CallBudget,
+) -> Option<ContinuityKey> {
+    if !env.may_present_key(true) {
+        return None;
+    }
+    let origin = caller::derive(parsed);
+    own_pane_continuity_key(
+        env,
+        target,
+        caller::is_top_level(origin.as_ref()),
+        on_own_server,
+        client,
+        budget,
+    )
+}
