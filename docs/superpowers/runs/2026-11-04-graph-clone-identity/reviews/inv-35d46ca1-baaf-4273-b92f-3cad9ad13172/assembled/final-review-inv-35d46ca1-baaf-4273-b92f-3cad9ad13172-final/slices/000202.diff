+/// Node schema 16 (ht-ma6i.5). Kills: losing or changing a seat, retirement, decision or kept
+/// claim row, restarting the decision sequence, dropping either decision index.
+#[test]
+fn graph_clone_identity_upgrade_keeps_seats_retirements_and_decisions() {
+    let db = Connection::open_in_memory().unwrap();
+    open_with(&db, &schema::NODE_DELTAS[..14]).unwrap();
+    assert_eq!(user_version(&db), 15);
+    crate::test_support::attach_test_host_to_connection(&db);
+    db.execute_batch(
+        "UPDATE herdr_hosts SET host_boot='b',host_epoch=1;
+         INSERT INTO seats(id,instance_id,state,role,target_id,generation,target_generation,created_at,home_node,is_local,host_id)
+           VALUES ('live',(SELECT id FROM local_node),'resolved','native','pane-live',1,1,0,(SELECT id FROM local_node),1,(SELECT min(host_id) FROM herdr_hosts));
+         INSERT INTO seats(id,instance_id,state,role,generation,created_at,home_node,is_local,host_id)
+           VALUES ('gone',(SELECT id FROM local_node),'resolved','native',2,0,(SELECT id FROM local_node),1,(SELECT min(host_id) FROM herdr_hosts));
+         UPDATE seats SET state='retired',retired_at=300,retired_seq=7 WHERE id='gone';
+         INSERT INTO retirements(id,seat_id,cutover_at,closure_boot,closure_epoch,closure_target,closure_generation,closure_evidence)
+           VALUES ('job-gone','gone',300,'b',1,'pane-gone',2,'restored_pane_closed');
+         INSERT INTO allocation_decisions(ordinal,host_id,target_id,seat_id,kind,decided_at,host_boot,epoch,generation,operator_label,continuity_diagnostic)
+           VALUES (3,(SELECT min(host_id) FROM herdr_hosts),'t3','live','ordinary',3,'b',1,2,'op',NULL),
+                  (9,(SELECT min(host_id) FROM herdr_hosts),'t9','gone','structural_process_continuity',9,'b',1,2,NULL,'match');
+         INSERT INTO kept_continuity_claims(host_id,target_id,harness,native_session,command_json,received_at)
+           VALUES ((SELECT min(host_id) FROM herdr_hosts),'pane-x','claude','sess','{}',5);",
+    )
+    .unwrap();
+    let snapshot = |db: &Connection| -> [String; 4] {
+        [
+            "SELECT json_group_array(json_array(id,state,target_id,generation,retired_at,retired_seq)) FROM (SELECT * FROM seats ORDER BY id)",
+            "SELECT json_group_array(json_array(ordinal,id,seat_id,cutover_at,closure_boot,closure_epoch,closure_target,closure_generation,closure_evidence,origin,phase,status)) FROM (SELECT * FROM retirements ORDER BY ordinal)",
+            "SELECT json_group_array(json_array(ordinal,host_id,target_id,seat_id,kind,decided_at,host_boot,epoch,generation,operator_label,continuity_diagnostic)) FROM (SELECT * FROM allocation_decisions ORDER BY ordinal)",
+            "SELECT json_group_array(json_array(host_id,target_id,harness,native_session,command_json,received_at)) FROM kept_continuity_claims",
+        ]
+        .map(|sql| db.query_row(sql, [], |r| r.get(0)).unwrap())
+    };
+    let before = snapshot(&db);
+    open_with(&db, schema::NODE_DELTAS).unwrap();
+    assert_eq!(user_version(&db), schema::NODE_LATEST_SCHEMA_VERSION);
+    assert_eq!(snapshot(&db), before);
+    let null_columns: i64 = db
+        .query_row(
+            "SELECT (SELECT count(*) FROM retirements WHERE absence_evidence IS NULL) + (SELECT count(*) FROM kept_continuity_claims WHERE continuity_key IS NULL)",
+            [],
+            |r| r.get(0),
+        )
+        .unwrap();
+    assert_eq!(null_columns, 2, "the added columns start NULL on old rows");
+    db.execute(
+        "INSERT INTO allocation_decisions(host_id,target_id,seat_id,kind,decided_at,host_boot,epoch,generation) VALUES ((SELECT min(host_id) FROM herdr_hosts),'t','live','service_unretire',1,'b',1,2)",
+        [],
+    )
+    .unwrap();
+    assert_eq!(
+        db.last_insert_rowid(),
+        10,
+        "the sequence continues past the copied rows"
+    );
+    for index in [
+        "allocation_decisions_target",
+        "allocation_decisions_seat_history",
+    ] {
+        assert!(object_exists(&db, "index", index), "{index} missing");
+    }
+    for table in [
+        "seat_shell_fingerprints",
+        "continuity_keys",
+        "continuity_key_conflicts",
+        "continuity_alerts",
+        "reversible_retirements",
+        "restored_target_absence",
+    ] {
+        assert!(table_exists(&db, table), "{table} missing");
+    }
+}
