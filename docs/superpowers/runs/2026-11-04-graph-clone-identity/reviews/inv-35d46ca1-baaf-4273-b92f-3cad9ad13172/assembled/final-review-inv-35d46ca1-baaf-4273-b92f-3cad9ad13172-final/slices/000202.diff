+/// Node schema 16 (ht-ma6i.5). Kills: a dropped CHECK, UNIQUE or AUTOINCREMENT on the new tables.
+#[test]
+fn graph_clone_identity_tables_enforce_their_checks() {
+    let db = Connection::open_in_memory().unwrap();
+    open_with(&db, schema::NODE_DELTAS).unwrap();
+    crate::test_support::attach_test_host_to_connection(&db);
+    db.execute_batch(
+        "INSERT INTO seats(id,instance_id,state,role,generation,created_at,home_node,is_local,host_id)
+           VALUES ('s1',(SELECT id FROM local_node),'resolved','native',1,0,(SELECT id FROM local_node),1,(SELECT min(host_id) FROM herdr_hosts)),
+                  ('s2',(SELECT id FROM local_node),'resolved','native',1,0,(SELECT id FROM local_node),1,(SELECT min(host_id) FROM herdr_hosts)),
+                  ('s3',(SELECT id FROM local_node),'resolved','native',1,0,(SELECT id FROM local_node),1,(SELECT min(host_id) FROM herdr_hosts));
+         INSERT INTO service_authors(id,instance_id,created_at) VALUES ('graph',(SELECT id FROM local_node),0);",
+    )
+    .unwrap();
+
+    let key = |key: &str, seat: Option<&str>, bound_at: Option<i64>, bound_by: Option<&str>| {
+        db.execute(
+            "INSERT INTO continuity_keys(key,owner_author_id,seat_id,reserved_at,bound_at,bound_by) VALUES (?1,'graph',?2,0,?3,?4)",
+            params![key, seat, bound_at, bound_by],
+        )
+    };
+    key("unbound", None, None, None).unwrap();
+    assert!(key("k-other", Some("s1"), Some(1), Some("other")).is_err());
+    key("k-check-in", Some("s1"), Some(1), Some("check_in")).unwrap();
+    key(
+        "k-service",
+        Some("s2"),
+        Some(1),
+        Some("service_reservation"),
+    )
+    .unwrap();
+    assert!(key("k-no-by", Some("s3"), Some(1), None).is_err());
+    assert!(key("k-no-seat", None, None, Some("check_in")).is_err());
+    assert!(key("k-no-at", Some("s3"), None, Some("check_in")).is_err());
+    assert!(
+        key("k-second", Some("s1"), Some(1), Some("check_in")).is_err(),
+        "one key per seat"
+    );
+    assert!(key("", None, None, None).is_err());
+    assert!(key(&"k".repeat(129), None, None, None).is_err());
+    key(&"k".repeat(128), None, None, None).unwrap();
+
+    let conflict = |target: &str, kind: &str| {
+        db.execute(
+            "INSERT INTO continuity_key_conflicts(host_id,target_id,key,kind,seat_id,owner_seat_id,first_seen_at,updated_at) VALUES ((SELECT min(host_id) FROM herdr_hosts),?1,'unbound',?2,'s1','s2',1,2)",
+            params![target, kind],
+        )
+    };
+    for (index, kind) in [
+        "key_live_elsewhere",
+        "key_retired_reversibly",
+        "pane_owned_by_other_seat",
+        "session_matches_other_seat",
+        "seat_holds_other_key",
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        conflict(&format!("pane-{index}"), kind).unwrap();
+    }
+    // The Rust and SQL kind lists cannot drift: every serde name is admitted by both tables.
+    for (index, kind) in [
+        crate::protocol::results::ContinuityConflictKind::KeyLiveElsewhere,
+        crate::protocol::results::ContinuityConflictKind::KeyRetiredReversibly,
+        crate::protocol::results::ContinuityConflictKind::PaneOwnedByOtherSeat,
+        crate::protocol::results::ContinuityConflictKind::SessionMatchesOtherSeat,
+        crate::protocol::results::ContinuityConflictKind::SeatHoldsOtherKey,
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        let name = serde_json::to_value(kind).unwrap();
+        let name = name.as_str().unwrap();
+        conflict(&format!("serde-{index}"), name).unwrap();
+        db.execute(
+            "INSERT INTO continuity_alerts(key,host_id,target_id,kind,at) VALUES ('k',(SELECT min(host_id) FROM herdr_hosts),'pane',?1,1)",
+            [name],
+        )
+        .unwrap();
+    }
+    assert!(conflict("pane-bogus", "bogus").is_err());
+    assert!(
+        conflict("pane-0", "key_live_elsewhere").is_err(),
+        "one standing conflict per pane"
+    );
+    for column in ["owner_seat_id", "updated_at"] {
+        assert!(
+            column_exists(&db, "continuity_key_conflicts", column),
+            "{column}"
+        );
+    }
+
+    let alert = || {
+        db.execute(
+            "INSERT INTO continuity_alerts(key,seat_id,host_id,target_id,kind,at) VALUES ('gone-key',NULL,(SELECT min(host_id) FROM herdr_hosts),'pane','key_live_elsewhere',1)",
+            [],
+        )
+        .unwrap();
+        db.last_insert_rowid()
+    };
+    let first = alert();
+    db.execute("DELETE FROM continuity_alerts WHERE ordinal=?1", [first])
+        .unwrap();
+    assert!(alert() > first, "ordinals grow across eviction");
+
+    let reversible = |seat: &str,
+                      state: &str,
+                      unretired_at: Option<i64>,
+                      closure: Option<&str>,
+                      absence: Option<&str>| {
+        db.execute(
+            "INSERT INTO reversible_retirements(seat_id,state,cutover_at,reason,closure_evidence,absence_evidence,unretired_at) VALUES (?1,?2,1,'closed',?3,?4,?5)",
+            params![seat, state, closure, absence, unretired_at],
+        )
+    };
+    assert!(reversible("s1", "other", None, None, None).is_err());
+    assert!(reversible("s1", "unretired", None, None, None).is_err());
+    assert!(reversible("s1", "reversible", Some(5), None, None).is_err());
+    assert!(reversible("s1", "reversible", None, Some("bogus"), None).is_err());
+    assert!(reversible("s1", "reversible", None, None, Some("bogus")).is_err());
+    reversible(
+        "s1",
+        "reversible",
+        None,
+        Some("restored_pane_closed"),
+        Some("restored_target_absent"),
+    )
+    .unwrap();
+    reversible("s2", "unretired", Some(5), None, None).unwrap();
+
+    db.execute(
+        "INSERT INTO retirements(id,seat_id,cutover_at,closure_boot,closure_epoch,closure_target,closure_generation,closure_evidence) VALUES ('job-s3','s3',300,'b',1,'pane',2,'restored_pane_closed')",
+        [],
+    )
+    .unwrap();
+    assert!(
+        db.execute("UPDATE retirements SET absence_evidence='bogus'", [])
+            .is_err()
+    );
+    db.execute(
+        "UPDATE retirements SET absence_evidence='restored_target_absent'",
+        [],
+    )
+    .unwrap();
+}
