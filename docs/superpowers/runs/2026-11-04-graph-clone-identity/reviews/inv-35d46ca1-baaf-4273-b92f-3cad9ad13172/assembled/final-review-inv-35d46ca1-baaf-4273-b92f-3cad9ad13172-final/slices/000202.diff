+#[test]
+fn seat_retirement_terminal_relaxes_only_for_a_reversible_row() {
+    let db = Connection::open_in_memory().unwrap();
+    open_with(&db, schema::NODE_DELTAS).unwrap();
+    crate::test_support::attach_test_host_to_connection(&db);
+    db.execute_batch(
+        "INSERT INTO seats(id,instance_id,state,role,generation,created_at,home_node,is_local,host_id)
+           VALUES ('gone',(SELECT id FROM local_node),'resolved','native',2,0,(SELECT id FROM local_node),1,(SELECT min(host_id) FROM herdr_hosts));
+         UPDATE seats SET state='retired',retired_at=300,retired_seq=7 WHERE id='gone';",
+    )
+    .unwrap();
+    let unretire = "UPDATE seats SET state='unresolved',unresolved_reason='other',retired_at=NULL,retired_seq=NULL WHERE id='gone'";
+    let refused = |db: &Connection| db.execute(unretire, []).unwrap_err().to_string();
+    assert!(refused(&db).contains("retired seat is terminal"), "no row");
+    db.execute(
+        "INSERT INTO reversible_retirements(seat_id,state,cutover_at,reason,unretired_at) VALUES ('gone','unretired',300,'closed',400)",
+        [],
+    )
+    .unwrap();
+    assert!(
+        refused(&db).contains("retired seat is terminal"),
+        "unretired row"
+    );
+    assert!(
+        db.execute("UPDATE seats SET retired_at=301 WHERE id='gone'", [])
+            .is_err(),
+        "the cutover stays fixed without a reversible row"
+    );
+    db.execute(
+        "UPDATE reversible_retirements SET state='reversible',unretired_at=NULL WHERE seat_id='gone'",
+        [],
+    )
+    .unwrap();
+    db.execute(unretire, []).unwrap();
+}
