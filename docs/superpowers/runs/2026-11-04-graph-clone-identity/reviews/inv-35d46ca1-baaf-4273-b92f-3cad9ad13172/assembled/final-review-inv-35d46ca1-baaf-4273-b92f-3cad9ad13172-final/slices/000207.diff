+/// Kills: a payload shape other than spec 4.3.
+#[test]
+fn seat_clone_identity_payloads_round_trip() {
+    let seat = SeatId::new("sAbc12345678");
+    let reversible = SeatRetiredReversiblePayload {
+        seat: seat.clone(),
+        reason: RetireReason::Closed,
+        retired_at: 42,
+    };
+    let json = serde_json::to_string(&reversible).unwrap();
+    assert_eq!(
+        json,
+        r#"{"seat":"sAbc12345678","reason":"closed","retired_at":42}"#
+    );
+    assert_eq!(
+        serde_json::from_str::<SeatRetiredReversiblePayload>(&json).unwrap(),
+        reversible
+    );
+    assert_eq!(
+        serde_json::from_str::<SeatRetiredReversiblePayload>(
+            r#"{"seat":"sAbc12345678","reason":"closed","retired_at":42,"future":1}"#
+        )
+        .unwrap(),
+        reversible,
+        "additive field ignored"
+    );
+    assert_eq!(reversible.referenced_seats(), vec![seat.clone()]);
+    let unretired = SeatUnretiredPayload {
+        seat: seat.clone(),
+        retired_at: 42,
+        unretired_at: 43,
+    };
+    let json = serde_json::to_string(&unretired).unwrap();
+    assert_eq!(
+        json,
+        r#"{"seat":"sAbc12345678","retired_at":42,"unretired_at":43}"#
+    );
+    assert_eq!(
+        serde_json::from_str::<SeatUnretiredPayload>(&json).unwrap(),
+        unretired
+    );
+    assert_eq!(
+        serde_json::from_str::<SeatUnretiredPayload>(
+            r#"{"seat":"sAbc12345678","retired_at":42,"unretired_at":43,"future":1}"#
+        )
+        .unwrap(),
+        unretired,
+        "additive field ignored"
+    );
+    assert_eq!(unretired.referenced_seats(), vec![seat]);
+}
