+// Kills: a key field a pre-upgrade intent cannot decode, which would wedge its retry.
+#[test]
+fn intent_recorded_before_the_upgrade_decodes_as_keyless() {
+    let host = crate::test_support::test_host_locator();
+    let continuity: SemanticMutation = serde_json::from_value(serde_json::json!({
+        "kind": "continuity_check_in",
+        "target": "w1:p1",
+        "host": host.as_str(),
+        "harness": "claude",
+        "native_session": "S-1",
+        "source": "resume",
+        "event_id": "evt",
+        "execution": "e",
+    }))
+    .unwrap();
+    assert!(
+        matches!(&continuity, SemanticMutation::ContinuityCheckIn { continuity_key, .. } if continuity_key.is_none())
+    );
+    let resolve: SemanticMutation = serde_json::from_value(serde_json::json!({
+        "kind": "resolve_seat",
+        "target": "w1:p1",
+        "host": host.as_str(),
+    }))
+    .unwrap();
+    assert!(
+        matches!(&resolve, SemanticMutation::ResolveSeat { continuity_key, .. } if continuity_key.is_none())
+    );
+    // A keyless intent's bytes stay as they were.
+    assert!(
+        !serde_json::to_string(&resolve)
+            .unwrap()
+            .contains("continuity_key")
+    );
+}
+
+// Kills: a conversion that drops the retained key, so a replay after ServiceBusy goes keyless.
+#[test]
+fn replay_presents_the_key() {
+    use crate::protocol::ids::{ContinuityKey, ExecutionId, NativeSessionId};
+    let key = ContinuityKey::new("clone-1");
+    let host = crate::test_support::test_host_locator();
+    let continuity = SemanticMutation::ContinuityCheckIn {
+        target: HostTargetId::new("w1:p1"),
+        host: host.clone(),
+        harness: crate::protocol::authority::Harness::Claude,
+        native_session: NativeSessionId::new("S-1"),
+        source: "resume".into(),
+        event_id: "evt".into(),
+        execution: ExecutionId::new("e"),
+        liveness: None,
+        continuity_key: Some(key.clone()),
+    };
+    let decoded: SemanticMutation =
+        serde_json::from_slice(&serde_json::to_vec(&continuity).unwrap()).unwrap();
+    assert_eq!(decoded, continuity);
+    let Command::ContinuityCheckIn(wire) =
+        decoded.to_command(OperationId::new("op-1"), None).unwrap()
+    else {
+        panic!("wrong command")
+    };
+    assert_eq!(wire.continuity_key.as_ref(), Some(&key));
+    let resolve = SemanticMutation::ResolveSeat {
+        target: HostTargetId::new("w1:p1"),
+        host,
+        continuity_key: Some(key.clone()),
+    };
+    let Command::ResolveSeat(wire) = resolve.to_command(OperationId::new("op-2"), None).unwrap()
+    else {
+        panic!("wrong command")
+    };
+    assert_eq!(wire.continuity_key.as_ref(), Some(&key));
+}
