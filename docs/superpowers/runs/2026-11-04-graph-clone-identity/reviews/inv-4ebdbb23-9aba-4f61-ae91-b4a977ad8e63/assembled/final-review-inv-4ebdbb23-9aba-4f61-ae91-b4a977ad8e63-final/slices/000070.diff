+/// The digest of a check-in: [`check_in_payload`]'s, unchanged for a keyless one; a keyed one has
+/// its own domain.
+pub fn check_in_digest(command: &CheckIn) -> Result<[u8; 32], ApiError> {
+    match &command.continuity_key {
+        Some(key) => {
+            schema::canonical_digest(&("keyed_check_in", &command.mode, &command.claim, key))
+        }
+        None => schema::canonical_digest(&check_in_payload(command)),
+    }
+}
