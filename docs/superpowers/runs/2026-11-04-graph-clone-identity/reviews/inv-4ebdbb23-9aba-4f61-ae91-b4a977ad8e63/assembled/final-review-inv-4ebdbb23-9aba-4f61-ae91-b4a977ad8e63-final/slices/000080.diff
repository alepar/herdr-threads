+    pub retired_at: i64,
+    pub unretired_at: i64,
+}
+
+impl ReferencedSeats for SeatUnretiredPayload {
+    fn referenced_seats(&self) -> Vec<SeatId> {
+        vec![self.seat.clone()]
+    }
+}
