+/// How a continuity key conflict's refusal detail begins, so a hook can keep it from the model.
+pub const KEY_CONFLICT_CAUSE: &str = "continuity key conflict ";
+
+/// Why a continuity key claim was refused, or only alerted. Spec 4.2.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum ContinuityConflictKind {
+    KeyLiveElsewhere,
+    KeyRetiredReversibly,
+    PaneOwnedByOtherSeat,
+    SessionMatchesOtherSeat,
+    SeatHoldsOtherKey,
+}
+
+/// The evidence that bound a key to its seat: the agent presented it, or the service asserted it.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum ContinuityKeyBinding {
+    CheckIn,
+    ServiceReservation,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ContinuityKeyConflict {
+    pub host: HostLocator,
+    pub pane: HostTargetId,
+    pub kind: ContinuityConflictKind,
+    pub first_seen_at: UtcMillis,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SeatContinuityKey {
+    pub key: ContinuityKey,
+    pub owner: ServiceAuthorId,
+    pub bound_by: ContinuityKeyBinding,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub conflict: Option<ContinuityKeyConflict>,
+}
+
+/// Present iff the seat reads retired.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum SeatRetirementState {
+    Reversible,
+    Final,
+}
+
