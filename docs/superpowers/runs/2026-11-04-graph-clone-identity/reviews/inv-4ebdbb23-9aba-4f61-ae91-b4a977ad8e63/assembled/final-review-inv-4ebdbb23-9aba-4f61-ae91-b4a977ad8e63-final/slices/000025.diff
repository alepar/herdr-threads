+/// The caller's key for a top-level, non-subagent event, given what the daemon advertises. An
+/// invalid value is absent, with no diagnostic.
+pub(crate) fn caller_continuity_key(
+    env: &CallerEnv,
+    top_level: bool,
+    advertised: bool,
+) -> Option<ContinuityKey> {
+    (top_level && advertised)
+        .then(|| env.continuity_key())
+        .flatten()
+}
+
+impl CallerEnv {
+    /// Whether presenting a key is possible at all, so a caller with none asks the daemon nothing.
+    pub(crate) fn may_present_key(&self, top_level: bool) -> bool {
+        top_level && self.continuity_key().is_some()
+    }
+
+    /// The pane this caller runs in, when it is `target`: `ResolveSeat` presents a key only for
+    /// the caller's own pane, never for one it resolves on another's behalf.
+    pub(crate) fn is_own_pane(&self, target: &HostTargetId) -> bool {
+        self.pane(EnvMode::Cli).as_deref() == Some(target.as_str())
+    }
+}
