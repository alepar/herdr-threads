+/// The `key` line of `seat inspect` while the seat holds a key: `key KEY OWNER`, 6 bytes plus the
+/// key and owner. A key and an author id are one graphic token each, so nothing needs escaping.
+pub(super) fn inspect_key_line(key: &SeatContinuityKey) -> String {
+    format!("key {} {}\n", key.key.as_str(), key.owner.as_str())
+}
+
+/// The state line of `seat inspect` for a reversibly retired seat, 28 bytes. A final retirement adds
+/// nothing: `summary` and `mapping` already read `retired`, so its output is unchanged.
+pub(super) fn inspect_retirement_line(state: SeatRetirementState) -> Option<&'static str> {
+    match state {
+        SeatRetirementState::Reversible => Some("state: retired (reversible)\n"),
+        SeatRetirementState::Final => None,
+    }
+}
