+/// The session version a service operation requires. Owns the capability names and the mapping
+/// from operation to level; a new operation is one arm in `required_by`. Never gates peer facts.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+pub enum ServiceSessionLevel {
+    V1,
+    V2,
+    V3,
+}
+
+impl ServiceSessionLevel {
+    pub fn from_capability(name: &str) -> Option<Self> {
+        match name {
+            SERVICE_SESSION_CAPABILITY => Some(Self::V1),
+            SERVICE_SESSION_CAPABILITY_V2 => Some(Self::V2),
+            SERVICE_SESSION_CAPABILITY_V3 => Some(Self::V3),
+            _ => None,
+        }
+    }
+
+    pub fn capability(self) -> &'static str {
+        match self {
+            Self::V1 => SERVICE_SESSION_CAPABILITY,
+            Self::V2 => SERVICE_SESSION_CAPABILITY_V2,
+            Self::V3 => SERVICE_SESSION_CAPABILITY_V3,
+        }
+    }
+
+    pub fn required_by(operation: &ServiceOperation) -> Self {
+        match operation {
+            ServiceOperation::EnsureThread(_)
+            | ServiceOperation::Invite(_)
+            | ServiceOperation::Notify(_)
+            | ServiceOperation::Membership(_)
+            | ServiceOperation::SetTopic(_)
+            | ServiceOperation::ReleaseRequirement(_)
+            | ServiceOperation::Archive(_)
+            | ServiceOperation::Reopen(_) => Self::V1,
+            ServiceOperation::Send(_)
+            | ServiceOperation::History(_)
+            | ServiceOperation::Receipts(_) => Self::V2,
+            ServiceOperation::ReserveContinuityKey(_)
+            | ServiceOperation::ReleaseContinuityKey(_)
+            | ServiceOperation::UnretireSeat(_)
+            | ServiceOperation::FinalizeRetirement(_)
+            | ServiceOperation::ContinuityAlerts(_) => Self::V3,
+        }
+    }
+}
+
