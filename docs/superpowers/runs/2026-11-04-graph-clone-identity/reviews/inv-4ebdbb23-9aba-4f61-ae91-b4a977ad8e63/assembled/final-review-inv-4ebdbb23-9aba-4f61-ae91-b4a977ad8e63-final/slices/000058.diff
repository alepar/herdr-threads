+/// The `seat.retired` applier's job row: no closure inputs, origin `replicated`. Releases a key the
+/// seat still holds, as [`insert_retirement_job`] does (a local row only: a remote seat never has one).
+pub(crate) fn insert_replicated_retirement_job(
+    tx: &Transaction<'_>,
+    seat: &SeatId,
+    cutover: UtcMillis,
+) -> Result<(), ApiError> {
+    let job = fresh_retirement_id(tx)?;
+    tx.execute(
+        "INSERT INTO retirements(id,seat_id,cutover_at,origin) VALUES (?1,?2,?3,'replicated')",
+        params![job.as_str(), seat.as_str(), cutover.0],
+    )
+    .map_err(store_error)?;
+    continuity_keys::release_for_final(tx, seat)
+}
+
+fn fresh_retirement_id(tx: &Transaction<'_>) -> Result<RetirementJobId, ApiError> {
+    Ok(RetirementJobId::new(crate::store::public_ids::fresh(
+        tx,
+        prefix::RETIREMENT,
+        &[("retirements", "id", prefix::RETIREMENT)],
+    )?))
+}
