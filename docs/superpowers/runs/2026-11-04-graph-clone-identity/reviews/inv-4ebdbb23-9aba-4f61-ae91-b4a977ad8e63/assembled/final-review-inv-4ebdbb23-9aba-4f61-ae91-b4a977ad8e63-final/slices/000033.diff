+/// The key a caller presents to this daemon ([`caller_continuity_key`]). A caller with no valid key
+/// and a subagent ask the daemon nothing, so their requests and round trips are unchanged.
+pub(crate) fn presented_continuity_key<C: LocalClient + ?Sized>(
+    env: &CallerEnv,
+    top_level: bool,
+    client: &C,
+    budget: &CallBudget,
+) -> Option<ContinuityKey> {
+    let advertised = env.may_present_key(top_level)
+        && client.supports_capability(SEAT_CONTINUITY_KEY_V1, budget);
+    caller_continuity_key(env, top_level, advertised)
+}
+
+/// The key a plain CLI resolve of `target` presents: the caller's own pane only, never a pane it
+/// resolves for someone else. Unknown or subagent callers present nothing. A plain call offers no
+/// evidence to reattach on, so a key bound elsewhere refuses and mints no seat (spec 4.2).
+pub(crate) fn own_pane_continuity_key<C: LocalClient + ?Sized>(
+    env: &CallerEnv,
+    target: &HostTargetId,
+    top_level: bool,
+    client: &C,
+    budget: &CallBudget,
+) -> Option<ContinuityKey> {
+    presented_continuity_key(env, top_level && env.is_own_pane(target), client, budget)
+}
