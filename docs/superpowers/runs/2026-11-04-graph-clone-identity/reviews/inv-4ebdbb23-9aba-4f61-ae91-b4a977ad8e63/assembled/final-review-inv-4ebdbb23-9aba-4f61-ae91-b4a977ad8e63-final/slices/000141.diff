+        .unwrap();
+    }
+    let refusal = fx.claim("pane", "fresh", Some(KEY)).unwrap_err();
+    assert_eq!(refusal.code, ErrorCode::TargetUnresolved);
+    assert_eq!(fx.conflict_kind("pane"), None);
+    fx.resolve("pane", None).unwrap();
+}
+
+mod check_in {
+    //! The check-in entry point: it commits rather than refuses.
+    use super::*;
+    use crate::ports::{
+        CooperativePermitRequest, ReadContext, RegisterAvailableRequest, StorePort,
+    };
+    use crate::protocol::{authority::ObligationRef, commands::CheckIn};
+    use crate::store::{
+        SqliteStore,
+        cooperative_checkin_tests::{claim, fixture, lifecycle},
+    };
+
+    fn budget() -> CallBudget {
+        crate::store::cooperative_checkin_tests::budget()
+    }
+
+    fn check_in(store: &SqliteStore, command: CheckIn) -> Result<(), ApiError> {
+        let permit = store.issue_cooperative_permit(
+            CooperativePermitRequest {
+                claim: command.claim.clone(),
+                operation: command.operation.clone(),
+                obligation: ObligationRef::CheckIn(command.claim.seat.clone()),
+                payload_hash: seats::check_in_digest(&command).unwrap(),
+                check_in_mode: Some(command.mode),
+            },
+            &budget(),
+        )?;
+        store.register_available(
+            RegisterAvailableRequest {
+                command,
+                read: ReadContext {
+                    instance: INSTANCE.into(),
+                    output: Default::default(),
+                    operation_scope: None,
+                },
+                operator: None,
+            },
+            permit,
+            &budget(),
+        )?;
+        Ok(())
+    }
+
+    fn keyed(operation: &str, presented: &str) -> CheckIn {
+        let mut command = lifecycle(claim(), operation);
+        command.continuity_key = Some(key(presented));
+        command
+    }
+
+    fn make_author(conn: &mut Connection) -> ServiceAuthorId {
+        let tx = conn.transaction().unwrap();
+        let author =
+            crate::store::service_substrate::ensure_reserved_author(&tx, INSTANCE, UtcMillis(0))
+                .unwrap();
+        tx.commit().unwrap();
+        author
+    }
+
+    fn reserve(conn: &Connection, author: &ServiceAuthorId, name: &str, seat: Option<&str>) {
+        continuity_keys::reserve(
+            conn,
+            author,
+            &ReserveContinuityKey {
+                key: key(name),
+                seat: seat.map(SeatId::new),
+                operation: OperationId::new(format!("reserve-{name}")),
+            },
+            UtcMillis(10),
+        )
+        .unwrap();
+    }
+
+    fn other_seat(conn: &Connection, id: &str, state: &str, target: Option<&str>) {
+        conn.execute("INSERT INTO seats(id,instance_id,state,role,target_id,generation,target_generation,created_at,home_node,is_local,host_id) VALUES (?1,?2,?3,'native',?4,1,1,0,(SELECT id FROM local_node),1,(SELECT min(host_id) FROM herdr_hosts))",
+            params![id, INSTANCE, state, target]).unwrap();
+    }
+
+    fn row(conn: &Connection) -> Option<(String, String, Option<String>, Option<String>)> {
+        conn.query_row(
+            "SELECT key,kind,seat_id,owner_seat_id FROM continuity_key_conflicts",
+            [],
+            |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?, r.get(3)?)),
+        )
+        .ok()
+    }
+
+    fn alerts(conn: &Connection) -> i64 {
+        conn.query_row("SELECT count(*) FROM continuity_alerts", [], |r| r.get(0))
+            .unwrap()
+    }
+
+    /// Spec row "reserved, unbound | seat T with no key". Kills: no bind on the check-in path;
+    /// `service_reservation` evidence; a replay that writes; a key `key_of_seat` cannot find, the
+    /// one input a later pane close's reversible disposition reads.
+    #[test]
+    fn first_check_in_binds_with_check_in_provenance() {
+        let (store, mut conn, _) = fixture();
+        let author = make_author(&mut conn);
+        reserve(&conn, &author, KEY, None);
+        let command = keyed("op", KEY);
+        check_in(&store, command.clone()).unwrap();
+        let row_ = continuity_keys::lookup_key(&conn, &key(KEY))
+            .unwrap()
+            .unwrap();
+        assert_eq!(row_.seat, Some(SeatId::new("s")));
+        assert_eq!(row_.bound_by, Some(ContinuityKeyBinding::CheckIn));
+        assert_eq!(
+            continuity_keys::key_of_seat(&conn, &SeatId::new("s"))
+                .unwrap()
+                .unwrap()
+                .key,
+            key(KEY)
+        );
+        check_in(&store, command).unwrap();
+        // Spec row "bound to S, S resolved at this pane": no-op, the first evidence stands.
+        let mut again = keyed("op-2", KEY);
+        again.mode = crate::protocol::commands::CheckInMode::Current;
+        check_in(&store, again).unwrap();
+        let row_ = continuity_keys::lookup_key(&conn, &key(KEY))
+            .unwrap()
+            .unwrap();
+        assert_eq!(row_.bound_by, Some(ContinuityKeyBinding::CheckIn));
+        assert_eq!(alerts(&conn), 0);
+    }
+
+    /// Spec rows "bound to S | owner T" and "reserved, unbound | seat T holding K2": the check-in
+    /// proceeds unbound and alerts. Kills: refusing the owner; binding; a row that holds.
+    #[test]
+    fn pane_owned_by_other_seat_and_seat_holds_other_key_only_alert() {
+        let (store, mut conn, _) = fixture();
+        let author = make_author(&mut conn);
+        other_seat(&conn, "bound", "unresolved", None);
+        reserve(&conn, &author, KEY, Some("bound"));
+        check_in(&store, keyed("op-1", KEY)).unwrap();
+        assert_eq!(
+            row(&conn),
+            Some((
+                KEY.into(),
+                "pane_owned_by_other_seat".into(),
+                Some("bound".into()),
+                Some("s".into())
+            ))
+        );
+        assert_eq!(alerts(&conn), 1);
+        assert_eq!(
+            continuity_keys::hold_kind(&conn, crate::test_support::test_host_id(), "p").unwrap(),
+            None
+        );
+        assert!(
+            continuity_keys::key_of_seat(&conn, &SeatId::new("s"))
+                .unwrap()
+                .is_none()
+        );
+
+        let (store, mut conn, _) = fixture();
+        let author = make_author(&mut conn);
+        reserve(&conn, &author, "held-key", Some("s"));
+        reserve(&conn, &author, KEY, None);
+        check_in(&store, keyed("op-1", KEY)).unwrap();
+        let (_, kind, seat, owner) = row(&conn).unwrap();
+        assert_eq!(
+            (kind.as_str(), seat, owner.as_deref()),
+            ("seat_holds_other_key", None, Some("s"))
+        );
+        assert_eq!(
+            continuity_keys::lookup_key(&conn, &key(KEY))
+                .unwrap()
+                .unwrap()
+                .seat,
+            None
+        );
+        assert_eq!(
+            continuity_keys::key_of_seat(&conn, &SeatId::new("s"))
+                .unwrap()
+                .unwrap()
+                .key,
+            key("held-key")
+        );
+    }
+
+    /// An alert-only row clears when its owner stops being the pane's owner, at the new owner's next
+    /// check-in, keyed or not. Kills: a row that outlives its judged owner; one the same owner
+    /// clears.
+    #[test]
+    fn alert_only_row_clears_at_a_new_owners_check_in() {
+        let (store, conn, _) = fixture();
+        let conflict = |owner: &str| continuity_keys::ConflictFacts {
+            host: crate::test_support::test_host_id(),
+            target: "p".into(),
+            key: key(KEY),
+            kind: Kind::PaneOwnedByOtherSeat,
+            seat: None,
+            owner: Some(SeatId::new(owner)),
+        };
+        continuity_keys::record_conflict(&conn, &conflict("s"), UtcMillis(5)).unwrap();
+        check_in(&store, lifecycle(claim(), "same-owner")).unwrap();
+        assert!(row(&conn).is_some(), "the judged owner still owns the pane");
+        other_seat(&conn, "former", "unresolved", None);
+        conn.execute(
+            "UPDATE continuity_key_conflicts SET owner_seat_id='former'",
+            [],
+        )
+        .unwrap();
+        check_in(&store, lifecycle(claim(), "new-owner")).unwrap();
+        assert_eq!(row(&conn), None);
+    }
+
+    /// While a pass can still change the answer a check-in proceeds and records nothing. Unreserved
+    /// is ignored, and a key changes the operation's digest domain only. Kills: a false conflict or
+    /// bind during lag; refusing a check-in on a free key; a keyless digest change.
+    #[test]
+    fn check_in_during_lag_or_with_an_unreserved_key_records_nothing() {
+        let (store, mut conn, _) = fixture();
+        let author = make_author(&mut conn);
+        other_seat(&conn, "bound", "unresolved", None);
+        reserve(&conn, &author, KEY, Some("bound"));
+        reserve(&conn, &author, "free", None);
+        conn.execute(
+            "UPDATE herdr_hosts SET recovery_boot='b',recovery_epoch=1",
+            [],
+        )
+        .unwrap();
+        check_in(&store, keyed("op-1", KEY)).unwrap();
+        check_in(&store, keyed("op-2", "free")).unwrap();
+        check_in(&store, keyed("op-3", "unreserved")).unwrap();
+        assert_eq!(row(&conn), None);
+        assert_eq!(alerts(&conn), 0);
+        assert_eq!(
+            continuity_keys::lookup_key(&conn, &key("free"))
+                .unwrap()
+                .unwrap()
+                .seat,
+            None
+        );
+        assert!(
+            continuity_keys::lookup_key(&conn, &key("unreserved"))
+                .unwrap()
+                .is_none()
+        );
+        let keyless = lifecycle(claim(), "op");
+        assert_eq!(
+            seats::check_in_digest(&keyless).unwrap(),
+            schema::canonical_digest(&seats::check_in_payload(&keyless)).unwrap()
+        );
+        assert_ne!(
+            seats::check_in_digest(&keyed("op", KEY)).unwrap(),
+            seats::check_in_digest(&keyless).unwrap()
+        );
+    }
+
+    /// Kills: a check-in judging keys on a host kind whose continuity is not a key.
+    #[test]
+    fn check_in_on_an_hc_host_ignores_the_key() {
+        let (store, mut conn, _) = fixture();
+        let author = make_author(&mut conn);
+        reserve(&conn, &author, KEY, None);
+        conn.execute("UPDATE herdr_hosts SET kind='hc'", [])
+            .unwrap();
+        check_in(&store, keyed("op-1", KEY)).unwrap();
+        assert_eq!(
+            continuity_keys::lookup_key(&conn, &key(KEY))
+                .unwrap()
+                .unwrap()
+                .seat,
+            None
+        );
+    }
