+/// The refusal is definitive (not retried, not kept), and it holds ordinary resolution with its own
+/// cause, keyless and keyed, even on a pane a restore hold also holds. Kills: a retryable code;
+/// restore-hold text or its repair list; a hold that only keyed callers see.
+#[test]
+fn conflict_hold_is_definitive_and_not_kept() {
+    let mut fx = Fx::new(&["elsewhere", "pane"]);
+    let live = fx.owner("elsewhere");
+    fx.reserve(KEY, Some(&live));
+    let refusal = fx.claim("pane", "fresh", Some(KEY)).unwrap_err();
+    assert!(is_continuity_refusal(&refusal.code));
+    let seats_before = fx.seats();
+    for presented in [None, Some(KEY), Some("unreserved")] {
+        let refusal = fx.resolve("pane", presented).unwrap_err();
+        assert_eq!(refusal.code, ErrorCode::TargetUnresolved, "{presented:?}");
+        assert!(
+            refusal
+                .detail
+                .contains("continuity key conflict key_live_elsewhere on pane"),
+            "{refusal:?}"
+        );
+        assert!(!refusal.detail.contains("restore"), "{refusal:?}");
+        assert!(!refusal.detail.contains("--new-seat"), "{refusal:?}");
+    }
+    fx.hold("pane");
+    let refusal = fx.resolve("pane", None).unwrap_err();
+    assert!(
+        refusal
+            .detail
+            .contains("continuity key conflict key_live_elsewhere on pane"),
+        "{refusal:?}"
+    );
+    assert_eq!(fx.seats(), seats_before, "no new seat appears");
+    assert_eq!(fx.alerts(), 1);
+}
