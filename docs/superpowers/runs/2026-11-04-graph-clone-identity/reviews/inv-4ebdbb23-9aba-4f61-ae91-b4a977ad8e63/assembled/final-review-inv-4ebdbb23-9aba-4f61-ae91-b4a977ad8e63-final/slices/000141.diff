+//! The daemon's decision on a presented continuity key at its three entry points (ht-ma6i.2, spec
+//! 4.2, TRUST-POLICY C1): `decide_continuity`, ordinary resolution and check-in, on a real store.
+//! Mounted from `src/store/seats/key_verdict.rs`. A kept claim decided by the observation worker
+//! is `kept_keyed_claim_is_decided_after_lag_with_no_further_event` in
+//! `tests/integration/trust_policy.rs`.
+use crate::{
+    cli::retry::is_continuity_refusal,
+    ports::{
+        ContinuityEvidence, ContinuityRequest, ContinuityTargetGuard, DurableWorkAdmission,
+        EnumerationEvidence, EvidenceKind, ExecutionEvidence, HostId, HostKind, HostObservation,
+        HostObservationAdmission, HostSnapshot, HostUiState, IncarnationEvidence,
+        ObservationProvenance, OperatorRequest, OperatorTargetGuard, OrdinaryResolutionAttempt,
+        OrdinaryResolutionGuard, OrdinaryResolutionOutcome, PublishedSnapshot, SnapshotHeader,
+        StructuralOccupancy,
+    },
+    protocol::{
+        authority::{Harness, LivenessFingerprint, OperatorActor},
+        commands::{
+            ContinuityCheckIn, OperatorCommand, OperatorFreshSeat, OperatorRebind, ResolveSeat,
+        },
+        ids::{
+            ContinuityKey, ExecutionId, HostBootId, HostCallId, HostLocator, HostTargetId,
+            NAMED_HOST_LOCATOR, NativeSessionId, OperationId, SeatId, ServiceAuthorId, TerminalId,
+        },
+        results::{
+            ApiError, CommandResult, ContinuityConflictKind as Kind, ContinuityKeyBinding,
+            ErrorCode,
+        },
+        service::ReserveContinuityKey,
+        time::{CallBudget, Cancellation, Clock, MonoInstant, UtcMillis},
+    },
+    store::{connection::StoreContext, continuity_keys, kept_continuity, schema, seats},
+};
+use rusqlite::{Connection, params};
+use std::sync::Arc;
+
+const INSTANCE: &str = "34750f98bd59fcfc946da45aaabe933b";
+const KEY: &str = "clone-1";
+
+struct FixedClock;
+impl Clock for FixedClock {
+    fn utc_now(&self) -> UtcMillis {
+        UtcMillis(100)
+    }
+    fn monotonic_now(&self) -> MonoInstant {
+        MonoInstant(100)
+    }
+}
+
+fn budget() -> CallBudget {
+    CallBudget {
+        deadline: MonoInstant(10_000),
+        cancellation: Cancellation::default(),
+    }
+}
+
+fn key(name: &str) -> ContinuityKey {
+    ContinuityKey::new(name)
+}
+
+fn observation(target: &str, sequence: u64) -> HostObservation {
+    HostObservation {
+        focused: false,
+        target: HostTargetId::new(target),
+        host_boot: HostBootId::new("b"),
+        epoch: 1,
+        generation: 1,
+        observed_at_utc: UtcMillis(100),
+        observed_at_mono: MonoInstant(100),
+        provenance: ObservationProvenance::FreshCurrentTarget,
+        occupant: None,
+        ui: HostUiState::Idle,
+        terminal: Some(TerminalId::new(format!("term-{target}"))),
+        occupancy: StructuralOccupancy::EmptyShell,
+        incarnation: IncarnationEvidence::Verified {
+            identity: "inc".into(),
+            evidence_kind: EvidenceKind::CoherentEnumeration,
+        },
+        execution: ExecutionEvidence::Unknown,
+        call_id: HostCallId::new(format!("call-{target}-{sequence}")),
+        connection_epoch: 1,
+        observation_sequence: sequence,
+        started_at_mono: MonoInstant(100),
+        completed_at_mono: MonoInstant(100),
+    }
+}
+
+struct Fx {
+    context: StoreContext,
+    conn: Connection,
+    author: ServiceAuthorId,
+    host: HostId,
+    sequence: u64,
+    operation: u64,
+    published: PublishedSnapshot,
+}
+
+impl Fx {
+    /// A published coherent baseline of `panes`, reconciled (no lag).
+    fn new(panes: &[&str]) -> Self {
+        let path = crate::test_support::scratch::temp_path(format!(
+            "herdr-key-decisions-{}.db",
+            uuid::Uuid::new_v4()
+        ));
+        let context = StoreContext::new(path, Arc::new(FixedClock)).with_test_host();
+        let mut conn = context.open_writer().unwrap();
+        crate::store::journal::open(
+            &context,
+            &mut conn,
+            Arc::new(crate::node::NodeIdentity::from_seed(
+                crate::test_support::TEST_NODE_SEED,
+            )),
+            "test",
+            crate::sync::facts::FactRegistry::builtins(),
+        )
+        .unwrap();
+        conn.execute("UPDATE herdr_hosts SET host_boot='b',host_epoch=1", [])
+            .unwrap();
+        let author = {
+            let tx = conn.transaction().unwrap();
+            let author = crate::store::service_substrate::ensure_reserved_author(
+                &tx,
+                INSTANCE,
+                UtcMillis(0),
+            )
+            .unwrap();
+            tx.commit().unwrap();
+            author
+        };
+        let host = crate::test_support::test_host_id();
+        let published = publish(&context, &mut conn, 2, panes);
+        let mut fx = Self {
+            context,
+            conn,
+            author,
+            host,
+            sequence: 2,
+            operation: 0,
+            published,
+        };
+        fx.set_lag(false);
+        fx
+    }
+
+    fn set_lag(&mut self, lag: bool) {
+        let sql = if lag {
+            "UPDATE herdr_hosts SET recovery_boot='b',recovery_epoch=1,reconciled_boot=NULL,reconciled_epoch=NULL"
+        } else {
+            "UPDATE herdr_hosts SET recovery_boot='b',recovery_epoch=1,reconciled_boot='b',reconciled_epoch=1"
+        };
+        self.conn.execute(sql, []).unwrap();
+    }
+
+    fn next_operation(&mut self) -> OperationId {
+        self.operation += 1;
+        OperationId::new(format!("op-{}", self.operation))
+    }
+
+    /// One explicit current-target read of `pane`, as a daemon makes before a decision.
+    fn read(&mut self, pane: &str) -> (HostObservation, HostObservationAdmission) {
+        self.sequence += 1;
+        let admission = seats::begin_host_observation(
+            &self.context,
+            &mut self.conn,
+            INSTANCE,
+            self.host,
+            &budget(),
+        )
+        .unwrap();
+        let fresh = observation(pane, self.sequence);
+        assert!(
+            seats::publish_current_target_observation(
+                &self.context,
+                &mut self.conn,
+                &admission,
+                &fresh,
+                &budget(),
+            )
+            .unwrap()
+        );
+        (fresh, admission)
+    }
+
+    fn resolve(&mut self, pane: &str, presented: Option<&str>) -> Result<SeatId, ApiError> {
+        let request = ResolveSeat {
+            host: crate::test_support::test_host_locator(),
+            target: HostTargetId::new(pane),
+            operation: self.next_operation(),
+            locator_hint: None,
+            tmux_hint: None,
+            continuity_key: presented.map(key),
+        };
+        let (fresh, admission) = self.read(pane);
+        let guard = OrdinaryResolutionGuard::try_new(&request, fresh, &admission).unwrap();
+        match seats::resolve_seat(
+            &self.context,
+            &mut self.conn,
+            INSTANCE,
+            request,
+            OrdinaryResolutionAttempt::Observed(guard),
+            &budget(),
+        )? {
+            OrdinaryResolutionOutcome::Resolved(seat) => Ok(seat),
+            OrdinaryResolutionOutcome::NeedsObservation => panic!("observed attempt"),
+        }
+    }
+
+    fn command(&mut self, pane: &str, session: &str, presented: Option<&str>) -> ContinuityCheckIn {
+        let operation = self.next_operation();
+        ContinuityCheckIn {
+            host: crate::test_support::test_host_locator(),
+            target: HostTargetId::new(pane),
+            harness: Harness::Claude,
+            native_session: NativeSessionId::new(session),
+            source: ContinuityCheckIn::RESUME_SOURCE.into(),
+            execution: ExecutionId::new(format!("exec-{}", operation.as_str())),
+            operation,
+            liveness: Some(LivenessFingerprint {
+                pid: 4242,
+                start: 7,
+            }),
+            continuity_key: presented.map(key),
+        }
+    }
+
+    fn decide(
+        &mut self,
+        command: &ContinuityCheckIn,
+        evidence: ContinuityEvidence,
+    ) -> Result<CommandResult, ApiError> {
+        let (fresh, _) = self.read(command.target.as_str());
+        let guard = ContinuityTargetGuard::try_new(INSTANCE, self.host, command, fresh).unwrap();
+        seats::decide_continuity(
+            &self.context,
+            &mut self.conn,
+            INSTANCE,
+            ContinuityRequest {
+                command: command.clone(),
+                guard,
+                diagnostic: "absent",
+                evidence,
+            },
+        )
+    }
+
+    /// A session's own claim, with the evidence `Identity::continuity` gives it.
+    fn claim(
+        &mut self,
+        pane: &str,
+        session: &str,
+        presented: Option<&str>,
+    ) -> Result<CommandResult, ApiError> {
+        let command = self.command(pane, session, presented);
+        let evidence = if presented.is_some() {
+            ContinuityEvidence::Key
+        } else {
+            ContinuityEvidence::Cooperative
+        };
+        self.decide(&command, evidence)
+    }
+
+    fn reserve(&self, name: &str, seat: Option<&SeatId>) {
+        continuity_keys::reserve(
+            &self.conn,
+            &self.author,
+            &ReserveContinuityKey {
+                key: key(name),
+                seat: seat.cloned(),
+                operation: OperationId::new(format!("reserve-{name}")),
+            },
+            UtcMillis(10),
+        )
+        .unwrap();
+    }
+
+    /// A resolved seat at `pane`, through ordinary resolution.
+    fn owner(&mut self, pane: &str) -> SeatId {
+        self.resolve(pane, None).unwrap()
+    }
+
+    /// An unresolved seat, last at `was`, with a top-level binding of `session`.
+    fn unresolved(&mut self, was: &str, session: &str) -> SeatId {
+        let seat = self.owner(was);
+        self.unresolve(&seat);
+        self.past_binding(&seat, session);
+        seat
+    }
+
+    fn unresolve(&self, seat: &SeatId) {
+        self.conn
+            .execute(
+                "UPDATE seats SET state='unresolved',target_id=NULL,structural_terminal_id=NULL,structural_incarnation=NULL,structural_incarnation_kind=NULL,structural_host_boot=NULL,structural_host_epoch=NULL,structural_connection_epoch=NULL,structural_observation_sequence=NULL WHERE id=?1",
+                [seat.as_str()],
+            )
+            .unwrap();
+    }
+
+    fn past_binding(&self, seat: &SeatId, session: &str) {
+        self.conn.execute(
+            "INSERT INTO occupant_bindings(seat_id,generation,target_generation,target_id,host_boot,host_epoch,harness,native_session,execution_id,observation_provenance,observed_at,registered_at,ended_at) VALUES (?1,1,1,'old-pane','b',1,'claude',?2,'exec-'||?1,'cooperative_top_level',10,10,50)",
+            params![seat.as_str(), session],
+        )
+        .unwrap();
+    }
+
+    /// A reversibly retired seat holding `name`.
+    fn retired_with_key(&self, name: &str) -> SeatId {
+        let seat = SeatId::new("retired-seat");
+        self.conn.execute(
+            "INSERT INTO seats(id,instance_id,state,role,target_id,generation,target_generation,created_at,home_node,is_local,host_id,retired_at) VALUES (?1,?2,'resolved','native','retired-pane',1,1,0,(SELECT id FROM local_node),1,(SELECT min(host_id) FROM herdr_hosts),NULL)",
+            params![seat.as_str(), INSTANCE],
+        )
+        .unwrap();
+        self.reserve(name, Some(&seat));
+        self.conn
+            .execute(
+                "UPDATE seats SET state='retired',target_id=NULL,retired_at=1 WHERE id=?1",
+                [seat.as_str()],
+            )
+            .unwrap();
+        seat
+    }
+
+    fn hold(&self, pane: &str) {
+        self.conn.execute(
+            "INSERT INTO recovery_holds(host_id,target_id,baseline_boot,baseline_epoch,reason) VALUES (?1,?2,'b',1,'unresolved saved seat continuity')",
+            params![self.host.get(), pane],
+        )
+        .unwrap();
+    }
+
+    fn scalar(&self, sql: &str) -> i64 {
+        self.conn.query_row(sql, [], |r| r.get(0)).unwrap()
+    }
+
+    fn conflict_kind(&self, pane: &str) -> Option<String> {
+        self.conn
+            .query_row(
+                "SELECT kind FROM continuity_key_conflicts WHERE target_id=?1",
+                [pane],
+                |r| r.get(0),
+            )
+            .ok()
+    }
+
+    fn conflicts(&self) -> i64 {
+        self.scalar("SELECT count(*) FROM continuity_key_conflicts")
+    }
+
+    fn alerts(&self) -> i64 {
+        self.scalar("SELECT count(*) FROM continuity_alerts")
+    }
+
+    fn seats(&self) -> i64 {
+        self.scalar("SELECT count(*) FROM seats")
+    }
+
+    fn state_and_target(&self, seat: &SeatId) -> (String, Option<String>) {
+        self.conn
+            .query_row(
+                "SELECT state,target_id FROM seats WHERE id=?1",
+                [seat.as_str()],
+                |r| Ok((r.get(0)?, r.get(1)?)),
+            )
+            .unwrap()
+    }
+
+    fn decisions(&self, seat: &SeatId) -> Vec<String> {
+        self.conn
+            .prepare("SELECT kind FROM allocation_decisions WHERE seat_id=?1 ORDER BY ordinal")
+            .unwrap()
+            .query_map([seat.as_str()], |r| r.get(0))
+            .unwrap()
+            .collect::<Result<_, _>>()
+            .unwrap()
+    }
+
+    fn continuity_decisions(&self, seat: &SeatId) -> Vec<String> {
+        self.decisions(seat)
+            .into_iter()
+            .filter(|kind| kind != "ordinary")
+            .collect()
+    }
+
+    fn open_binding(&self, seat: &SeatId) -> Vec<(String, String, String)> {
+        self.conn
+            .prepare("SELECT harness,observation_provenance,native_session FROM occupant_bindings WHERE seat_id=?1 AND ended_at IS NULL")
+            .unwrap()
+            .query_map([seat.as_str()], |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?)))
+            .unwrap()
+            .collect::<Result<_, _>>()
+            .unwrap()
+    }
+
+    fn bound_to(&self, name: &str) -> (Option<SeatId>, Option<ContinuityKeyBinding>) {
+        let row = continuity_keys::lookup_key(&self.conn, &key(name))
+            .unwrap()
+            .expect("key row");
+        (row.seat, row.bound_by)
+    }
+
+    fn operator_rebind(&mut self, seat: &SeatId, pane: &str) {
+        let (fresh, _) = self.read(pane);
+        let command = OperatorRebind {
+            host: crate::test_support::test_host_locator(),
+            seat: seat.clone(),
+            target: HostTargetId::new(pane),
+            operation: self.next_operation(),
+        };
+        let guard = OperatorTargetGuard::try_new(
+            INSTANCE,
+            self.host,
+            &OperatorCommand::Rebind(command.clone()),
+            fresh,
+        )
+        .unwrap();
+        seats::mutate_operator(
+            &self.context,
+            &mut self.conn,
+            INSTANCE,
+            OperatorRequest::Rebind(command, guard),
+            actor(),
+            None,
+        )
+        .unwrap();
+    }
+
+    fn operator_fresh(&mut self, pane: &str) {
+        let (fresh, _) = self.read(pane);
+        let command = OperatorFreshSeat {
+            host: crate::test_support::test_host_locator(),
+            target: HostTargetId::new(pane),
+            operation: self.next_operation(),
+        };
+        let guard = OperatorTargetGuard::try_new(
+            INSTANCE,
+            self.host,
+            &OperatorCommand::FreshSeat(command.clone()),
+            fresh,
+        )
+        .unwrap();
+        seats::mutate_operator(
+            &self.context,
+            &mut self.conn,
+            INSTANCE,
+            OperatorRequest::FreshSeat(command, guard),
+            actor(),
+            None,
+        )
+        .unwrap();
+    }
+}
+
+fn actor() -> OperatorActor {
+    OperatorActor::from_peer(
+        crate::protocol::authority::PeerIdentity::from_kernel(501),
+        501,
+    )
+    .unwrap()
+}
+
+fn publish(
+    context: &StoreContext,
+    conn: &mut Connection,
+    sequence: u64,
+    panes: &[&str],
+) -> PublishedSnapshot {
+    let capture = HostSnapshot {
+        boot: HostBootId::new("b"),
+        epoch: 1,
+        observation_sequence: sequence,
+        complete: true,
+        enumeration: EnumerationEvidence::CoherentVerified,
+        incarnation: IncarnationEvidence::Verified {
+            identity: "inc".into(),
+            evidence_kind: EvidenceKind::CoherentEnumeration,
+        },
+        targets: panes
+            .iter()
+            .map(|pane| HostObservation {
+                provenance: ObservationProvenance::CoherentEnumeration,
+                ..observation(pane, sequence)
+            })
+            .collect(),
+    };
+    let budget = budget();
+    let admission = seats::begin_host_observation(
+        context,
+        conn,
+        INSTANCE,
+        crate::test_support::test_host_id(),
+        &budget,
+    )
+    .unwrap();
+    let header = SnapshotHeader::from_captured(admission, &capture).unwrap();
+    let stage = seats::begin_snapshot_stage(context, conn, header, &budget).unwrap();
+    crate::test_support::snapshot::stage_all(&capture.targets, |offset, targets| {
+        seats::stage_snapshot_targets(
+            context,
+            conn,
+            &stage.id,
+            offset,
+            targets,
+            DurableWorkAdmission::new(16).unwrap(),
+            &budget,
+        )
+    })
+    .unwrap();
+    seats::seal_snapshot_stage(context, conn, &stage.id, &budget).unwrap();
+    seats::publish_snapshot_stage(context, conn, &stage.id, &budget).unwrap()
+}
+
+fn reattached(result: Result<CommandResult, ApiError>) -> SeatId {
+    match result.unwrap() {
+        CommandResult::ContinuityReattached(reattachment) => reattachment.seat,
+        other => panic!("not a reattachment: {other:?}"),
+    }
+}
+
+/// Spec row "bound to S, S unresolved | no resolved owner", on a held and on an unowned pane.
+/// Kills: requiring a session match; leaving the hold; no successor binding; recording the
+/// cooperative kind; leaving a standing conflict on the pane.
+#[test]
+fn keyed_claim_reattaches_unresolved_seat_onto_held_pane_with_a_fresh_session() {
+    for held in [true, false] {
+        let mut fx = Fx::new(&["old", "pane"]);
+        let seat = fx.unresolved("old", "old-session");
+        fx.reserve(KEY, Some(&seat));
+        if held {
+            fx.hold("pane");
+        }
+        continuity_keys::record_conflict(
+            &fx.conn,
+            &continuity_keys::ConflictFacts {
+                host: fx.host,
+                target: "pane".into(),
+                key: key("another"),
+                kind: Kind::KeyLiveElsewhere,
+                seat: None,
+                owner: None,
+            },
+            UtcMillis(5),
+        )
+        .unwrap();
+        let got = reattached(fx.claim("pane", "fresh-session", Some(KEY)));
+        assert_eq!(got, seat);
+        assert_eq!(
+            fx.state_and_target(&seat),
+            ("resolved".into(), Some("pane".into()))
+        );
+        assert_eq!(
+            fx.scalar("SELECT count(*) FROM recovery_holds WHERE released_at IS NULL"),
+            0,
+            "the hold is released"
+        );
+        assert_eq!(
+            fx.open_binding(&seat),
+            vec![(
+                "claude".into(),
+                "cooperative_top_level".into(),
+                "fresh-session".into()
+            )]
+        );
+        assert_eq!(
+            fx.continuity_decisions(&seat),
+            vec!["cooperative_continuity_key"]
+        );
+        assert_eq!(fx.conflict_kind("pane"), None, "a successful claim clears");
+    }
+}
+
+/// Kills: a C1 match on the bound seat itself read as another seat, or recorded as plain C1.
+#[test]
+fn keyed_claim_whose_session_matches_the_bound_seat_records_the_key() {
+    let mut fx = Fx::new(&["old", "pane"]);
+    let seat = fx.unresolved("old", "same-session");
+    fx.reserve(KEY, Some(&seat));
+    assert_eq!(
+        reattached(fx.claim("pane", "same-session", Some(KEY))),
+        seat
+    );
+    assert_eq!(
+        fx.continuity_decisions(&seat),
+        vec!["cooperative_continuity_key"]
+    );
+}
+
+/// Spec lag: the state-dependent answers are retryable at the claim and at a resolve. Kills:
+/// recording a false conflict during a cold restart; a definitive code the hook would not retry.
+#[test]
+fn keyed_claim_during_lag_is_busy_and_records_nothing() {
+    let mut fx = Fx::new(&["elsewhere", "owned", "pane"]);
+    let live = fx.owner("elsewhere");
+    let owner = fx.owner("owned");
+    fx.reserve(KEY, Some(&live));
+    fx.set_lag(true);
+    for pane in ["pane", "owned"] {
+        let refusal = fx.claim(pane, "fresh", Some(KEY)).unwrap_err();
+        assert_eq!(refusal.code, ErrorCode::ServiceBusy, "{pane}");
+        assert!(!is_continuity_refusal(&refusal.code));
+        let refusal = fx.resolve(pane, Some(KEY)).unwrap_err();
+        assert_eq!(refusal.code, ErrorCode::ServiceBusy, "{pane}");
+    }
+    assert_eq!((fx.conflicts(), fx.alerts()), (0, 0));
+    assert_eq!(fx.state_and_target(&owner).0, "resolved");
+    // A retired seat is not lag-dependent: a pass cannot revive it.
+    let mut fx = Fx::new(&["pane"]);
+    fx.retired_with_key(KEY);
+    fx.set_lag(true);
+    assert_eq!(
+        fx.claim("pane", "fresh", Some(KEY)).unwrap_err().code,
+        ErrorCode::TargetUnresolved
+    );
+    assert_eq!(
+        fx.conflict_kind("pane").as_deref(),
+        Some("key_retired_reversibly")
+    );
+}
+
+/// Every conflict row at the claim entry: the refusal rolls back, its row and one alert stand, and
+/// a repeat writes neither. Kills: recording inside the refused transaction; a lost alert; moving
+/// a seat; a refusal of an owned pane the hook would not continue past.
+#[test]
+fn conflict_survives_the_refused_transaction() {
+    let mut fx = Fx::new(&["elsewhere", "pane"]);
+    let live = fx.owner("elsewhere");
+    fx.reserve(KEY, Some(&live));
+    let seats_before = fx.seats();
+    let refusal = fx.claim("pane", "fresh", Some(KEY)).unwrap_err();
+    assert_eq!(refusal.code, ErrorCode::TargetUnresolved);
+    assert_eq!(
+        fx.conflict_kind("pane").as_deref(),
+        Some("key_live_elsewhere")
+    );
+    assert_eq!(fx.alerts(), 1);
+    assert_eq!(fx.seats(), seats_before);
+    assert_eq!(fx.continuity_decisions(&live), Vec::<String>::new());
+    assert_eq!(
+        fx.scalar("SELECT count(*) FROM operations WHERE actor_scope LIKE 'continuity:%'"),
+        0,
+        "a refusal records no result"
+    );
+    fx.claim("pane", "fresh", Some(KEY)).unwrap_err();
+    assert_eq!(
+        (fx.conflicts(), fx.alerts()),
+        (1, 1),
+        "a repeat writes neither"
+    );
+
+    // key_retired_reversibly.
+    let mut fx = Fx::new(&["pane"]);
+    fx.retired_with_key(KEY);
+    let refusal = fx.claim("pane", "fresh", Some(KEY)).unwrap_err();
+    assert_eq!(refusal.code, ErrorCode::TargetUnresolved);
+    assert_eq!(
+        fx.conflict_kind("pane").as_deref(),
+        Some("key_retired_reversibly")
+    );
+
+    // session_matches_other_seat: the session is another unresolved seat's.
+    let mut fx = Fx::new(&["old-a", "old-b", "pane"]);
+    let bound = fx.unresolved("old-a", "session-a");
+    let other = fx.unresolved("old-b", "session-b");
+    fx.reserve(KEY, Some(&bound));
+    let refusal = fx.claim("pane", "session-b", Some(KEY)).unwrap_err();
+    assert_eq!(refusal.code, ErrorCode::TargetUnresolved);
+    assert_eq!(
+        fx.conflict_kind("pane").as_deref(),
+        Some("session_matches_other_seat")
+    );
+    assert_eq!(fx.state_and_target(&bound).0, "unresolved");
+    assert_eq!(fx.state_and_target(&other).0, "unresolved");
+
+    // pane_owned_by_other_seat and seat_holds_other_key answer as an owned pane does, so the
+    // owner's check-in proceeds; the row still survives.
+    let mut fx = Fx::new(&["old", "owned"]);
+    let bound = fx.unresolved("old", "session-a");
+    let owner = fx.owner("owned");
+    fx.reserve(KEY, Some(&bound));
+    let refusal = fx.claim("owned", "fresh", Some(KEY)).unwrap_err();
+    assert_eq!(refusal.code, ErrorCode::TargetAlreadyOwned);
+    assert!(
+        refusal.detail.contains("continuity key conflict"),
+        "{refusal:?}"
+    );
+    assert_eq!(
+        fx.conflict_kind("owned").as_deref(),
+        Some("pane_owned_by_other_seat")
+    );
+    assert_eq!(fx.state_and_target(&owner).0, "resolved");
+
+    let mut fx = Fx::new(&["owned"]);
+    let owner = fx.owner("owned");
+    fx.reserve("held-key", Some(&owner));
+    fx.reserve(KEY, None);
+    let refusal = fx.claim("owned", "fresh", Some(KEY)).unwrap_err();
+    assert_eq!(refusal.code, ErrorCode::TargetAlreadyOwned);
+    assert_eq!(
+        fx.conflict_kind("owned").as_deref(),
+        Some("seat_holds_other_key")
+    );
+    assert_eq!(fx.bound_to(KEY).0, None, "K stays unbound");
+}
