+/// The hold binds ordinary resolution only. Kills: a C1, process-continuity or operator path that
+/// goes through the hold; a rebind or fresh seat that leaves the row behind.
+#[test]
+fn conflict_hold_binds_ordinary_resolution_only() {
+    let setup = |panes: &[&str]| {
+        let mut fx = Fx::new(panes);
+        let live = fx.owner("elsewhere");
+        fx.reserve(KEY, Some(&live));
+        fx.claim("pane", "fresh", Some(KEY)).unwrap_err();
+        assert_eq!(fx.conflicts(), 1);
+        fx
+    };
+    let panes = ["elsewhere", "old", "pane"];
+
+    // C1 by native session, keyless.
+    let mut fx = setup(&panes);
+    let seat = fx.unresolved("old", "own-session");
+    assert_eq!(reattached(fx.claim("pane", "own-session", None)), seat);
+    assert_eq!(
+        fx.continuity_decisions(&seat),
+        vec!["cooperative_continuity"]
+    );
+    assert_eq!(fx.conflicts(), 0, "the rebind clears the row");
+
+    // C1 process continuity (ht-hsyg).
+    let mut fx = setup(&panes);
+    let seat = fx.unresolved("old", "own-session");
+    let generation: u64 = fx
+        .conn
+        .query_row(
+            "SELECT generation FROM seats WHERE id=?1",
+            [seat.as_str()],
+            |r| r.get::<_, i64>(0),
+        )
+        .unwrap() as u64;
+    let command = fx.command("pane", "own-session", None);
+    reattached(fx.decide(
+        &command,
+        ContinuityEvidence::Process {
+            seat: seat.clone(),
+            seat_generation: generation,
+        },
+    ));
+    assert_eq!(
+        fx.continuity_decisions(&seat),
+        vec!["structural_process_continuity"]
+    );
+    assert_eq!(fx.conflicts(), 0);
+
+    // Operator rebind.
+    let mut fx = setup(&panes);
+    let seat = fx.unresolved("old", "own-session");
+    fx.operator_rebind(&seat, "pane");
+    assert_eq!(fx.state_and_target(&seat).1.as_deref(), Some("pane"));
+    assert_eq!(fx.conflicts(), 0);
+
+    // Operator fresh seat.
+    let mut fx = setup(&panes);
+    fx.operator_fresh("pane");
+    assert_eq!(fx.conflicts(), 0);
+}
