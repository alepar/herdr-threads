+/// Kills: alerts served to a v2 session, a v2 refusal that does not name what to register, or the
+/// query not reaching the feed over a v3 session.
+#[test]
+fn alerts_answer_only_v3() {
+    let fixture_v3 = fixture();
+    fixture_v3.seed_alert("clone-1");
+    fixture_v3.run(|mut session, _| async move {
+        let result = session.call(alerts_query()).await.unwrap();
+        let ServiceResult::ContinuityAlerts(page) = result else {
+            panic!("alerts answered {result:?}");
+        };
+        assert_eq!(page.items.len(), 1);
+        assert_eq!(page.items[0].key, ContinuityKey::new("clone-1"));
+        assert_eq!(page.items[0].kind, ContinuityConflictKind::KeyLiveElsewhere);
+        assert_eq!(page.items[0].pane, HostTargetId::new("pane-1"));
+    });
+
+    let fixture_v2 = fixture();
+    fixture_v2.seed_alert("clone-1");
+    fixture_v2.run_as(SERVICE_SESSION_CAPABILITY_V2, |mut session, _| async move {
+        let refused = session.call(alerts_query()).await.unwrap_err();
+        assert_eq!(refused.code, ErrorCode::Unsupported);
+        assert!(
+            refused.detail.contains(SERVICE_SESSION_CAPABILITY_V3),
+            "{}",
+            refused.detail
+        );
+    });
+}
