+/// Kills: a replay that re-executes (the released key coming back, or a release answering
+/// `NotFound`) instead of returning the journaled first result.
+#[test]
+fn operation_key_replay_returns_the_first_result() {
+    fixture().run(|mut session, fixture| async move {
+        let first = session.reserve("reserve-1", "clone-1", None).await.unwrap();
+        assert_eq!(fixture.journaled("reserve-1"), 1);
+        assert_eq!(
+            session.release("release-1", "clone-1").await.unwrap(),
+            ContinuityKey::new("clone-1")
+        );
+
+        // The reservation replays from the journal: the key stays released.
+        let replayed = session.reserve("reserve-1", "clone-1", None).await.unwrap();
+        assert_eq!(replayed, first);
+        assert_eq!(fixture.key_row("clone-1"), None);
+        assert_eq!(fixture.journaled("reserve-1"), 1);
+
+        // So does the release, which executed would be NotFound.
+        assert_eq!(
+            session.release("release-1", "clone-1").await.unwrap(),
+            ContinuityKey::new("clone-1")
+        );
+        assert_eq!(fixture.journaled("release-1"), 1);
+    });
+}
+
+/// Kills: an operation key reused for another key or another seat being executed or answered with
+/// the first result.
+#[test]
+fn payload_mismatch_is_refused() {
+    let fixture = fixture();
+    fixture.seed_seat("running", "resolved", Some("pane-running"));
+    fixture.run(|mut session, fixture| async move {
+        session.reserve("reserve-1", "clone-1", None).await.unwrap();
+        for (key, seat) in [("clone-2", None), ("clone-1", Some("running"))] {
+            let refused = session.reserve("reserve-1", key, seat).await.unwrap_err();
+            assert_eq!(refused.code, ErrorCode::OperationPayloadMismatch, "{key}");
+        }
+        let refused = session.release("reserve-1", "clone-1").await.unwrap_err();
+        assert_eq!(refused.code, ErrorCode::OperationPayloadMismatch);
+        assert_eq!(fixture.key_row("clone-2"), None);
+        let (_, seat, _, _) = fixture.key_row("clone-1").unwrap();
+        assert_eq!(seat, None);
+        assert_eq!(fixture.journaled("reserve-1"), 1);
+    });
+}
