+/// Public entry point, real private-server tab creation, and a child-observed record.
+/// Dropping the env projection or ignoring the selected cwd makes these checks fail.
+fn profile_directory_smoke(m: &Matrix, caller: &str) {
+    let cwd = m.home().join("working ' \" directory");
+    fs::create_dir(&cwd).unwrap();
+    let cwd = cwd.canonicalize().unwrap();
+    // The no-option launch control inherited the ordinary scratch profile and cwd.
+    let control = &m.log_of(caller)[0];
+    assert_eq!(
+        control["config_home"],
+        m.home().join(".codex").to_str().unwrap()
+    );
+    assert_eq!(
+        control["cwd"],
+        m.home().canonicalize().unwrap().to_str().unwrap()
+    );
+
+    let thread = id(&m.agent_ht(caller, "thread create --topic selected-profile"));
+    for (kind, key) in [("codex", "CODEX_HOME"), ("claude", "CLAUDE_CONFIG_DIR")] {
+        let selected = m.home().join(format!("{kind} profile ' \" selected"));
+        fs::create_dir(&selected).unwrap();
+        let selected = selected.canonicalize().unwrap();
+        // Setup uses the public CLI under the selected scratch scope; no credentials are copied.
+        let mut setup = m.cli();
+        setup
+            .env(key, &selected)
+            .args(["setup", kind, "--harness-binary"])
+            .arg(m.bin.join(kind))
+            .arg("--state-dir")
+            .arg(m.host.root().join("st/herdr/plugins").join(PLUGIN))
+            .arg("--host-endpoint")
+            .arg(m.host.socket_path());
+        let setup = setup.output().unwrap();
+        assert!(
+            setup.status.success(),
+            "{}",
+            String::from_utf8_lossy(&setup.stderr)
+        );
+
+        for (label, route) in [
+            ("profile-auto", String::new()),
+            ("profile-thread", format!("--thread {thread}")),
+        ] {
+            let out = m.agent_ht(caller, &format!(
+            "handoff --new-tab {kind}-{label} {route} --kind {kind} --profile-dir {} --cwd {} -- selected-profile-work",
+            quote(&selected), quote(&cwd)
+        ));
+            let frame = out.get("bootstrap").or_else(|| out.get("handoff")).unwrap();
+            assert_eq!(frame["outcome"], "started", "{out}");
+            let pane = frame["pane"]
+                .as_str()
+                .or_else(|| frame["launch"]["pane"].as_str())
+                .unwrap();
+            let start = wait_for("selected child record", Duration::from_secs(20), || {
+                child_start(m, kind, pane).ok_or_else(|| pane.to_owned())
+            });
+            assert_eq!(start["cwd"], cwd.to_str().unwrap(), "{start}");
+            assert_eq!(start["config_home"], selected.to_str().unwrap(), "{start}");
+            assert_eq!(
+                start["home"],
+                m.home().to_str().unwrap(),
+                "HOME must stay isolated: {start}"
+            );
+            // Even after the invoking shell and both caller profile hints change, a completed
+            // public retry uses the retained original and performs no second native launch.
+            let before = effect_counts(m, caller);
+            let recovery = frame["recovery_ref"].as_str().unwrap();
+            let changed = m.agent_run(caller, &format!(
+            "cd / && CODEX_HOME=/missing-changed-caller CLAUDE_CONFIG_DIR=/missing-changed-caller herdr-threads --json retry {recovery}"
+        ));
+            assert_eq!(changed["rc"], 0, "{changed}");
+            assert!(
+                changed["result_json"].to_string().contains(pane),
+                "{changed}"
+            );
+            assert_eq!(effect_counts(m, caller), before, "retry must be historical");
+        }
+    }
+
+    let before = effect_counts(m, caller);
+    let profile = m.home().join(".codex");
+    let missing = m.home().join("missing-directory");
+    let file = m.home().join("ordinary-file");
+    fs::write(&file, "not a directory").unwrap();
+    for options in [
+        format!(
+            "--new-tab invalid --kind codex --profile-dir {}",
+            quote(&missing)
+        ),
+        format!("--new-tab invalid --kind codex --cwd {}", quote(&missing)),
+        format!("--new-tab invalid --kind codex --cwd {}", quote(&file)),
+        format!(
+            "--new-tab invalid --kind codex --profile-dir {}",
+            quote(&file)
+        ),
+        format!(
+            "--new-tab invalid --kind agy --profile-dir {}",
+            quote(&profile)
+        ),
+        format!(
+            "--pane {caller} --kind codex --profile-dir {}",
+            quote(&profile)
+        ),
+        format!("--pane {caller} --kind codex --cwd {}", quote(&cwd)),
+        format!(
+            "--existing --seat missing-seat --profile-dir {}",
+            quote(&profile)
+        ),
+        format!("--existing --seat missing-seat --cwd {}", quote(&cwd)),
+    ] {
+        let out = m.agent_run(
+            caller,
+            &format!("herdr-threads --json handoff {options} -- refused-work"),
+        );
+        assert_ne!(out["rc"], 0, "must refuse {options}: {out}");
+        assert_eq!(
+            effect_counts(m, caller),
+            before,
+            "refusal effects: {options}"
+        );
+    }
+    // agy has no independent profile selector; cwd-only new-tab remains supported.
+    let agy = m.agent_ht(
+        caller,
+        &format!(
+            "handoff --new-tab agy-cwd --kind agy --cwd {} -- cwd-only-work",
+            quote(&cwd)
+        ),
+    );
+    let frame = &agy["bootstrap"];
+    assert_eq!(frame["outcome"], "started", "{agy}");
+    let pane = frame["pane"].as_str().unwrap();
+    let observed = wait_for("agy cwd child", Duration::from_secs(20), || {
+        child_start(m, "agy", pane).ok_or_else(|| pane.to_owned())
+    });
+    assert_eq!(observed["cwd"], cwd.to_str().unwrap(), "{observed}");
+    assert_eq!(observed["home"], m.home().to_str().unwrap(), "{observed}");
+}
+
+fn child_start(m: &Matrix, kind: &str, pane: &str) -> Option<Value> {
+    if kind == "codex" {
+        return m.log_of(pane).into_iter().find(|e| e["kind"] == "start");
+    }
+    fs::read_dir(m.home().join(format!(".fake-{kind}")))
+        .ok()?
+        .flatten()
+        .find_map(|entry| {
+            let row: Value = serde_json::from_slice(&fs::read(entry.path()).ok()?).ok()?;
+            (row["pane"] == pane).then_some(row)
+        })
+}
+
+/// Durable state plus native tab and start counts: parser/admission refusals must not
+/// allocate a thread/seat/invitation/message, create a tab or start a helper.
+fn effect_counts(m: &Matrix, caller: &str) -> Vec<i64> {
+    let db = rusqlite::Connection::open_with_flags(
+        m.host
+            .root()
+            .join("st/herdr/plugins/herdr-threads/node/herdr-threads.db"),
+        rusqlite::OpenFlags::SQLITE_OPEN_READ_ONLY,
+    )
+    .unwrap();
+    let mut counts: Vec<i64> = [
+        "SELECT count(*) FROM threads",
+        "SELECT count(*) FROM seats",
+        "SELECT count(*) FROM invitations",
+        "SELECT count(*) FROM messages WHERE kind='ordinary'",
+    ]
+    .iter()
+    .map(|sql| db.query_row(sql, [], |row| row.get(0)).unwrap())
+    .collect();
+    let tabs = m.herdr(&[
+        "tab",
+        "list",
+        "--workspace",
+        caller.split(':').next().unwrap(),
+    ]);
+    counts.push(
+        tabs["result"]["tabs"]
+            .as_array()
+            .unwrap_or_else(|| panic!("{tabs}"))
+            .len() as i64,
+    );
+    counts.push(m.logs().len() as i64);
+    counts.push(
+        fs::read_dir(m.home().join(".fake-agy"))
+            .map(|d| d.count() as i64)
+            .unwrap_or(0),
+    );
+    counts.push(
+        fs::read_dir(m.home().join(".fake-claude"))
+            .map(|d| d.count() as i64)
+            .unwrap_or(0),
+    );
+    counts
+}
+
+fn quote(path: &Path) -> String {
+    format!("'{}'", path.to_str().unwrap().replace('\'', "'\\''"))
+}
