+/// Kills: using `seats.state='retired'` as the test, which a reversible retirement also sets.
+#[test]
+fn operator_write_to_a_reversibly_retired_seat_still_writes() {
+    let (context, mut conn) = setup();
+    conn.execute(
+        "INSERT INTO reversible_retirements(seat_id,state,cutover_at,reason) VALUES ('s','reversible',1,'closed')",
+        [],
