 #[cfg(test)]
 mod tests {
+    #[test]
+    fn process_root_is_named_only_by_codex_from_the_auxiliary_marker() {
+        use crate::harness::adapter::RootCandidate;
+        use crate::protocol::ids::NativeSessionId;
+        let (a, b, c) = (
+            NativeSessionId::new("a"),
+            NativeSessionId::new("b"),
+            NativeSessionId::new("c"),
+        );
+        // (concurrent_session, auxiliary_session)
+        let cand = |s: &'static NativeSessionId, concurrent, auxiliary| RootCandidate {
+            native_session: s,
+            observation_provenance: "cooperative_top_level",
+            concurrent_session: concurrent,
+            auxiliary_session: auxiliary,
+        };
+        let (a, b, c): (&'static _, &'static _, &'static _) = (
+            Box::leak(Box::new(a)),
+            Box::leak(Box::new(b)),
+            Box::leak(Box::new(c)),
+        );
+        for registration in builtins().registrations() {
+            let side = [cand(a, false, false), cand(b, false, true)];
+            let named = registration.wake_process_root(&side);
+            if registration.metadata().id == "codex" {
+                // A root beside an auxiliary side names the root, whatever the listing order.
+                assert_eq!(named, Some(0));
+                assert_eq!(
+                    registration.wake_process_root(&[cand(b, false, true), cand(a, false, false)]),
+                    Some(1)
+                );
+                // A fork-SessionStart side carries both bits and is still a side.
+                assert_eq!(
+                    registration.wake_process_root(&[cand(a, false, false), cand(b, true, true)]),
+                    Some(0)
+                );
+                assert_eq!(
+                    registration.wake_process_root(&[
+                        cand(a, false, false),
+                        cand(b, false, true),
+                        cand(c, true, true)
+                    ]),
+                    Some(0)
+                );
+                // A non-/side fork (concurrent without auxiliary) beside its original: no root.
+                assert_eq!(
+                    registration.wake_process_root(&[cand(a, false, false), cand(b, true, false)]),
+                    None
+                );
+                assert_eq!(
+                    registration.wake_process_root(&[
+                        cand(a, false, false),
+                        cand(b, false, true),
+                        cand(c, true, false)
+                    ]),
+                    None
+                );
+                // Two plain bindings, a root that is itself auxiliary, and no plain one: no root.
+                assert_eq!(
+                    registration.wake_process_root(&[cand(a, false, false), cand(b, false, false)]),
+                    None
+                );
+                assert_eq!(
+                    registration.wake_process_root(&[cand(a, false, true), cand(b, false, true)]),
+                    None
+                );
+                assert_eq!(
+                    registration.wake_process_root(&[cand(a, true, false), cand(b, false, true)]),
+                    None
+                );
+                assert_eq!(
+                    registration.wake_process_root(&[cand(a, false, false)]),
+                    Some(0)
+                );
+            } else {
+                assert_eq!(named, None, "{} names no root", registration.metadata().id);
+            }
+        }
+    }
