+#[test]
+fn migration_0020_seat_config_shape() {
+    // Fresh and upgraded stores both land on the same DDL.
+    let upgraded = Connection::open_in_memory().unwrap();
+    open_with(&upgraded, &[]).unwrap();
+    open_with(&upgraded, schema::NODE_DELTAS).unwrap();
+    for db in [fresh_db(), upgraded] {
+        assert!(table_exists(&db, "seat_config"));
+        let cols: Vec<(String, String, i64, i64)> = db
+            .prepare("SELECT name,type,\"notnull\",pk FROM pragma_table_info('seat_config') ORDER BY cid")
+            .unwrap()
+            .query_map([], |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?, r.get(3)?)))
+            .unwrap()
+            .map(Result::unwrap)
+            .collect();
+        let col = |n: &str, t: &str, nn: i64, pk: i64| (n.to_owned(), t.to_owned(), nn, pk);
+        assert_eq!(
+            cols,
+            vec![
+                col("seat_id", "TEXT", 1, 1),
+                col("key", "TEXT", 1, 2),
+                col("value", "TEXT", 0, 0),
+                col("updated_at", "INTEGER", 1, 0),
+                col("writer_provenance", "TEXT", 1, 0),
+                col("writer_binding", "TEXT", 0, 0),
+            ]
+        );
+    }
+}
