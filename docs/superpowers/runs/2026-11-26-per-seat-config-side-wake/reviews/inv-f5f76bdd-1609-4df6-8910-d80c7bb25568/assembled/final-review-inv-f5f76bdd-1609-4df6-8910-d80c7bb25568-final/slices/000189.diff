+// Kills: a session-scoped contact read that answers from the seat-scoped time (a `/side` call
+// would then read as the root's), or one that ignores the native session (a root re-registered
+// under a new binding would read as silent).
+#[test]
+fn contact_is_recorded_per_seat_and_per_native_session() {
+    let state = DeliveryPullState::default();
+    let seat = SeatId::new("seat");
+    let (root, side) = (NativeSessionId::new("root"), NativeSessionId::new("side"));
+    let at = |ms| UtcMillis(ms);
+    assert_eq!(
+        state.contacted_since_session(&seat, &root, at(0)),
+        Some(false)
+    );
+    state.record_contact(&seat, &side, at(50));
+    assert_eq!(state.contacted_since(&seat, at(50)), Some(true));
+    assert_eq!(
+        state.contacted_since_session(&seat, &side, at(50)),
+        Some(true)
+    );
+    assert_eq!(
+        state.contacted_since_session(&seat, &root, at(0)),
+        Some(false)
+    );
+    assert_eq!(
+        state.contacted_since_session(&SeatId::new("other"), &side, at(0)),
+        Some(false)
+    );
+    // The root, whichever binding carried the call, settles from its own call alone.
+    state.record_contact(&seat, &root, at(60));
+    state.record_contact(&seat, &root, at(55));
+    assert_eq!(
+        state.contacted_since_session(&seat, &root, at(60)),
+        Some(true)
+    );
+    assert_eq!(
+        state.contacted_since_session(&seat, &root, at(61)),
+        Some(false)
+    );
+}
