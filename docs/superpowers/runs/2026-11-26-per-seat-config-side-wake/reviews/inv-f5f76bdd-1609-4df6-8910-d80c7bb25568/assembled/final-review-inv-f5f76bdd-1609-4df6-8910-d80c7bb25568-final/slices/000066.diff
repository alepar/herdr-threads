+def side_queue_passed(setup_ok, proof, delivered_in_root, side_typed, side_view_changed):
+    """side-queue's verdict: the side chat was set up and left displayed, the queue proof passed (Accepted intent on the
+    root session naming the side sessions), the item was delivered in the root's turn, and the side chat's pane shows
+    nothing typed and no other change."""
