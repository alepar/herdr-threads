+#[test]
+fn lone_root_selects_with_no_side_sessions() {
+    let (store, r) = seat_with(&[], |_| {});
+    let (root, sides) = selected(&select(&store, &r));
+    assert_eq!(root, SESSION_ROOT);
+    assert!(sides.is_empty());
+}
