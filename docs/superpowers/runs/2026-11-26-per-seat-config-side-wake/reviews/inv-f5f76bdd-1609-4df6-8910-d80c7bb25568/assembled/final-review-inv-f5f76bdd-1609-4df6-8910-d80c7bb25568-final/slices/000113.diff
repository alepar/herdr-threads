+/// Hook evidence that the claim's session is auxiliary (`CallerClaim::auxiliary_session`) sets the
+/// binding's sticky `auxiliary_session` bit (ht-z41e.21). It never writes 0, never touches
+/// `concurrent_session`, and ignores a subagent or person claim: only queue root selection reads it.
+fn mark_auxiliary(
+    tx: &Connection,
+    claim: &CallerClaim,
+    resolution: &Resolution,
+) -> Result<(), ApiError> {
+    let binding = resolution.binding();
+    if !claim.auxiliary_session
+        || claim.is_subagent()
+        || claim.harness == crate::protocol::authority::Harness::Human
+        || binding.role != BindingRole::TopLevel
+    {
+        return Ok(());
+    }
+    tx.execute(
+        "UPDATE occupant_bindings SET auxiliary_session=1 WHERE binding_id=?1 AND auxiliary_session=0",
+        [binding.binding_id.as_str()],
+    )
+    .map_err(store_error)?;
+    Ok(())
+}
