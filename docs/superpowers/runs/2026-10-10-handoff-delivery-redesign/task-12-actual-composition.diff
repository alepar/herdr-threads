+            .is_err()
+        );
+        assert!(
+            db.execute(
+                "INSERT INTO automatic_bootstrap_attempts VALUES(99,2,'created',0,?1)",
+                [vec![b'x'; 131073]]
+            )
+            .is_err()
+        );
+        drop(store);
+        drop(db);
+        std::fs::remove_file(path).unwrap();
+    }
+}
