+    );
+    assert_eq!(
+        db.query_row(
+            "SELECT count(*) FROM receipt_state WHERE message_id NOT GLOB 'old*'",
+            [],
+            |r| r.get::<_, i64>(0)
+        )
+        .unwrap(),
+        0,
+        "unpublished preparation must not materialize"
+    );
+    assert_eq!(
+        db.query_row("SELECT count(*) FROM pragma_foreign_key_check", [], |r| r
+            .get::<_, i64>(
+            0
+        ))
+        .unwrap(),
+        0
+    );
+    drop(db);
+    std::fs::remove_file(path).unwrap();
+}
