+        receipts::scan_due(
+            &context,
+            &mut reopened,
+            100,
+            &mut receipts::ReceiptDueCursor::default()
+        )
+        .unwrap()
+        .inspected,
+        1,
+        "restart captures the new eligible episode"
+    );
