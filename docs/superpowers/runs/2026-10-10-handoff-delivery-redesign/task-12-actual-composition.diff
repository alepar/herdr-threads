+    let (rowid,ordinal):(i64,i64)=db.query_row("SELECT r.rowid,p.ordinal FROM receipt_state r JOIN receipt_due_sparse p USING(message_id,seat_id)",[],|r|Ok((r.get(0)?,r.get(1)?))).unwrap();
