+            db.query_row("SELECT count(*) FROM messages WHERE kind='warn'", [], |r| r
+                .get::<_, i64>(0))
+                .unwrap(),
+            0,
+            "extension still suppresses overdue warning"
+        );
+        drop(db);
+        std::fs::remove_file(path).unwrap();
+    }
+}
