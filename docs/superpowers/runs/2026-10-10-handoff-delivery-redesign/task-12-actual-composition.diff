+        );
+        assert_eq!(
+            {
+                let mut rows = catalog(&db);
+                normalize_capacity(&mut rows);
+                rows
+            },
+            expected_catalog,
+            "composed additive32..35 preserves old definitions/rootpages and adds exact origin columns"
+        );
+        for (table, retained) in tables.iter().zip(&before) {
