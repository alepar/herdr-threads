+                                reservation: OperationId::new(escaped.clone()),
+                                administrative_revision: u64::MAX,
+                            }),
+                        },
+                    )),
+                ] {
+                    let response = WireResponse {
+                        version: PROTOCOL_VERSION,
+                        request_id: escaped.clone(),
+                        instance: "f".repeat(36),
+                        daemon_boot: "f".repeat(36),
+                        result: Ok(result),
+                    };
