+            role: CallerRole::TopLevel,
+            harness: if human {
+                Harness::Human
+            } else {
+                Harness::Codex
+            },
+            native_session: NativeSessionId::new("session"),
+            execution: ExecutionId::new("00000000-0000-4000-8000-000000000002"),
+            target: HostTargetId::new("seat-a"),
