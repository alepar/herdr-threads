 # The full suite runs under cargo-nextest (AGENTS.md): every test is its own
 # process, and tests of different binaries run side by side instead of one
 # binary after another as under `cargo test`. The process-wide locks in the
 # test binaries (hook_entrypoint's SERIAL, integration's ONE_DAEMON, service's
 # IN_PROCESS_DAEMON) cannot span processes; the test groups below keep each
 # chain's tests one at a time, as under `cargo test`.
 
 [test-groups]
+# Full automatic envelopes exercise the unchanged 250 ms cooperative permits.
+automatic-envelope = { max-threads = 1 }
 # hook_entrypoint asserts wall-clock hook budgets (1.5 s tool, 5 s lifecycle);
 # its spawned hooks starve each other when run together (ht-p03.8).
 hook-budget = { max-threads = 1 }
 # Tests that ran behind ONE_DAEMON (integration) or IN_PROCESS_DAEMON
 # (service): an elected in-process daemon each, several asserting latency
 # budgets (100 ms). The long real-time ones (ran_in_own_process) are not in a
 # group: under `cargo test` they already ran beside the chain.
 integration-daemon = { max-threads = 1 }
 service-daemon = { max-threads = 1 }
 # The mod delivery sweep (ht-j16.10): each test runs an elected in-process
@@ -145,10 +147,19 @@ test-group = "mod-delivery"
 fail-fast = false
 # The v0.2.6 six-slot push run accumulated 1809 test-seconds, already
 # over the 300 s budget even at full utilization. Seven slots overlap IPC
 # and clock waits; all three serialized groups above remain unchanged.
 # The workflow retains its strict 300 s wall-clock guard.
 test-threads = 7
 
 [profile.ci.junit]
 path = "junit.xml"
 store-success-output = true
+
+# The two full-envelope positives overlapped under the lib runner and expired
+# 250 ms permits; the boundary case reaches decisions at 180-192 ms alone.
+# Keep exact body/metadata geometry and permit budgets, and run these alone.
+[[profile.default.overrides]]
+filter = "test(/^cli::topology_handoff::tests::live::automatic_live::modern_automatic_(maximum_escaped_body_completes_and_recovers_exactly|actual_admission_boundary_completes_and_next_metadata_size_has_zero_effects)$/)"
+test-group = "automatic-envelope"
+threads-required = "num-test-threads"
+priority = 100
