+                        .map_err(|_| "automatic future reply encoding")?
+                        .len()
+                        + 4
+                        > MAX_AUTOMATIC_RESPONSE_FRAME_BYTES
+                    {
+                        return Err("automatic future response exceeds 2 MiB");
+                    }
+                }
+                let message = CommandResult::MessageSent(MessageId::new(escaped.clone()));
