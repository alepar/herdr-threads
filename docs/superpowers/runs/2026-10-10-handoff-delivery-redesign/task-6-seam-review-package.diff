+    match mode.as_deref() {
+        None => Ok((None, None)),
+        Some("lazy") => Ok((Some(InvitationConfirmation::Lazy), None)),
+        Some("require_ack") => Ok((
+            Some(InvitationConfirmation::RequireAck),
+            Some(UtcMillis(deadline)),
+        )),
+        Some(_) => Err(api_error(
+            ErrorCode::StoreCorrupt,
+            "invalid invitation confirmation policy",
+        )),
+    }
