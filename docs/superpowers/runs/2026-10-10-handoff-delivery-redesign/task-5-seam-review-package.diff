+                .query_map([], |r| Ok((r.get::<_, String>(0)?, r.get::<_, String>(1)?, r.get::<_, String>(2)?, r.get::<_, i64>(3)?, r.get::<_, Option<String>>(4)?)))
+                .unwrap().map(Result::unwrap).collect::<Vec<_>>()
+        };
+        let old_catalog = catalog(&db);
