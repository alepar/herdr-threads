+    let mut visited = 0;
+    let mut transitions = 0;
+    let mut done = false;
+    for _ in 0..8 {
+        let page = crate::store::materialization::backfill_receipt_deadlines(&mut db, 100).unwrap();
+        assert!(page.inspected <= 100);
