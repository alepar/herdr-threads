+    require_send_time_receipts_capability(client, clock)?;
+    if policy.is_some() {
+        require_mutation_capability(
+            client,
+            clock,
+            crate::protocol::capabilities::INVITATION_CONFIRMATION_V1,
+            "freezing handoff invitation confirmation",
+        )?;
+    }
+    Ok(())
+}
