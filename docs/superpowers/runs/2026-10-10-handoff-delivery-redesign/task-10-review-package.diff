+/// Refuse before allocating caller/recipient seats, publishing work or launching.
+pub(crate) fn require_handoff_capabilities<C: LocalClient + ?Sized>(
+    client: &C,
+    clock: &dyn Clock,
+    policy: Option<&crate::protocol::handoff::HandoffPolicy>,
