+    let message: String = db
+        .query_row("SELECT id FROM messages WHERE kind='ordinary'", [], |r| {
+            r.get(0)
+        })
+        .unwrap();
+    let receipt = crate::store::effective::effective_receipt(&db, &message, "recipient")
+        .unwrap()
+        .unwrap();
+    (mode, duration, deadline, receipt)
