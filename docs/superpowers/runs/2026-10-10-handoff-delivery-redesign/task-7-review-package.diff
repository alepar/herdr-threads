+    assert_eq!(
+        db.query_row("SELECT count(*) FROM receipt_warning_origins", [], |r| r
+            .get::<_, i64>(0))
+            .unwrap(),
+        1
+    );
+    drop(db);
+    let reopened = context.open_writer().unwrap();
+    assert_eq!(
+        reopened
+            .query_row("SELECT count(*) FROM warning_conditions", [], |r| r
+                .get::<_, i64>(0))
