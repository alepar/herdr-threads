+    assert!(
+        !found
+            .items
+            .iter()
+            .any(|c| c.seat.as_str() == "b" && c.has_actionable_work()),
+        "invalid source must be excluded by the actual upstream discovery path"
+    );
+    assert_eq!(
+        db.query_row(
+            "SELECT count(*) FROM receipt_warning_origins WHERE seat_id='b'",
+            [],
+            |r| r.get::<_, i64>(0)
+        )
+        .unwrap(),
+        0,
+        "raw overlay markers, wrong manifest audience, nullable kind and service label cannot establish canonical native origin"
+    );
+}
