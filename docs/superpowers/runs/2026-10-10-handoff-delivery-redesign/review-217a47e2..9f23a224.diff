+        {
+            Some(Some((*name).to_owned()))
+        }
         [.., "hook", h, "--event", name] if *h == harness => Some(Some((*name).to_owned())),
         [.., "hook", h] if *h == harness => Some(None),
         _ => None,
     }
 }
 
