+#[test]
+fn stable_foreign_identical_and_owned_drift_are_preserved() {
+    for (kind, harness) in [
+        (SettingsKind::ClaudeUser, "claude"),
+        (SettingsKind::CodexUser, "codex"),
+    ] {
+        let dir = std::env::temp_dir().join(format!("ht-task9-{}", uuid::Uuid::new_v4()));
