+fn presentation_refresh_observes_lazy_context_and_removal_without_consuming_output() {
+    use crate::protocol::commands::{Accept, SetTopic};
+    let f = fixture(0);
+    let recipient = pull_seat(&f);
+    let inviter = check_in(
+        &f,
