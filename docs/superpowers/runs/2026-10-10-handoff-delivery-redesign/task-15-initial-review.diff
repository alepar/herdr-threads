+    let mut absent = false;
+    for _ in 0..128 {
+        let proof = relevance_pull(&db);
+        assert_ne!(
+            proof.relevance,
+            Relevance::Open,
+            "both old-episode conditions are logically covered"
+        );
+        if proof.relevance == Relevance::Absent {
+            absent = true;
+            break;
+        }
+    }
