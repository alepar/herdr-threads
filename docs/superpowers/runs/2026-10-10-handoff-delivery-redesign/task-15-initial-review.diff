+    }
+    db.execute_batch("BEGIN IMMEDIATE; PRAGMA ignore_check_constraints=ON; UPDATE presentation_warning_proofs SET proof_json=CAST(X'80' AS TEXT); PRAGMA ignore_check_constraints=OFF").unwrap();
