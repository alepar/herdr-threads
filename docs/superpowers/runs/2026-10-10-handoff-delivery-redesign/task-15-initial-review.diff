+        );
+        registry.mark_dirty();
+        registry.pass(f.clock.utc_now()).unwrap();
+        assert!(
+            sink.0
+                .lock()
+                .unwrap()
+                .iter()
+                .any(|frame| matches!(frame, WatchFrame::Attention { .. })),
