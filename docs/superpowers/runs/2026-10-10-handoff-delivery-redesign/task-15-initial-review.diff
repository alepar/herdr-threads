+        db.execute("UPDATE presentation_warning_proofs SET proof_json=?1 WHERE seat_id='s' AND consumer='hook'",[value]).unwrap();
+        db.execute_batch("PRAGMA ignore_check_constraints=OFF")
+            .unwrap();
