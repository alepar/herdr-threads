+    assert_eq!(f.db.query_row("SELECT ordinary_pending FROM invitation_presentation_consumers WHERE seat_id='s' AND consumer='hook'",[],|r|r.get::<_,String>(0)).unwrap(),carry,"four scalars add zero carry bytes");
