+            Ok(CommandResult::DeliveryPresentationConfirmedV2(result)),
+        ]);
+        let prepared = rig.prepare(
+            "PreInvocation",
+            json!({"invocationNum": 0}),
+            Some(&fake),
+            &runtime(1000, &ident("a")),
+        );
+        complete_step(
+            &prepared.completion.unwrap().0,
+            &fake,
+            &rig.state,
+            Instant::now() + Duration::from_secs(30),
+        );
+        assert!(!rig.state_file().exists());
+    }
+    let rig = Rig::new();
+    let fake = offering();
+    let prepared = rig.prepare(
+        "PreInvocation",
+        json!({"invocationNum": 0}),
+        Some(&fake),
+        &runtime(1000, &ident("a")),
+    );
+    complete_step(
+        &prepared.completion.unwrap().0,
+        &fake,
+        &rig.state,
+        Instant::now() - Duration::from_millis(1),
+    );
+    assert!(!rig.state_file().exists());
+    assert_eq!(fake.calls().len(), 1, "expired completion sends no command");
+}
