+#[test]
+fn postflush_state_hint_does_not_overwrite_an_observed_concurrent_change() {
+    let rig = Rig::new();
+    let fake = offering();
+    let prepared = rig.prepare(
+        "PreInvocation",
+        json!({"invocationNum": 0}),
+        Some(&fake),
+        &runtime(1000, &ident("a")),
