+                    })
+                    .map_err(store_error)?
+                    .collect::<Result<Vec<_>, _>>()
+                    .map_err(store_error)?
+            };
+            let count = u16::try_from(rows.len()).map_err(|_| {
+                api_error(
+                    ErrorCode::StoreCorrupt,
+                    "receipt discovery repair batch too large",
