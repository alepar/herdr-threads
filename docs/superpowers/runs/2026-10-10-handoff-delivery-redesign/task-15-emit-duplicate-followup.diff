+#[test]
+fn completion_rejects_duplicate_captured_control_stamps() {
+    let rig=Rig::new();
+    let items=vec![PresentationItemV2::Attention{epoch:"1".into(),attention_version:11,text:"attention".into()}];
+    let fake=modern_fake(vec![modern_reply(items,Some(&"a".repeat(32)),999,InjectionStep::SystemMessage,vec![])]);
+    let prepared=rig.prepare("PreInvocation",json!({"invocationNum":0}),Some(&fake),&runtime(1000,&ident("a")));
+    let mut completion:EmissionCompletion=serde_json::from_slice(&prepared.completion.unwrap().0).unwrap();
+    completion.emitted_controls.push(completion.emitted_controls[0].clone());
+    assert!(!valid_completion(&completion),"duplicate captured controls must be refused before confirmation or local hint writes");
+}
