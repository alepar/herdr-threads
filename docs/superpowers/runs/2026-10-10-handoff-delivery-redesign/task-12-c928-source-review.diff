+ SELECT id,4,1 FROM seats WHERE id=NEW.seat_id AND instance_id=NEW.instance_id AND state!='retired'
+ ON CONFLICT(seat_id) DO UPDATE SET reason_bits=reason_bits|4,attention_version=attention_version+1;
+ END;
