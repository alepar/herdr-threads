+    drop(db);
+    let failure_path = path.with_extension("rollback.db");
+    std::fs::copy(&path, &failure_path).unwrap();
+    let db = Connection::open(&path).unwrap();
+    db.pragma_update(None, "foreign_keys", true).unwrap();
+    assert_eq!(
