+pub(crate) fn backfill_receipt_deadlines_in(
+    tx: &Connection,
+    limit: u16,
+) -> Result<ReceiptBackfillResult, ApiError> {
+    if !(1..=100).contains(&limit) {
+        return Err(api_error(
+            ErrorCode::InvalidRequest,
+            "invalid receipt backfill limit",
