+        );
+        assert!(
+            remaining["hooks"]["SessionStart"][0]["hooks"][0]["command"]
+                .as_str()
+                .unwrap()
+                .contains("'/foreign'")
+        );
+        fs::remove_dir_all(dir).unwrap();
+    }
