+            }
+            assert!(
+                validate(&PermitMutation::SendMessage(altered)).is_err(),
+                "{change}"
+            );
+        }
+        assert_eq!(
+            db.total_changes(),
+            before,
+            "phase validation mutates no canonical or native state"
+        );
