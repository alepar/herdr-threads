+    ApiError,
+> {
+    use crate::protocol::commands::InvitationConfirmation;
+    let (mode, deadline): (Option<String>, i64) = db
+        .query_row(
+            "SELECT confirmation,deadline_at FROM invitations WHERE id=?1",
+            [invitation],
+            |r| Ok((r.get(0)?, r.get(1)?)),
