+            |r| r.get::<_, i64>(0)
+        )
+        .unwrap(),
+        0
+    );
+    assert_eq!(
+        conn.query_row(
+            "SELECT count(*) FROM wake_work WHERE seat_id='s1' AND reason_bits!=0",
+            [],
+            |r| r.get::<_, i64>(0)
+        )
+        .unwrap(),
+        0
+    );
+    assert!(
+        crate::store::attention::wake_seat_attention(conn, "s1")
+            .unwrap()
+            .attention
+            .latest_warning_seq
+            .is_none()
+    );
+    assert_eq!(
+        crate::store::seats::mod_seat_view(conn, "i", &SeatId::new("s1"))
+            .unwrap()
+            .unwrap()
+            .fingerprint
+            .other_pending,
+        0
+    );
+}
