+fn stable_same_event_foreign_route_conflicts_without_config_changes() {
+    for kind in [
+        crate::harness::claude::settings_kind(),
+        crate::harness::codex::settings_kind(),
+    ] {
+        let dir = std::env::temp_dir().join(format!("ht-task9-{}", uuid::Uuid::new_v4()));
