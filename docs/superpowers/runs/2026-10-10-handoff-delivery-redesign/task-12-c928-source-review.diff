+fn native_event_entrypoints_validate_registered_pairs_and_keep_legacy_syntax() {
+    for (harness, event) in [
+        ("claude", "SessionStart"),
+        ("claude", "PreToolUse"),
+        ("codex", "SessionStart"),
+        ("codex", "SubagentStart"),
+        ("codex", "PreToolUse"),
