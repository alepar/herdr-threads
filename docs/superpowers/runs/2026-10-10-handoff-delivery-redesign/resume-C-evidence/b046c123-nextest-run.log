tained'); END")), ("trigger", "invitation_cancellations_shape", "invitation_cancellations", 0, Some("CREATE TRIGGER invitation_cancellations_shape BEFORE INSERT ON invitation_cancellations\nBEGIN\n    SELECT RAISE(ABORT, 'invalid invitation cancellation') WHERE NOT EXISTS (\n        SELECT 1 FROM invitations i JOIN requirement_episodes r ON r.invitation_id=i.id\n        WHERE i.id=NEW.invitation_id AND r.id=NEW.requirement_id\n            AND i.state='pending' AND r.state='released'\n            AND r.created_decision_seq=i.created_decision_seq\n    );\nEND")), ("trigger", "invitation_rejections_immutable", "invitation_rejections", 0, Some("CREATE TRIGGER invitation_rejections_immutable BEFORE UPDATE ON invitation_rejections\nBEGIN SELECT RAISE(ABORT, 'invitation rejection is immutable'); END")), ("trigger", "invitation_rejections_project", "invitation_rejections", 0, Some("CREATE TRIGGER invitation_rejections_project AFTER INSERT ON invitation_rejections\nBEGIN UPDATE invitations SET reject_recorded=1 WHERE id=NEW.invitation_id; END")), ("trigger", "invitation_rejections_retained", "invitation_rejections", 0, Some("CREATE TRIGGER invitation_rejections_retained BEFORE DELETE ON invitation_rejections\nBEGIN SELECT RAISE(ABORT, 'invitation rejection is retained'); END")), ("trigger", "invitation_rejections_shape", "invitation_rejections", 0, Some("CREATE TRIGGER invitation_rejections_shape BEFORE INSERT ON invitation_rejections\nBEGIN\n    SELECT RAISE(ABORT, 'invalid invitation rejection') WHERE NOT EXISTS (\n        SELECT 1 FROM invitations i WHERE i.id=NEW.invitation_id\n        AND i.seat_id=NEW.actor_seat_id AND i.state='pending'\n        AND NOT EXISTS(SELECT 1 FROM invitation_cancellations c WHERE c.invitation_id=i.id)\n        AND NOT EXISTS(SELECT 1 FROM requirement_episodes r WHERE r.invitation_id=i.id AND r.state IN ('pending','accepted'))\n    );\nEND")), ("trigger", "invitations_confirmation_immutable", "invitations", 0, Some("CREATE TRIGGER invitations_confirmation_immutable BEFORE UPDATE OF confirmation,inviter_seat_id ON invitations\nWHEN NEW.confirmation IS NOT OLD.confirmation OR NEW.inviter_seat_id IS NOT OLD.inviter_seat_id\nBEGIN SELECT RAISE(ABORT, 'invitation policy and origin are immutable'); END")), ("trigger", "invitations_confirmation_origin", "invitations", 0, Some("CREATE TRIGGER invitations_confirmation_origin BEFORE INSERT ON invitations\nWHEN NEW.confirmation IS NOT NULL AND NEW.inviter_seat_id IS NULL\nBEGIN SELECT RAISE(ABORT, 'modern invitation requires original inviter'); END")), ("trigger", "invitations_decision_immutable", "invitations", 0, Some("CREATE TRIGGER invitations_decision_immutable BEFORE UPDATE OF created_decision_seq ON invitations\nBEGIN SELECT RAISE(ABORT, 'invitation decision is immutable'); END")), ("trigger", "invitations_ordinal_immutable", "invitations", 0, Some("CREATE TRIGGER invitations_ordinal_immutable BEFORE UPDATE OF ordinal ON invitations\nBEGIN SELECT RAISE(ABORT, 'invitation ordinal is immutable'); END")), ("trigger", "invitations_rejection_projection_guard", "invitations", 0, Some("CREATE TRIGGER invitations_rejection_projection_guard BEFORE UPDATE OF reject_recorded ON invitations\nWHEN NEW.reject_recorded<>EXISTS(SELECT 1 FROM invitation_rejections r WHERE r.invitation_id=NEW.id)\nBEGIN SELECT RAISE(ABORT, 'invitation rejection projection mismatch'); END")), ("trigger", "invitations_rejection_projection_insert", "invitations", 0, Some("CREATE TRIGGER invitations_rejection_projection_insert BEFORE INSERT ON invitations\nWHEN NEW.reject_recorded<>0\nBEGIN SELECT RAISE(ABORT, 'new invitation cannot claim rejection'); END")), ("trigger", "lazy_manifest_source", "send_manifests", 0, Some("CREATE TRIGGER lazy_manifest_source BEFORE INSERT ON send_manifests\nBEGIN\n    SELECT RAISE(ABORT, 'lazy manifest source mismatch') WHERE\n        (SELECT delivery_mode FROM send_preparations WHERE id=NEW.preparation_id) IS NOT (SELECT delivery_mode FROM messages WHERE id=NEW.me