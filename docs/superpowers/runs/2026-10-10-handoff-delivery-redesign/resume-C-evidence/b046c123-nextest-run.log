aration_id)>5 THEN 'msg-'||substr(NEW.preparation_id,6) WHEN length(NEW.preparation_id)=9 AND substr(NEW.preparation_id,1,1)='p' AND substr(NEW.preparation_id,2) NOT GLOB '*[^A-Za-z0-9]*' THEN 'm'||substr(NEW.preparation_id,2) ELSE NULL END)\n        OR ((SELECT delivery_mode FROM messages WHERE id=NEW.message_id)='lazy' AND NEW.warning_count<>0);\nEND")), ("trigger", "lazy_message_mode_immutable", "messages", 0, Some("CREATE TRIGGER lazy_message_mode_immutable BEFORE UPDATE OF delivery_mode ON messages\nWHEN NEW.delivery_mode IS NOT OLD.delivery_mode\nBEGIN SELECT RAISE(ABORT, 'recorded message mode is immutable'); END")), ("trigger", "lazy_message_shape", "messages", 0, Some("CREATE TRIGGER lazy_message_shape BEFORE INSERT ON messages\nWHEN NEW.delivery_mode='lazy' AND NEW.kind<>'ordinary'\nBEGIN SELECT RAISE(ABORT, 'lazy message must be ordinary content'); END")), ("trigger", "lazy_preparation_mode_immutable", "send_preparations", 0, Some("CREATE TRIGGER lazy_preparation_mode_immutable BEFORE UPDATE OF delivery_mode ON send_preparations\nWHEN NEW.delivery_mode IS NOT OLD.delivery_mode\nBEGIN SELECT RAISE(ABORT, 'delivery mode is immutable'); END")), ("trigger", "lazy_recipient_display_published", "lazy_recipients", 0, Some("CREATE TRIGGER lazy_recipient_display_published BEFORE UPDATE OF state ON lazy_recipients\nWHEN NEW.state='displayed' AND NOT EXISTS (\n    SELECT 1 FROM send_manifests sm JOIN messages m ON m.id=sm.message_id\n    WHERE sm.preparation_id=OLD.preparation_id AND sm.message_id=OLD.message_id AND sm.thread_id=OLD.thread_id AND m.delivery_mode='lazy'\n)\nBEGIN SELECT RAISE(ABORT, 'unpublished lazy delivery cannot complete'); END")), ("trigger", "lazy_recipient_identity_immutable", "lazy_recipients", 0, Some("CREATE TRIGGER lazy_recipient_identity_immutable BEFORE UPDATE OF ordinal,preparation_id,message_id,thread_id,seat_id ON lazy_recipients\nBEGIN SELECT RAISE(ABORT, 'lazy recipient identity is immutable'); END")), ("trigger", "lazy_recipient_progress_forward", "lazy_recipients", 0, Some("CREATE TRIGGER lazy_recipient_progress_forward BEFORE UPDATE OF state ON lazy_recipients\nWHEN OLD.state='displayed' AND NEW.state<>'displayed'\nBEGIN SELECT RAISE(ABORT, 'lazy delivery progress cannot regress'); END")), ("trigger", "lazy_recipient_published_retained", "lazy_recipients", 0, Some("CREATE TRIGGER lazy_recipient_published_retained BEFORE DELETE ON lazy_recipients\nWHEN EXISTS(SELECT 1 FROM send_manifests WHERE preparation_id=OLD.preparation_id)\nBEGIN SELECT RAISE(ABORT, 'published lazy delivery is retained'); END")), ("trigger", "lazy_recipient_source", "lazy_recipients", 0, Some("CREATE TRIGGER lazy_recipient_source BEFORE INSERT ON lazy_recipients\nBEGIN\n    SELECT RAISE(ABORT, 'lazy recipient source mismatch') WHERE NEW.state<>'pending' OR NOT EXISTS (\n        SELECT 1 FROM send_preparations p JOIN seats s ON s.id=NEW.seat_id AND s.instance_id=p.instance_id\n        WHERE p.id=NEW.preparation_id AND p.thread_id=NEW.thread_id AND p.delivery_mode='lazy' AND p.status='building'\n    ) OR EXISTS(SELECT 1 FROM send_manifests WHERE preparation_id=NEW.preparation_id);\nEND")), ("trigger", "manifests_instance_source", "send_manifests", 0, Some("CREATE TRIGGER manifests_instance_source BEFORE INSERT ON send_manifests\nBEGIN\n    SELECT CASE WHEN NOT EXISTS (\n        SELECT 1 FROM send_preparations sp JOIN threads t ON t.id=NEW.thread_id\n        JOIN messages m ON m.id=NEW.message_id\n        WHERE sp.id=NEW.preparation_id AND sp.instance_id=NEW.instance_id\n          AND t.instance_id=NEW.instance_id AND m.instance_id=NEW.instance_id\n          AND m.thread_id=NEW.thread_id AND m.decision_seq=NEW.decision_seq\n          AND m.event_offset=0 AND m.kind='ordinary'\n    ) THEN RAISE(ABORT, 'manifest instance or source mismatch') END;\nEND")), ("trigger", "memberships_ordinal_immutable", "memberships", 0, Some("CREATE TRIGGER memberships_ordinal_immutable BEFORE UPDATE OF ordinal ON memberships\nBEGIN SELECT RAIS