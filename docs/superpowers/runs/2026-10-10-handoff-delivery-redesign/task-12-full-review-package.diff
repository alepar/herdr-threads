+    caller: &SeatId,
+    recipient: &SeatId,
+    installation_default_ms: Option<u64>,
+) -> Result<ThreadId, ApiError> {
+    if caller == recipient {
+        return Err(api_error(
+            ErrorCode::InvalidRequest,
+            "direct recipient must differ from caller",
+        ));
+    }
