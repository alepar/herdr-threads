+                                 "--owner-pid", str(owner.pid)], stdout=subprocess.DEVNULL)
+        self.addCleanup(lambda: (proc.poll() is None and proc.kill(), proc.wait(10)))
+        port_file = os.path.join(self.ctl, "port")
+        deadline = time.time() + 15
