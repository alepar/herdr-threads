+        assert!(crate::harness::launch::bootstrap_target(registry, kind).is_some());
+    }
+    for kind in ["human", "Claude", "nope", ""] {
+        assert!(
+            crate::harness::launch::bootstrap_target(registry, kind).is_none(),
+            "{kind}"
+        );
+    }
