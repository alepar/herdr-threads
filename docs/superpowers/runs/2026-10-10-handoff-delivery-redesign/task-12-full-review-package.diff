+        attempt: BootstrapAttempt::first(),
+        administrative_revision: 0,
+    };
+    assert!(matches!(
+        f.call(Command::AutomaticBootstrap(Box::new(request.clone())))
+            .unwrap(),
+        CommandResult::BootstrapSubmissionChecked(_)
+    ));
