@@ -0,0 +1,311 @@
+//! DP8 `wake_on` storage: the migration columns, the accountable set, the
+//! idempotent replay and the refusals.
+use crate::protocol::{
+    authority::{CallerClaim, CallerRole, Harness, MutationPermit, ObligationRef},
+    commands::{SetWakeOn, WakeOn},
+    ids::*,
+    results::{CommandResult, ErrorCode, WakeOnState},
+    time::{CallBudget, Clock, MonoInstant, UtcMillis},
+};
+use crate::store::{connection::StoreContext, control, schema, seats};
+use rusqlite::{Connection, params};
+use std::sync::Arc;
+
+struct TestClock;
+impl Clock for TestClock {
+    fn utc_now(&self) -> UtcMillis {
+        UtcMillis(1000)
+    }
+    fn monotonic_now(&self) -> MonoInstant {
+        MonoInstant(100)
+    }
+}
+
+fn setup() -> (StoreContext, Connection) {
+    let path = std::env::temp_dir().join(format!("wake-on-test-{}.db", uuid::Uuid::new_v4()));
+    let context = StoreContext::new(path, Arc::new(TestClock));
+    let conn = context.open_writer().unwrap();
+    conn.execute(
+        "INSERT INTO host_instances(id,created_at,host_boot,host_epoch,decision_seq) VALUES ('i',0,'b',1,1)",
+        [],
+    )
+    .unwrap();
+    conn.execute("INSERT INTO seats(id,instance_id,state,role,target_id,generation,target_generation,created_at,unavailability_episode) VALUES ('s','i','resolved','native','ps',1,1,0,1)", []).unwrap();
+    conn.execute("INSERT INTO observed_targets(instance_id,target_id,host_boot,epoch,generation,observed_at,provenance,terminal_id,incarnation,incarnation_source_kind,connection_epoch) VALUES ('i','ps','b',1,1,0,'fresh','term-ps','inc','coherent_enumeration',1)", []).unwrap();
+    conn.execute("INSERT INTO occupant_bindings(seat_id,generation,target_id,host_boot,host_epoch,target_generation,harness,native_session,execution_id,observation_provenance,observed_at,terminal_id,incarnation) VALUES ('s',1,'ps','b',1,1,'claude','ns','00000000-0000-4000-8000-0000000000aa','cooperative_top_level',0,'term-ps','inc')", []).unwrap();
+    (context, conn)
+}
+
+fn claim(role: CallerRole, generation: u64) -> CallerClaim {
+    CallerClaim {
+        instance: "i".into(),
+        seat: SeatId::new("s"),
+        binding_generation: generation,
+        role,
+        harness: Harness::Claude,
+        native_session: NativeSessionId::new("ns"),
+        execution: ExecutionId::new("00000000-0000-4000-8000-0000000000aa"),
+        target: HostTargetId::new("ps"),
+    }
+}
+fn command(value: WakeOn, operation: &str) -> SetWakeOn {
+    SetWakeOn {
+        value,
+        operation: OperationId::new(operation),
+        claim: claim(CallerRole::TopLevel, 1),
+    }
+}
+fn budget() -> CallBudget {
+    CallBudget {
+        deadline: MonoInstant(u64::MAX),
+        cancellation: Default::default(),
+    }
+}
+fn set(
+    context: &StoreContext,
+    conn: &mut Connection,
+    command: &SetWakeOn,
+) -> Result<WakeOnState, crate::protocol::results::ApiError> {
+    let digest = control::cooperative_payload_hash("set_wake_on", command).unwrap();
+    let permit = MutationPermit::cooperative(
+        command.claim.clone(),
+        command.operation.clone(),
+        ObligationRef::CheckIn(command.claim.seat.clone()),
+        digest,
+        MonoInstant(50),
+        (1, 0),
+        budget(),
+    );
+    match seats::set_wake_on(context, conn, &budget(), command, permit)? {
+        CommandResult::WakeOn(state) => Ok(state),
+        other => panic!("unexpected result {other:?}"),
+    }
+}
+fn seat() -> SeatId {
+    SeatId::new("s")
+}
+/// `(reason_bits, attention_version)` of the seat's wake_work row, if any.
+fn wake_work(conn: &Connection) -> Option<(i64, i64)> {
+    conn.query_row(
+        "SELECT reason_bits,attention_version FROM wake_work WHERE seat_id='s'",
+        [],
+        |r| Ok((r.get(0)?, r.get(1)?)),
+    )
+    .ok()
+}
+
+#[test]
+fn fresh_seat_reads_nudge_and_unknown_seat_is_not_found() {
+    let (_, conn) = setup();
+    assert_eq!(seats::wake_on(&conn, &seat()).unwrap(), WakeOn::Nudge);
+    assert_eq!(
+        seats::wake_on(&conn, &SeatId::new("nobody"))
+            .unwrap_err()
+            .code,
+        ErrorCode::NotFound
+    );
+}
+
+#[test]
+fn set_all_changes_reads_all_and_notes_new_attention() {
+    let (context, mut conn) = setup();
+    assert_eq!(wake_work(&conn), None);
+    let state = set(&context, &mut conn, &command(WakeOn::All, "op1")).unwrap();
+    assert_eq!(
+        state,
+        WakeOnState {
+            seat: seat(),
+            wake_on: WakeOn::All,
+            changed: true
+        }
+    );
+    assert_eq!(seats::wake_on(&conn, &seat()).unwrap(), WakeOn::All);
+    assert_eq!(wake_work(&conn), Some((1, 1)), "reason bit 1, version 1");
+}
+
+#[test]
+fn setting_the_stored_value_again_is_unchanged_and_does_not_bump() {
+    let (context, mut conn) = setup();
+    set(&context, &mut conn, &command(WakeOn::All, "op1")).unwrap();
+    let again = set(&context, &mut conn, &command(WakeOn::All, "op2")).unwrap();
+    assert!(!again.changed);
+    assert_eq!(again.wake_on, WakeOn::All);
+    assert_eq!(wake_work(&conn), Some((1, 1)), "no second bump");
+    // Back to nudge is a change and re-judges again.
+    let back = set(&context, &mut conn, &command(WakeOn::Nudge, "op3")).unwrap();
+    assert!(back.changed);
+    assert_eq!(wake_work(&conn), Some((1, 2)));
+}
+
+#[test]
+fn setting_nudge_on_a_fresh_seat_is_unchanged() {
+    let (context, mut conn) = setup();
+    let state = set(&context, &mut conn, &command(WakeOn::Nudge, "op1")).unwrap();
+    assert!(!state.changed);
+    assert_eq!(wake_work(&conn), None);
+}
+
+#[test]
+fn replay_of_the_same_operation_returns_the_recorded_result() {
+    let (context, mut conn) = setup();
+    let first = set(&context, &mut conn, &command(WakeOn::All, "op1")).unwrap();
+    assert!(first.changed);
+    let replay = set(&context, &mut conn, &command(WakeOn::All, "op1")).unwrap();
+    assert_eq!(replay, first, "recorded result, still changed: true");
+    assert_eq!(wake_work(&conn), Some((1, 1)));
+    // The same key with a different value is a digest conflict, not a write.
+    assert!(set(&context, &mut conn, &command(WakeOn::Nudge, "op1")).is_err());
+    assert_eq!(seats::wake_on(&conn, &seat()).unwrap(), WakeOn::All);
+}
+
+#[test]
+fn declared_subagent_is_refused() {
+    let (context, mut conn) = setup();
+    let mut subagent = command(WakeOn::All, "op1");
+    subagent.claim = claim(CallerRole::Subagent, 1);
+    let error = set(&context, &mut conn, &subagent).unwrap_err();
+    assert_eq!(error.code, ErrorCode::InvalidRequest);
+    assert_eq!(seats::wake_on(&conn, &seat()).unwrap(), WakeOn::Nudge);
+}
+
+#[test]
+fn claim_whose_binding_is_not_current_is_refused() {
+    let (context, mut conn) = setup();
+    let mut stale = command(WakeOn::All, "op1");
+    stale.claim = claim(CallerRole::TopLevel, 7);
+    assert!(set(&context, &mut conn, &stale).is_err());
+    assert_eq!(seats::wake_on(&conn, &seat()).unwrap(), WakeOn::Nudge);
+    assert_eq!(wake_work(&conn), None);
+}
+
+#[test]
+fn value_survives_a_binding_rotation() {
+    let (context, mut conn) = setup();
+    set(&context, &mut conn, &command(WakeOn::All, "op1")).unwrap();
+    conn.execute(
+        "UPDATE occupant_bindings SET ended_at=1 WHERE seat_id='s' AND generation=1",
+        [],
+    )
+    .unwrap();
+    conn.execute("INSERT INTO occupant_bindings(seat_id,generation,target_id,host_boot,host_epoch,target_generation,harness,native_session,execution_id,observation_provenance,observed_at,terminal_id,incarnation) VALUES ('s',2,'ps','b',1,1,'claude','ns2','00000000-0000-4000-8000-0000000000bb','cooperative_top_level',0,'term-ps','inc')", []).unwrap();
+    conn.execute("UPDATE seats SET generation=2 WHERE id='s'", [])
+        .unwrap();
+    assert_eq!(seats::wake_on(&conn, &seat()).unwrap(), WakeOn::All);
+}
+
+#[test]
+fn raw_update_to_an_unknown_value_fails_the_check() {
+    let (_, conn) = setup();
+    let error = conn
+        .execute("UPDATE seats SET wake_on='bogus' WHERE id='s'", [])
+        .unwrap_err();
+    assert!(error.to_string().contains("CHECK"), "{error}");
+}
+
+#[test]
+fn lazy_ordinal_rejects_zero_and_accepts_null_or_positive() {
+    let (_, conn) = setup();
+    conn.execute(
+        "INSERT INTO wake_work(seat_id,reason_bits,attention_version) VALUES ('s',1,1)",
+        [],
+    )
+    .unwrap();
+    let last_lazy = |conn: &Connection| -> Option<i64> {
+        conn.query_row(
+            "SELECT last_lazy_ordinal FROM wake_work WHERE seat_id='s'",
+            [],
+            |r| r.get(0),
+        )
+        .unwrap()
+    };
+    assert_eq!(last_lazy(&conn), None, "default NULL");
+    assert!(
+        conn.execute(
+            "UPDATE wake_work SET last_lazy_ordinal=0 WHERE seat_id='s'",
+            []
+        )
+        .is_err()
+    );
+    conn.execute(
+        "UPDATE wake_work SET last_lazy_ordinal=5 WHERE seat_id='s'",
+        [],
+    )
+    .unwrap();
+    assert_eq!(last_lazy(&conn), Some(5));
+}
+
+/// A database left at the previous schema version (30), then migrated. The
+/// previous shape is the current one without the two added columns.
+#[test]
+fn migration_up_adds_the_columns_with_their_defaults() {
+    let (_, previous) = setup();
+    previous
+        .execute("INSERT INTO seats(id,instance_id,state,role,target_id,generation,target_generation,created_at,unavailability_episode) VALUES ('old','i','resolved','native','po',1,1,0,1)", [])
+        .unwrap();
+    previous
+        .execute(
+            "INSERT INTO wake_work(seat_id,reason_bits,attention_version) VALUES ('old',1,1)",
+            [],
+        )
+        .unwrap();
+    previous
+        .execute_batch(
+            "ALTER TABLE seats DROP COLUMN wake_on; ALTER TABLE wake_work DROP COLUMN last_lazy_ordinal; PRAGMA user_version=30;",
+        )
+        .unwrap();
+    let has_column = |table: &str, column: &str| -> bool {
+        previous
+            .query_row(
+                &format!("SELECT count(*) FROM pragma_table_info('{table}') WHERE name=?1"),
+                [column],
+                |r| r.get::<_, i64>(0),
+            )
+            .unwrap()
+            == 1
+    };
+    assert!(!has_column("seats", "wake_on") && !has_column("wake_work", "last_lazy_ordinal"));
+    schema::initialize(&previous, || UtcMillis(0)).unwrap();
+    assert_eq!(
+        previous
+            .pragma_query_value(None, "user_version", |r| r.get::<_, i64>(0))
+            .unwrap(),
+        schema::LATEST_VERSION
+    );
+    assert!(has_column("seats", "wake_on") && has_column("wake_work", "last_lazy_ordinal"));
+    let wake_on: String = previous
+        .query_row("SELECT wake_on FROM seats WHERE id='old'", [], |r| r.get(0))
+        .unwrap();
+    assert_eq!(wake_on, "nudge");
+    let lazy: Option<i64> = previous
+        .query_row(
+            "SELECT last_lazy_ordinal FROM wake_work WHERE seat_id='old'",
+            [],
+            |r| r.get(0),
+        )
+        .unwrap();
+    assert_eq!(lazy, None);
+    assert!(
+        previous
+            .execute(
+                "UPDATE wake_work SET last_lazy_ordinal=0 WHERE seat_id='old'",
+                params![]
+            )
+            .is_err()
+    );
+    assert!(
+        previous
+            .execute("UPDATE seats SET wake_on='bogus' WHERE id='old'", [])
+            .is_err()
+    );
+}
+
+#[test]
+fn a_database_missing_a_wake_on_column_is_incompatible() {
+    let (_, conn) = setup();
+    conn.execute_batch("ALTER TABLE seats DROP COLUMN wake_on")
+        .unwrap();
+    assert_eq!(
+        schema::initialize(&conn, || UtcMillis(0)).unwrap_err().code,
+        ErrorCode::IncompatibleSchema
+    );
+}
diff --git a/tests/store/wake_on_wake.rs b/tests/store/wake_on_wake.rs
new file mode 100644
index 00000000..4097a225
--- /dev/null
+++ b/tests/store/wake_on_wake.rs
@@ -0,0 +1,354 @@
+//! DP8 core wake decision: a `wake_on: all` seat is woken by a pending lazy
+//! row, once per lazy frontier; a `nudge` seat never is, and no poke exists.
+use super::*;
+use crate::protocol::time::{Cancellation, MonoInstant};
+use std::sync::Arc;
+
+struct LazyWakeClock;
+const DAEMON_BOOT: &str = "00000000-0000-0000-0000-000000000001";
+impl Clock for LazyWakeClock {
+    fn utc_now(&self) -> UtcMillis {
+        UtcMillis(100)
+    }
+    fn monotonic_now(&self) -> MonoInstant {
+        MonoInstant(1_000)
+    }
+}
+fn budget() -> CallBudget {
+    CallBudget {
+        deadline: MonoInstant(10_000),
+        cancellation: Cancellation::default(),
+    }
+}
+
+/// An idle, registered seat `s` with a lazy-capable thread `t`, and no
+/// ordinary attention at all, so a lazy row is the only possible wake reason.
+fn lazy_store(wake_on: &str, batch_delay_ms: u64) -> (SqliteStore, std::path::PathBuf) {
+    let path = std::env::temp_dir().join(format!("herdr-wake-on-{}.db", uuid::Uuid::new_v4()));
+    let context = StoreContext::new(path.clone(), Arc::new(LazyWakeClock));
+    let db = context.open_writer().unwrap();
+    db.execute_batch(
+        "INSERT INTO host_instances(id,created_at,host_boot,host_epoch,decision_seq) VALUES ('i',0,'host',1,1);\
+         INSERT INTO seats(id,instance_id,state,role,target_id,generation,target_generation,created_at) VALUES ('s','i','resolved','native','pane',1,1,0);\
+         INSERT INTO observed_targets(instance_id,target_id,host_boot,epoch,generation,observed_at,provenance,terminal_id,incarnation,incarnation_source_kind,connection_epoch) VALUES ('i','pane','host',1,1,0,'fresh','term-pane','inc','coherent_enumeration',1);\
+         UPDATE observed_targets SET occupancy='occupied',ui_state='idle',verified_execution='exec',top_level_occupant=1 WHERE instance_id='i' AND target_id='pane';\
+         INSERT INTO occupant_bindings(seat_id,generation,target_generation,target_id,host_boot,host_epoch,harness,native_session,execution_id,observation_provenance,observed_at,registered_at,terminal_id,incarnation) VALUES ('s',1,1,'pane','host',1,'codex','session','exec','fresh',0,0,'term-pane','inc');\
+         INSERT INTO threads(id,instance_id,topic,goal,created_at,updated_at) VALUES ('t','i','topic','goal',0,0);\
+         INSERT INTO memberships(thread_id,seat_id,state) VALUES ('t','s','joined');\
+         INSERT INTO membership_intervals(thread_id,seat_id,episode,joined_seq) VALUES ('t','s',1,1);",
+    )
+    .unwrap();
+    db.execute("UPDATE seats SET wake_on=?1 WHERE id='s'", [wake_on])
+        .unwrap();
+    drop(db);
+    let store = SqliteStore::new(
+        context,
+        "i",
+        StoreSettings {
+            daemon_boot: Some(uuid::Uuid::parse_str(DAEMON_BOOT).unwrap()),
+            wake_batch_delay_ms: batch_delay_ms,
+            ..StoreSettings::default()
+        },
+    )
+    .unwrap();
+    (store, path)
+}
+
+/// Publish lazy row `n` (message `msg-n`, recipient ordinal in insertion
+/// order) to seat `s`, published at `decision_at`.
+fn publish_lazy(store: &SqliteStore, n: i64, decision_at: i64) {
+    stage_lazy(store, n);
+    publish_staged(store, n, n, decision_at);
+}
+
+/// Stage lazy row `n` for seat `s` (preparation and recipient row; the
+/// recipient ordinal follows staging order). Not yet published.
+fn stage_lazy(store: &SqliteStore, n: i64) {
+    let db = store.context.open_writer().unwrap();
+    db.execute(
+        "INSERT INTO send_preparations(id,instance_id,operation_scope,operation_key,digest,thread_id,captured_membership_revision,captured_lifecycle_revision,captured_eligibility_revision,captured_timeline_revision,captured_config_revision,interval_high_water,recipient_high_water,status,delivery_mode) VALUES(?1,'i','scope',?1,zeroblob(32),'t',0,0,0,0,0,0,0,'building','lazy')",
+        [format!("prep-{n}")],
+    )
+    .unwrap();
+    db.execute(
+        "INSERT INTO lazy_recipients(preparation_id,message_id,thread_id,seat_id) VALUES(?1,?2,'t','s')",
+        [format!("prep-{n}"), format!("msg-{n}")],
+    )
+    .unwrap();
+}
+
+/// Publish the staged row `n` in the decision `decision_seq` at `decision_at`
+/// (message and manifest).
+fn publish_staged(store: &SqliteStore, n: i64, decision_seq: i64, decision_at: i64) {
+    let db = store.context.open_writer().unwrap();
+    db.execute(
+        "INSERT INTO messages(id,instance_id,thread_id,sequence,kind,decision_seq,body,decision_at,delivery_mode) VALUES(?1,'i','t',?2,'ordinary',?3,'passive',?4,'lazy')",
+        params![format!("msg-{n}"), n, decision_seq, decision_at],
+    )
+    .unwrap();
+    db.execute(
+        "INSERT INTO send_manifests(preparation_id,message_id,instance_id,thread_id,decision_seq,decision_at,base_sequence,interval_high_water,recipient_count,warning_count) VALUES(?1,?2,'i','t',?4,?3,?4,0,1,0)",
+        params![format!("prep-{n}"), format!("msg-{n}"), decision_at, decision_seq],
+    )
+    .unwrap();
+}
+
+fn candidates(store: &SqliteStore) -> Vec<WakeCandidate> {
+    StorePort::wake_candidates(store, PageRequest::default(), &budget())
+        .unwrap()
+        .items
+}
+
+/// The candidate of seat `s` read directly, whether or not it is actionable.
+fn direct_candidate(store: &SqliteStore) -> WakeCandidate {
+    let db = store.context.open_writer().unwrap();
+    let scan = attention::wake_seat_attention(&db, "s").unwrap();
+    wake::load_candidate(
+        &db,
+        "i",
+        &SeatId::new("s"),
+        &scan.attention,
+        scan.decision_seq,
+    )
+    .unwrap()
+}
+
+fn reserve(store: &SqliteStore, candidate: &WakeCandidate) -> Option<WakeReservation> {
+    StorePort::reserve_wake(store, candidate, &budget()).unwrap()
+}
+
+fn last_lazy_ordinal(store: &SqliteStore) -> Option<i64> {
+    store
+        .context
+        .open_writer()
+        .unwrap()
+        .query_row(
+            "SELECT last_lazy_ordinal FROM wake_work WHERE seat_id='s'",
+            [],
+            |r| r.get(0),
+        )
+        .optional()
+        .unwrap()
+        .flatten()
+}
+
+fn settle(store: &SqliteStore, reservation: &WakeReservation) {
+    StorePort::complete_wake(
+        store,
+        reservation.attempt.clone(),
+        WakeOutcome::Submitted,
+        None,
+        &budget(),
+    )
+    .unwrap();
+}
+
+#[test]
+fn idle_all_seat_with_only_a_lazy_row_is_reserved_with_the_lazy_reason() {
+    let (store, path) = lazy_store("all", 0);
+    publish_lazy(&store, 1, 50);
+    let found = candidates(&store);
+    assert_eq!(found.len(), 1, "a lazy-only all seat is discovered");
+    assert!(!found[0].has_pending_receipt && !found[0].has_pending_invitation);
+    assert!(found[0].has_actionable_work());
+    let reservation = reserve(&store, &found[0]).expect("reserved");
+    assert_eq!(reservation.reasons, vec!["lazy".to_string()]);
+    assert_eq!(last_lazy_ordinal(&store), Some(1));
+    assert!(StorePort::validate_wake_reservation(&store, &reservation, &budget()).unwrap());
+    drop(store);
+    let _ = std::fs::remove_file(path);
+}
+
+#[test]
+fn same_lazy_frontier_is_not_reserved_again_but_a_new_row_is() {
+    let (store, path) = lazy_store("all", 0);
+    publish_lazy(&store, 1, 50);
+    let first = candidates(&store).remove(0);
+    let reservation = reserve(&store, &first).expect("first reservation");
+    settle(&store, &reservation);
+    // Same frontier: the row is still pending, but the seat was woken for it.
+    let same = direct_candidate(&store);
+    assert_eq!(same.pending_lazy(), Some(1), "the row is still pending");
+    assert!(!same.has_actionable_work());
+    assert!(candidates(&store).is_empty());
+    assert!(reserve(&store, &same).is_none());
+    // A higher ordinal advances the frontier and is reserved again.
+    publish_lazy(&store, 2, 60);
+    let next = candidates(&store).remove(0);
+    assert_eq!(next.pending_lazy(), Some(2));
+    assert!(
+        next.attention_witness
+            .as_ref()
+            .unwrap()
+            .frontier()
+            .advanced_beyond(&next.last_reserved_frontier)
+    );
+    let again = reserve(&store, &next).expect("new lazy row reserves again");
+    assert_eq!(again.reasons, vec!["lazy".to_string()]);
+    assert_eq!(last_lazy_ordinal(&store), Some(2));
+    drop(store);
+    let _ = std::fs::remove_file(path);
+}
+
+#[test]
+fn a_row_staged_earlier_but_published_later_wakes_the_seat_again() {
+    let (store, path) = lazy_store("all", 0);
+    // A stages row 5 (ordinal 1), B stages row 6 (ordinal 2) and publishes first.
+    stage_lazy(&store, 5);
+    stage_lazy(&store, 6);
+    publish_staged(&store, 6, 10, 50);
+    let first = candidates(&store).remove(0);
+    let reservation = reserve(&store, &first).expect("first reservation");
+    assert_eq!(reservation.reasons, vec!["lazy".to_string()]);
+    settle(&store, &reservation);
+    assert!(!direct_candidate(&store).has_actionable_work());
+    // A publishes later: a larger publication sequence, a smaller ordinal.
+    publish_staged(&store, 5, 11, 60);
+    let found = candidates(&store);
+    assert_eq!(found.len(), 1, "the late-published row is discovered");
+    assert!(found[0].has_unreserved_lazy());
+    let again = reserve(&store, &found[0]).expect("late row reserves again");
+    assert_eq!(again.reasons, vec!["lazy".to_string()]);
+    assert_eq!(last_lazy_ordinal(&store), Some(11));
+    drop(store);
+    let _ = std::fs::remove_file(path);
+}
+
+#[test]
+fn nudge_seat_is_never_woken_by_a_lazy_row_and_no_poke_exists() {
+    let (store, path) = lazy_store("nudge", 0);
+    publish_lazy(&store, 1, 50);
+    assert!(candidates(&store).is_empty());
+    let direct = direct_candidate(&store);
+    assert_eq!(direct.pending_lazy(), None);
+    assert!(!direct.has_actionable_work());
+    assert!(reserve(&store, &direct).is_none());
+    assert_eq!(last_lazy_ordinal(&store), None);
+    drop(store);
+    let _ = std::fs::remove_file(path);
+
+    // The all seat's wake creates no receipt and no poke either.
+    let (store, path) = lazy_store("all", 0);
+    publish_lazy(&store, 1, 50);
+    reserve(&store, &candidates(&store).remove(0)).expect("reserved");
+    let db = store.context.open_writer().unwrap();
+    for table in ["receipts", "receipt_state"] {
+        let rows: i64 = db
+            .query_row(&format!("SELECT count(*) FROM {table}"), [], |r| r.get(0))
+            .unwrap();
+        assert_eq!(rows, 0, "{table} gains no row from a lazy wake");
+    }
+    drop(db);
+    assert!(
+        StorePort::poke_candidates(&store, 16, &budget())
+            .unwrap()
+            .is_empty(),
+        "lazy rows have no deadline, so no poke is due"
+    );
+    drop(store);
+    let _ = std::fs::remove_file(path);
+}
+
+#[test]
+fn refused_wake_restores_the_lazy_frontier_so_the_row_wakes_again() {
+    let (store, path) = lazy_store("all", 0);
+    publish_lazy(&store, 1, 50);
+    let candidate = candidates(&store).remove(0);
+    let prior = crate::ports::PriorLadder::from_candidate(&candidate);
+    let reservation = reserve(&store, &candidate).expect("reserved");
+    assert_eq!(last_lazy_ordinal(&store), Some(1));
+    StorePort::complete_wake(
+        &store,
+        reservation.attempt.clone(),
+        WakeOutcome::Refused(crate::ports::RefusalCause::Unsafe),
+        Some(&prior),
+        &budget(),
+    )
+    .unwrap();
+    assert_eq!(last_lazy_ordinal(&store), None, "nothing was sent");
+    assert_eq!(candidates(&store).len(), 1);
+    drop(store);
+    let _ = std::fs::remove_file(path);
+}
+
+#[test]
+fn witness_recheck_rejects_a_reservation_whose_lazy_frontier_moved() {
+    let (store, path) = lazy_store("all", 0);
+    publish_lazy(&store, 1, 50);
+    let stale = candidates(&store).remove(0);
+    // A second row publishes without any decision-sequence bump, so only the
+    // lazy re-check can see that the witness no longer matches.
+    publish_lazy(&store, 2, 60);
+    assert!(reserve(&store, &stale).is_none());
+    assert_eq!(last_lazy_ordinal(&store), None);
+    // Likewise a `wake_on` change after discovery.
+    let fresh = candidates(&store).remove(0);
+    store
+        .context
+        .open_writer()
+        .unwrap()
+        .execute("UPDATE seats SET wake_on='nudge' WHERE id='s'", [])
+        .unwrap();
+    assert!(reserve(&store, &fresh).is_none());
+    store
+        .context
+        .open_writer()
+        .unwrap()
+        .execute("UPDATE seats SET wake_on='all' WHERE id='s'", [])
+        .unwrap();
+    let current = candidates(&store).remove(0);
+    assert!(reserve(&store, &current).is_some());
+    drop(store);
+    let _ = std::fs::remove_file(path);
+}
+
+#[test]
+fn batch_window_anchors_on_the_oldest_pending_lazy_row() {
+    let (store, path) = lazy_store("all", 30_000);
+    publish_lazy(&store, 1, 50);
+    publish_lazy(&store, 2, 90);
+    let candidate = candidates(&store).remove(0);
+    assert_eq!(
+        StorePort::wake_batch_window(&store, &candidate, &budget()).unwrap(),
+        Some((UtcMillis(30_050), 30_000)),
+        "the oldest lazy row opens the window like an ordinary receipt"
+    );
+    // A later pass keeps the retained deadline instead of sliding it.
+    publish_lazy(&store, 3, 95);
+    assert_eq!(
+        StorePort::wake_batch_window(&store, &candidate, &budget()).unwrap(),
+        Some((UtcMillis(30_050), 30_000))
+    );
+    drop(store);
+    let _ = std::fs::remove_file(path);
+}
+
+#[test]
+fn lazy_publication_sets_the_reason_bit_only_for_all_recipients() {
+    let (store, path) = lazy_store("all", 0);
+    let mut db = store.context.open_writer().unwrap();
+    db.execute_batch(
+        "INSERT INTO seats(id,instance_id,state,role,generation,created_at) VALUES('n','i','unresolved','native',1,0);\
+         INSERT INTO send_preparations(id,instance_id,operation_scope,operation_key,digest,thread_id,captured_membership_revision,captured_lifecycle_revision,captured_eligibility_revision,captured_timeline_revision,captured_config_revision,interval_high_water,recipient_high_water,status,delivery_mode) VALUES('prep-1','i','scope','prep-1',zeroblob(32),'t',0,0,0,0,0,0,0,'building','lazy');\
+         INSERT INTO lazy_recipients(preparation_id,message_id,thread_id,seat_id) VALUES('prep-1','msg-1','t','s');\
+         INSERT INTO lazy_recipients(preparation_id,message_id,thread_id,seat_id) VALUES('prep-1','msg-1','t','n');",
+    )
+    .unwrap();
+    let tx = db.transaction().unwrap();
+    lazy_delivery::note_published(&tx, "prep-1").unwrap();
+    tx.commit().unwrap();
+    let bits = |seat: &str| -> Option<(i64, i64)> {
+        db.query_row(
+            "SELECT reason_bits,attention_version FROM wake_work WHERE seat_id=?1",
+            [seat],
+            |r| Ok((r.get(0)?, r.get(1)?)),
+        )
+        .optional()
+        .unwrap()
+    };
+    assert_eq!(bits("s"), Some((1, 1)), "the all recipient is re-judged");
+    assert_eq!(bits("n"), None, "a nudge recipient is untouched");
+    drop(db);
+    drop(store);
+    let _ = std::fs::remove_file(path);
+}
