+        self.assertIn("FAILED — 1 violations", p.stdout.splitlines()[-1])
+
+    def test_sql_literal_two_violations(self):
+        p = self.flagged("let q = \"harness IN ('claude','codex')\";\n")
+        self.assertViolations(p, 2)
+
+    def test_name_shapes_flagged(self):
