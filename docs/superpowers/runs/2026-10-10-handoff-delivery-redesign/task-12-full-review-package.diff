+            AutomaticBootstrapAction::Resolve { .. } => Ok(k.resolve.clone()),
+            AutomaticBootstrapAction::Attach(_) => Ok(k.attach.clone()),
+            AutomaticBootstrapAction::Complete { .. } => Ok(k.complete.clone()),
+            AutomaticBootstrapAction::Reserve { attempt } => {
