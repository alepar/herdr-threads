+    let rt = runtime(now_ms(), &ident("a"));
+    rig.pre(
+        1,
+        &Fake::with(vec![pulled(DeliveryPullReply::Unchanged {
+            attention_version: 12,
+        })]),
+        &rt,
+    );
+    assert!(
+        old.exists(),
+        "pruning runs only when a file is first created"
+    );
+}
