+        ).stdout.strip()
+
+    def write(self, rel, text, mode=None):
+        p = os.path.join(self.dir, rel)
+        os.makedirs(os.path.dirname(p), exist_ok=True)
+        with open(p, "w") as f:
+            f.write(text)
+        if mode:
+            os.chmod(p, mode)
+
+    def commit(self, message):
+        self.git("add", "-A")
