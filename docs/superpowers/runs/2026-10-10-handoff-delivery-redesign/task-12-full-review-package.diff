+++ b/scripts/agy-gate/flows/enroll.py
@@ -0,0 +1,59 @@
+"""``enroll``: setup, start agy, prompt (test-infra spec D7).
+
+The seat's binding is harness ``agy``, native session equal to the conversation id (the only
+``presence/*.lock``), provenance ``cooperative_top_level``. The first main request's
+``system_messages`` holds the startup check-in and its system instruction lists the
+``herdr-threads`` skill path.
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+GATE_DIR = Path(__file__).resolve().parent.parent
+for _dir in (GATE_DIR, GATE_DIR / "flows", GATE_DIR.parent / "agy-sandbox"):
+    if str(_dir) not in sys.path:
+        sys.path.insert(0, str(_dir))
+
+import _l5  # noqa: E402
+import observe  # noqa: E402
+from gate import Flow  # noqa: E402
+
+SCENARIO = GATE_DIR / "scenarios" / "enroll.json"
+
+
+def run(world):
+    scenario = _l5.load_scenario(SCENARIO)
+    world.backend.load(scenario)
+    setup = world.setup_agy()
+    world.check("setup agy succeeds", setup.returncode == 0, (setup.stderr or setup.stdout).strip()[:200])
+    pane = world.start_agy()
+    request, settled = _l5.run_turn(world, pane, "ENROLL-PROMPT hello", "enroll")
+    world.check("the scripted enroll step was served", request is not None)
+    world.check("agy returned to idle", settled)
+    binding = _l5.await_binding(world, lambda b: True)
+    world.check("exactly one live agy binding exists", binding is not None,
+                "bindings=%s" % _l5.live_bindings(world))
+    locks = _l5.presence_ids(world)
+    if binding is not None:
+        world.check("binding harness is agy", binding["harness"] == "agy", binding["harness"])
+        world.check("binding native session is the only presence lock",
+                    locks == [binding["native_session"]],
+                    "locks=%s native_session=%s" % (locks, binding["native_session"]))
+        world.check("binding provenance is cooperative_top_level",
+                    binding["observation_provenance"] == "cooperative_top_level",
+                    binding["observation_provenance"])
+    world.check("one seat exists", _l5.seat_count(world) == 1, "seats=%s" % _l5.seat_count(world))
+    mains = observe.main_requests(world)
+    first = mains[0] if mains else None
+    world.check("the first main request carries the startup check-in",
+                first is not None and _l5.has_startup(first),
+                "system_messages=%s" % (first or {}).get("system_messages"))
+    instruction = _l5.system_instruction_text(world, first) if first else ""
+    world.check("the system instruction lists the herdr-threads skill path",
+                _l5.SKILL_PATH in instruction, "instruction bytes=%d" % len(instruction))
+    pane.exit()
+    _l5.finish_checks(world, scenario)
+
+
+FLOW = Flow(name="enroll", requires=("ht-poh.4.2", "ht-poh.4.3", "ht-poh.4.4"), run=run)
diff --git a/scripts/agy-gate/flows/handoff.py b/scripts/agy-gate/flows/handoff.py
new file mode 100644
index 00000000..5495730d
--- /dev/null
+++ b/scripts/agy-gate/flows/handoff.py
@@ -0,0 +1,63 @@
+"""``handoff``: ``handoff --new-tab --kind agy`` from an enrolled agy seat (test-infra spec D7).
+
+The parent agy runs the handoff itself through ``run_command`` (the guarded bootstrap V2 path needs an
+original top-level agent). The handoff produces a plan and a new tab whose pane runs agy, and a second
+seat appears. The child agy's own requests are not scripted, so unmatched requests from it are
+expected and not a failure; the parent's requests must all have matched.
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+GATE_DIR = Path(__file__).resolve().parent.parent
+for _dir in (GATE_DIR, GATE_DIR / "flows", GATE_DIR.parent / "agy-sandbox"):
+    if str(_dir) not in sys.path:
+        sys.path.insert(0, str(_dir))
+
+import _l4  # noqa: E402
+import _l5  # noqa: E402
+import observe  # noqa: E402
+from gate import Flow  # noqa: E402
+
+SCENARIO = GATE_DIR / "scenarios" / "handoff.json"
+CHILD_TAB = "gate-child"
+
+
+def child_tab_present(world):
+    data = world.herdr_json("tab", "list", "--workspace", world.workspace, check=False)
+    return CHILD_TAB in str(data)
+
+
+def run(world):
+    scenario = _l4.load_into(world, SCENARIO, AGY=_l4.wrapper(world))
+    world.check("setup agy succeeds", world.setup_agy().returncode == 0)
+    pane = world.start_agy()
+    # The first turn enrolls the parent; the handoff turn then runs as an enrolled top-level seat.
+    pane.prompt("HANDOFF-PROMPT start the handoff")
+    call = _l5.await_step(world, "handoff-call", 30)
+    world.check("the handoff call was served", call is not None)
+    final = _l5.await_step(world, "handoff-final", 90)
+    world.check("the request after the handoff command was served", final is not None)
+    responses = (final or {}).get("function_responses") or []
+    world.check("that request carries a functionResponse for run_command",
+                any(r.get("name") == "run_command" for r in responses), "responses=%s" % responses)
+    world.artifact("handoff-response.txt", _l4.body_text(world, final))
+    world.check("a tab labeled %s was created" % CHILD_TAB,
+                bool(observe.wait_until(lambda: child_tab_present(world), 30)))
+    both = observe.wait_until(lambda: len(_l5.live_bindings(world)) >= 2, 60)
+    world.check("a second live agy seat exists", bool(both), "bindings=%s" % _l5.live_bindings(world))
+    world.check("the parent run still has a live binding with cooperative_top_level provenance",
+                any(b["observation_provenance"] == "cooperative_top_level" for b in _l5.live_bindings(world)),
+                "bindings=%s" % _l5.live_bindings(world))
+    world.check("an agy process runs for the child", world.agy_running())
+    pane.wait("idle", 30)
+    pane.exit()
+    # The child's unscripted requests may be unmatched; only the parent's steps must all be consumed.
+    used = {r.get("step") for r in observe.main_requests(world)}
+    missing = [s["label"] for s in scenario["steps"] if s["label"] not in used]
+    world.check("every scenario step was consumed", not missing, "unconsumed steps: %s" % missing)
+    world.artifact("requests.json", world.backend.requests())
+
+
+FLOW = Flow(name="handoff", requires=("ht-poh.4.6", "ht-poh.8"), run=run)
diff --git a/scripts/agy-gate/flows/launch.py b/scripts/agy-gate/flows/launch.py
new file mode 100644
index 00000000..b539d884
--- /dev/null
+++ b/scripts/agy-gate/flows/launch.py
@@ -0,0 +1,73 @@
+"""``launch``: ``herdr-threads launch --kind agy`` and its refusals (test-infra spec D7).
+
+A launch from a sender-style shell pane into a fresh pane starts agy, and the first prompt enrolls it
+(provenance ``cooperative_top_level``). Each refused argument vector (``--sandbox``, ``-p x``,
+``--dangerously-skip-permissions``) exits non-zero with the policy text and starts no agy process.
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+GATE_DIR = Path(__file__).resolve().parent.parent
+for _dir in (GATE_DIR, GATE_DIR / "flows", GATE_DIR.parent / "agy-sandbox"):
+    if str(_dir) not in sys.path:
+        sys.path.insert(0, str(_dir))
+
+import _l4  # noqa: E402
+import _l5  # noqa: E402
+from gate import Flow  # noqa: E402
+
+SCENARIO = GATE_DIR / "scenarios" / "launch.json"
+REFUSED = (["--sandbox"], ["-p", "x"], ["--dangerously-skip-permissions"])
+
+
+def launch_argv(pane, wrapper, native=()):
+    argv = ["launch", "--kind", "agy", "--pane", pane, "--harness-binary", wrapper]
+    return argv + (["--"] + list(native) if native else [])
+
+
+def run(world):
+    scenario = _l4.load_scenario(SCENARIO)
+    world.backend.load(scenario)
+    world.check("setup agy succeeds", world.setup_agy().returncode == 0)
+    sender = world.sender()
+    wrapper = _l4.wrapper(world)
+
+    for native in REFUSED:
+        pane = _l4.shell_pane(world, "refused-%s" % native[0].strip("-"))
+        result = sender.ht(launch_argv(pane, wrapper, native), check=False)
+        text = (result.stderr or "") + (result.stdout or "")
+        label = " ".join(native)
+        world.check("launch with %s exits non-zero" % label, result.returncode != 0, "rc=%s" % result.returncode)
+        world.check("launch with %s prints the policy text" % label, _l4.LAUNCH_REFUSAL in text, text.strip()[:200])
+        world.check("launch with %s starts no agy process" % label, not world.agy_running())
+
+    target = _l4.shell_pane(world, "launched")
+    # launch admits `--harness-binary` only when it is the `agy` the caller's PATH resolves to.
+    path = "%s:%s" % (Path(wrapper).parent, world.herdr_env().get("PATH", "/usr/bin:/bin"))
+    result = world.ht(launch_argv(target, wrapper), pane=sender.pane_id, check=False, env={"PATH": path})
+    world.check("launch --kind agy succeeds", result.returncode == 0, (result.stderr or result.stdout).strip()[:300])
+    pane = _l4.adopt_agy_pane(world, target)
+    world.check("the launched pane reaches idle", pane.wait("idle", 60), "status=%s" % pane.agent_status())
+    pages = pane.dismiss_onboarding()
+    if pages:
+        world.artifact("onboarding-pages.txt", ",".join(pages))
+    world.check("herdr detects the agent as agy", pane.agent_name() == "agy", "agent=%s" % pane.agent_name())
+    request, settled = _l5.run_turn(world, pane, "LAUNCH-PROMPT hello", "launch")
+    world.check("the scripted launch step was served", request is not None)
+    world.check("agy returned to idle", settled)
+    binding = _l5.await_binding(world, lambda b: b["observation_provenance"] == "cooperative_top_level")
+    world.check("the first prompt enrolls the launched seat", binding is not None,
+                "bindings=%s" % _l5.live_bindings(world))
+    if binding is not None:
+        locks = _l5.presence_ids(world)
+        world.check("binding native session is the presence lock", locks == [binding["native_session"]],
+                    "locks=%s native=%s" % (locks, binding["native_session"]))
+    world.check("the first request carries the startup check-in", request is not None and _l5.has_startup(request),
+                "system_messages=%s" % (request or {}).get("system_messages"))
+    pane.exit()
+    _l4.finish_checks(world, scenario)
+
+
+FLOW = Flow(name="launch", requires=("ht-poh.4.6",), run=run)
diff --git a/scripts/agy-gate/flows/permission.py b/scripts/agy-gate/flows/permission.py
new file mode 100644
index 00000000..ce8d8398
--- /dev/null
+++ b/scripts/agy-gate/flows/permission.py
@@ -0,0 +1,60 @@
+"""``permission``: the owned allow rule lets ``herdr-threads`` run unprompted, nothing wider (test-infra spec D7).
+
+The scenario calls ``run_command "herdr-threads --version"``: the agent never reaches ``blocked`` and
+the next request carries a ``functionResponse`` holding the version. Then it calls
+``"herdr-threads --version; touch gate-marker"``: the compound command is outside the rule, the agent goes
+``blocked``, and the gate denies it with keys (the screen is kept as an artifact).
+The second command ends in ``touch`` and not ``true``: genuine agy 1.3.2 runs ``; true`` unprompted.
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+GATE_DIR = Path(__file__).resolve().parent.parent
+for _dir in (GATE_DIR, GATE_DIR / "flows", GATE_DIR.parent / "agy-sandbox"):
+    if str(_dir) not in sys.path:
+        sys.path.insert(0, str(_dir))
+
+import _l4  # noqa: E402
+import _l5  # noqa: E402
+from gate import Flow  # noqa: E402
+
+SCENARIO = GATE_DIR / "scenarios" / "permission.json"
+DENY_KEYS = ("Escape",)
+
+
+def run(world):
+    scenario = _l4.load_into(world, SCENARIO)
+    world.check("setup agy succeeds", world.setup_agy().returncode == 0)
+    pane = world.start_agy()
+
+    pane.prompt("PERM-ALLOWED run the version command")
+    call = _l5.await_step(world, "allowed-call", 30)
+    world.check("the allowed command call was served", call is not None)
+    blocked = pane.wait("blocked", 5)
+    world.check("an allowed command never blocks the agent", not blocked, "screen=%s" % pane.read_pane(40)[-300:])
+    final = _l5.await_step(world, "allowed-final", 30)
+    world.check("the request after the allowed command was served", final is not None)
+    responses = (final or {}).get("function_responses") or []
+    world.check("that request carries a functionResponse for run_command",
+                any(r.get("name") == "run_command" for r in responses), "responses=%s" % responses)
+    version = _l4.version_token(world)
+    world.check("the functionResponse holds the herdr-threads version",
+                bool(version) and version in _l4.body_text(world, final), "version=%r" % version)
+    world.check("agy returned to idle", pane.wait("idle", 30))
+
+    pane.prompt("PERM-DENIED run the compound command")
+    call = _l5.await_step(world, "denied-call", 30)
+    world.check("the compound command call was served", call is not None)
+    world.check("the compound command blocks the agent", pane.wait("blocked", 30),
+                "status=%s" % pane.agent_status())
+    world.artifact("permission-blocked-screen.txt", pane.read_pane())
+    pane.keys(*DENY_KEYS)
+    world.check("the agent leaves blocked after the gate denies", pane.wait("idle", 30),
+                "status=%s" % pane.agent_status())
+    pane.exit()
+    _l4.finish_checks(world, scenario, optional=("denied-final",))
+
+
+FLOW = Flow(name="permission", requires=("ht-poh.4.4",), run=run)
diff --git a/scripts/agy-gate/flows/resume.py b/scripts/agy-gate/flows/resume.py
new file mode 100644
index 00000000..05a609b7
--- /dev/null
+++ b/scripts/agy-gate/flows/resume.py
@@ -0,0 +1,84 @@
+"""``resume``: A, exit, fresh B, exit, ``--conversation A``, exit, ``-c`` (test-infra spec D7).
+
+Everything runs in one pane so the seat is the same. After ``--conversation A``: same seat, binding
+native session A, no new seat. ``-c`` resumes the most recent conversation, which is A only because
+A was the most recent at that point: no rotation, generation unchanged. Neither resume start fires
+``SessionStart``, so no request carries a second SessionStart-injected startup check-in. The Resume
+lifecycle's own notice ("this conversation is the pane's top-level session") restates the startup
+text by design (PRE_INVOCATION_LIFECYCLE_PREFIX) and is not a SessionStart injection.
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+GATE_DIR = Path(__file__).resolve().parent.parent
+for _dir in (GATE_DIR, GATE_DIR / "flows", GATE_DIR.parent / "agy-sandbox"):
+    if str(_dir) not in sys.path:
+        sys.path.insert(0, str(_dir))
+
+import _l5  # noqa: E402
+import observe  # noqa: E402
+from gate import Flow  # noqa: E402
+
+SCENARIO = GATE_DIR / "scenarios" / "resume.json"
+SESSION_START_PREFIX = "The following system message was injected by a SessionStart hook"
+
+
+def run(world):
+    scenario = _l5.load_scenario(SCENARIO)
+    world.backend.load(scenario)
+    setup = world.setup_agy()
+    world.check("setup agy succeeds", setup.returncode == 0, (setup.stderr or setup.stdout).strip()[:200])
+
+    pane = world.start_agy()
+    first, _ = _l5.run_turn(world, pane, "ALPHA-ONE hello", "a1")
+    world.check("conversation A's first step was served", first is not None)
+    bind_a = _l5.await_binding(world, lambda b: True)
+    world.check("conversation A is enrolled", bind_a is not None, "bindings=%s" % _l5.live_bindings(world))
+    conv_a = bind_a["native_session"] if bind_a else None
+    pane.exit()
+
+    pane = world.start_agy(pane=pane.pane_id)
+    second, _ = _l5.run_turn(world, pane, "BRAVO-ONE hello", "b1")
+    world.check("conversation B's step was served", second is not None)
+    bind_b = _l5.await_binding(world, lambda b: b["native_session"] != conv_a)
+    world.check("the fresh conversation B is a different native session", bind_b is not None,
+                "A=%s binding=%s" % (conv_a, _l5.live_binding(world)))
+    pane.exit()
+    seat = bind_a["seat_id"] if bind_a else None
+    seats = _l5.seat_count(world)
+
+    pane = world.start_agy(args=["--conversation", conv_a or ""], pane=pane.pane_id)
+    third, _ = _l5.run_turn(world, pane, "ALPHA-TWO hello", "a2")
+    world.check("--conversation A's step was served", third is not None)
+    bind_a2 = _l5.await_binding(world, lambda b: b["native_session"] == conv_a)
+    world.check("--conversation A rebinds the same seat to native session A",
+                bind_a2 is not None and bind_a2["seat_id"] == seat,
+                "seat=%s A=%s binding=%s" % (seat, conv_a, _l5.live_binding(world)))
+    world.check("--conversation A creates no new seat", _l5.seat_count(world) == seats,
+                "before=%s after=%s" % (seats, _l5.seat_count(world)))
+    pane.exit()
+
+    pane = world.start_agy(args=["-c"], pane=pane.pane_id)
+    fourth, _ = _l5.run_turn(world, pane, "ALPHA-THREE hello", "a3")
+    world.check("-c's step was served", fourth is not None)
+    bind_c = _l5.live_binding(world)
+    world.check("-c resumes A without rotation: seat, generation and native session unchanged",
+                bind_a2 is not None and bind_c is not None
+                and (bind_c["seat_id"], bind_c["generation"], bind_c["native_session"])
+                == (bind_a2["seat_id"], bind_a2["generation"], conv_a),
+                "before=%s after=%s" % (bind_a2, bind_c))
+    world.check("-c creates no new seat", _l5.seat_count(world) == seats,
+                "before=%s after=%s" % (seats, _l5.seat_count(world)))
+    pane.exit()
+
+    mains = observe.main_requests(world)
+    doubled = [r.get("seq") for r in mains
+               if sum(1 for m in r.get("system_messages", [])
+                      if _l5.STARTUP_MARK in m and m.startswith(SESSION_START_PREFIX)) > 1]
+    world.check("no request carries a second startup check-in", not doubled, "requests=%s" % doubled)
+    _l5.finish_checks(world, scenario)
+
+
+FLOW = Flow(name="resume", requires=("ht-poh.4.3",), run=run)
diff --git a/scripts/agy-gate/flows/setup.py b/scripts/agy-gate/flows/setup.py
new file mode 100644
index 00000000..ff8a061e
--- /dev/null
+++ b/scripts/agy-gate/flows/setup.py
@@ -0,0 +1,69 @@
+"""``setup``: ``setup agy``, ``setup-status``, plugin disable and enable, re-setup (test-infra spec D7).
+
+Owned files exist; ``setup-status`` reports the plugin installed, current and enabled and the allow
+entry ``owned``. ``agy plugin disable herdr-threads`` turns ``enabled`` false and doctor reports
+``agy_plugin_disabled``; ``enable`` reverses it; a second ``setup agy`` changes nothing.
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+GATE_DIR = Path(__file__).resolve().parent.parent
+for _dir in (GATE_DIR, GATE_DIR / "flows", GATE_DIR.parent / "agy-sandbox"):
+    if str(_dir) not in sys.path:
+        sys.path.insert(0, str(_dir))
+
+import _l4  # noqa: E402
+from gate import Flow  # noqa: E402
+
+SCENARIO = GATE_DIR / "scenarios" / "setup.json"
+
+
+def doctor_text(world):
+    result = world.ht(["--json", "doctor"], check=False)
+    return (result.stdout or "") + (result.stderr or "")
+
+
+def run(world):
+    scenario = _l4.load_scenario(SCENARIO)
+    world.backend.load(scenario)
+    rc, data = _l4.setup_json(world)
+    world.check("setup agy succeeds", rc == 0, "rc=%s data=%s" % (rc, str(data)[:200]))
+    files = _l4.plugin_files(world)
+    world.check("the owned plugin files exist", sorted(files) == sorted(_l4.PLUGIN_FILES),
+                "found=%s" % sorted(files))
+    world.check("settings.json holds the allow rule", _l4.ALLOW_RULE in _l4.allow_members(world),
+                "allow=%s" % _l4.allow_members(world))
+    status = _l4.setup_status(world)
+    plugin = status.get("plugin", {})
+    world.check("setup-status: plugin installed", plugin.get("installed") is True, plugin)
+    world.check("setup-status: plugin current", plugin.get("current") is True, plugin)
+    world.check("setup-status: plugin enabled", plugin.get("enabled") is True, plugin)
+    world.check("setup-status: allow entry owned", _l4.allow_state(status) == "owned", status.get("allow_entry"))
+
+    disabled = _l4.agy_cli(world, "plugin", "disable", _l4.PLUGIN_NAME)
+    world.check("agy plugin disable succeeds", disabled.returncode == 0, disabled.stdout.strip()[:200])
+    status = _l4.setup_status(world)
+    world.check("setup-status: enabled is false after disable",
+                status.get("plugin", {}).get("enabled") is False, status.get("plugin"))
+    world.check("doctor reports agy_plugin_disabled", "agy_plugin_disabled" in doctor_text(world))
+
+    enabled = _l4.agy_cli(world, "plugin", "enable", _l4.PLUGIN_NAME)
+    world.check("agy plugin enable succeeds", enabled.returncode == 0, enabled.stdout.strip()[:200])
+    status = _l4.setup_status(world)
+    world.check("setup-status: enabled is true after enable",
+                status.get("plugin", {}).get("enabled") is True, status.get("plugin"))
+
+    before = _l4.plugin_files(world)
+    settings_before = _l4.read_settings(world)
+    rc, again = _l4.setup_json(world)
+    world.check("re-setup succeeds", rc == 0, "rc=%s" % rc)
+    world.check("re-setup reports already_installed", _l4.find(again, "action") == "already_installed",
+                "action=%s" % _l4.find(again, "action"))
+    world.check("re-setup leaves the plugin files unchanged", _l4.plugin_files(world) == before)
+    world.check("re-setup leaves settings.json unchanged", _l4.read_settings(world) == settings_before)
+    _l4.finish_checks(world, scenario)
+
+
+FLOW = Flow(name="setup", requires=("ht-poh.4.4", "ht-poh.4.7"), run=run)
diff --git a/scripts/agy-gate/flows/subagent.py b/scripts/agy-gate/flows/subagent.py
new file mode 100644
index 00000000..a77f6dc2
--- /dev/null
+++ b/scripts/agy-gate/flows/subagent.py
@@ -0,0 +1,73 @@
+"""``subagent``: the parent invokes a subagent (test-infra spec D7, research B shape).
+
+The child's conversation is listed under the parent's ``subagents/`` and has no presence lock;
+the child's request carries the subagent restriction ``systemMessage``; the binding generation and
+native session are unchanged and no new seat exists. Child and parent steps are routed by match.
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+GATE_DIR = Path(__file__).resolve().parent.parent
+for _dir in (GATE_DIR, GATE_DIR / "flows", GATE_DIR.parent / "agy-sandbox"):
+    if str(_dir) not in sys.path:
+        sys.path.insert(0, str(_dir))
+
+import _l4  # noqa: E402
+import _l5  # noqa: E402
+import observe  # noqa: E402
+from gate import Flow  # noqa: E402
+
+SCENARIO = GATE_DIR / "scenarios" / "subagent.json"
+
+
+def identity(binding):
+    return None if binding is None else (binding["seat_id"], binding["generation"], binding["native_session"])
+
+
+def run(world):
+    scenario = _l5.load_scenario(SCENARIO)
+    world.backend.load(scenario)
+    setup = world.setup_agy()
+    world.check("setup agy succeeds", setup.returncode == 0, (setup.stderr or setup.stdout).strip()[:200])
+    pane = world.start_agy()
+    # Genuine agy enrolls on its first turn (no SessionStart binding at startup), so enroll the parent first.
+    _l5.run_turn(world, pane, "PARENT-ENROLL hello", "enroll")
+    before = _l5.await_binding(world, lambda b: True)
+    world.check("the parent is enrolled before the subagent turn", before is not None,
+                "bindings=%s" % _l5.live_bindings(world))
+    seats_before = _l5.seat_count(world)
+    pane.prompt("PARENT-GO start")
+    child_request = _l5.await_step(world, "child", 60)
+    parent_final = _l5.await_step(world, "parent-final", 60)
+    # The subagent runs in the background; when it finishes, agy wakes the parent once more to read its report.
+    _l5.await_step(world, "parent-report", 60)
+    settled = pane.wait("idle", 60)
+    parent_call = _l5.request_for(world, "parent-call")
+    world.check("the parent invoked the subagent", parent_call is not None)
+    world.artifact("invoke-subagent-declaration.json", _l4.tool_declaration(world, parent_call, "invoke_subagent"))
+    world.check("the child request was served", child_request is not None)
+    world.check("the parent resumed after the child", parent_final is not None)
+    world.check("agy returned to idle", settled)
+    parent = before["native_session"] if before else None
+    children = observe.wait_until(lambda: _l5.subagent_listings(world, parent), 15) if parent else []
+    world.check("a child is listed under the parent's subagents/", bool(children),
+                "children=%s" % children)
+    locks = _l5.presence_ids(world)
+    world.check("the parent alone holds a presence lock", locks == [parent], "locks=%s" % locks)
+    world.check("no child has a presence lock", not (set(children) & set(locks)),
+                "children=%s locks=%s" % (children, locks))
+    world.check("the child's request carries the subagent restriction",
+                child_request is not None and _l5.has_child_restriction(child_request),
+                "system_messages=%s" % (child_request or {}).get("system_messages"))
+    after = _l5.live_binding(world)
+    world.check("binding generation and native session are unchanged", identity(after) == identity(before),
+                "before=%s after=%s" % (identity(before), identity(after)))
+    world.check("no new seat exists", _l5.seat_count(world) == seats_before == 1,
+                "before=%s after=%s" % (seats_before, _l5.seat_count(world)))
+    pane.exit()
+    _l5.finish_checks(world, scenario)
+
+
+FLOW = Flow(name="subagent", requires=("ht-poh.4.3",), run=run)
diff --git a/scripts/agy-gate/flows/unsetup.py b/scripts/agy-gate/flows/unsetup.py
new file mode 100644
index 00000000..1c873816
--- /dev/null
+++ b/scripts/agy-gate/flows/unsetup.py
@@ -0,0 +1,68 @@
+"""``unsetup``: a clean world and a pre-seeded member (test-infra spec D7).
+
+Owned files and the owned allow member are removed, other settings keys and other allow members
+stay, a member the user already had stays, and no seat is enrolled afterwards.
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+GATE_DIR = Path(__file__).resolve().parent.parent
+for _dir in (GATE_DIR, GATE_DIR / "flows", GATE_DIR.parent / "agy-sandbox"):
+    if str(_dir) not in sys.path:
+        sys.path.insert(0, str(_dir))
+
+import _l4  # noqa: E402
+import _l5  # noqa: E402
+from gate import Flow  # noqa: E402
+
+SCENARIO = GATE_DIR / "scenarios" / "unsetup.json"
+SEED_KEYS = ("altScreenMode", "modelProvider", "trustedWorkspaces")
+
+
+def run(world):
+    scenario = _l4.load_scenario(SCENARIO)
+    world.backend.load(scenario)
+
+    # Clean world: the member is ours, so unsetup removes it.
+    seed = _l4.read_settings(world) or {}
+    seed["permissions"] = {"allow": ["command(ls)"]}
+    _l4.write_settings(world, seed)
+    world.check("setup agy succeeds (clean)", world.setup_agy().returncode == 0)
+    status = _l4.setup_status(world)
+    world.check("allow entry is owned after setup", _l4.allow_state(status) == "owned", status.get("allow_entry"))
+    result = world.unsetup_agy()
+    world.check("unsetup agy succeeds", result.returncode == 0, (result.stderr or result.stdout).strip()[:200])
+    world.check("owned plugin files are gone", not _l4.plugin_files(world),
+                "left=%s" % sorted(_l4.plugin_files(world)))
+    world.check("the owned allow member is removed", _l4.ALLOW_RULE not in _l4.allow_members(world),
+                "allow=%s" % _l4.allow_members(world))
+    world.check("another allow member is kept", "command(ls)" in _l4.allow_members(world),
+                "allow=%s" % _l4.allow_members(world))
+    doc = _l4.read_settings(world) or {}
+    world.check("the other settings keys are kept", all(k in doc for k in SEED_KEYS), "keys=%s" % sorted(doc))
+
+    # Pre-seeded world: the user already had the member, so unsetup leaves it.
+    seed = dict(doc)
+    seed["permissions"] = {"allow": [_l4.ALLOW_RULE, "command(ls)"]}
+    _l4.write_settings(world, seed)
+    world.check("setup agy succeeds (pre-seeded)", world.setup_agy().returncode == 0)
+    status = _l4.setup_status(world)
+    world.check("allow entry is pre_existing", _l4.allow_state(status) == "pre_existing", status.get("allow_entry"))
+    result = world.unsetup_agy()
+    world.check("unsetup agy succeeds (pre-seeded)", result.returncode == 0,
+                (result.stderr or result.stdout).strip()[:200])
+    world.check("the pre-existing allow member is kept", _l4.ALLOW_RULE in _l4.allow_members(world),
+                "allow=%s" % _l4.allow_members(world))
+    world.check("the other allow member is kept too", "command(ls)" in _l4.allow_members(world))
+    world.check("owned plugin files are gone (pre-seeded)", not _l4.plugin_files(world))
+    doc = _l4.read_settings(world) or {}
+    world.check("the other settings keys are kept (pre-seeded)", all(k in doc for k in SEED_KEYS),
+                "keys=%s" % sorted(doc))
+    seats = _l5.seat_count(world)
+    world.check("no seat is enrolled", not seats, "seats=%s" % seats)
+    _l4.finish_checks(world, scenario)
+
+
+FLOW = Flow(name="unsetup", requires=("ht-poh.4.4",), run=run)
diff --git a/scripts/agy-gate/flows/wake.py b/scripts/agy-gate/flows/wake.py
new file mode 100644
index 00000000..8f2eaf44
--- /dev/null
+++ b/scripts/agy-gate/flows/wake.py
@@ -0,0 +1,223 @@
+"""``wake``: idle wake into the composer (test-infra spec D7, row ``wake`` (a)-(e), plus two roast rows).
+
+One world, one enrolled agy seat on one thread. A wake is a ``<USER_REQUEST>`` the gate did not type
+(``_l7.Typed`` tracks every prompt it did).
+
+a. ACK-required N1 to an idle agy: within 60 s an untyped request arrives and the same request's
+   system messages hold N1's frame (the woken turn's first ``PreInvocation`` injected it).
+b. Lazy-only Z1: no new main request within 15 s.
+c. N2 sent during a ``delay_ms`` busy step: no untyped request; N2 is delivered in-turn at the next
+   ``PreInvocation``.
+d. A draft is typed, N3 sent: no wake in 15 s and the draft is intact in the detection text.
+e. The model runs ``herdr-threads wake-on all`` through ``run_command``; lazy Z2 then wakes.
+f. A subagent generating (child ``delay_ms``): N4 sent, no wake while the ``Agent(<name>)`` row is live.
+g. A subagent running a tool (child ``run_command`` that blocks): N5 sent, no wake likewise.
+"""
+from __future__ import annotations
+
+import sys
+import time
+from pathlib import Path
+
+GATE_DIR = Path(__file__).resolve().parent.parent
+for _dir in (GATE_DIR, GATE_DIR / "flows", GATE_DIR.parent / "agy-sandbox"):
+    if str(_dir) not in sys.path:
+        sys.path.insert(0, str(_dir))
+
+import _l5  # noqa: E402
+import _l6  # noqa: E402
+import _l7  # noqa: E402
+import observe  # noqa: E402
+from gate import Flow  # noqa: E402
+
+DRAFT = "WAKE-DRAFT keep me"
+# Requests that follow a child's end are the parent's business and may not come (agy decides).
+OPTIONAL_SUB = ("g-child-final", "f-parent-after", "g-parent-after")
+
+
+def settle(world, pane, label):
+    world.check("%s: the agent returned to idle" % label, pane.wait("idle", 40))
+    if _l6.dismiss_survey(pane):
+        world.check("%s: the feedback survey was dismissed" % label, _l6.SURVEY not in _l6.screen_tail(pane, 20))
+    time.sleep(2)
+
+
+def phase_a(world, pane, sender, thread, typed):
+    base = _l7.untyped_count(world, typed)
+    n1 = _l6.send(world, sender, thread, "WAKE-N1 ack me", "--require-ack-pane", pane.pane_id)
+    world.check("a: N1 was sent", bool(n1))
+    wake = _l7.await_wake(world, typed, base)
+    world.check("a: within 60 s an untyped user request arrives (the wake)", wake is not None,
+                "untyped=%s" % _l7.untyped_count(world, typed))
+    world.check("a: the same request's system messages hold N1's frame", n1 in _l7.frames_of(wake),
+                "frames=%s n1=%s" % (_l7.frames_of(wake), n1))
+    world.artifact("a-wake-user-requests.json", (wake or {}).get("user_requests"))
+    observe.wait_until(lambda: _l6.receipt(world, n1).get("state") == "acked", 30)
+    world.check("a: the woken turn ACKed N1", _l6.receipt(world, n1).get("state") == "acked",
+                "receipt=%s" % _l6.receipt(world, n1))
+    settle(world, pane, "a")
+
+
+def phase_b(world, pane, sender, thread, typed):
+    z1 = _l6.send(world, sender, thread, "WAKE-Z1 lazy only", "--lazy")
+    world.check("b: Z1 was sent", bool(z1))
+    requests, untyped = _l7.quiet_window(world, typed)
+    world.check("b: no new main request within 15 s", requests == 0, "added=%s untyped=%s" % (requests, untyped))
+    world.check("b: Z1 is still pending", _l6.lazy_state(world, z1) == "pending", "state=%s" % _l6.lazy_state(world, z1))
+
+
+def phase_c(world, pane, sender, thread, typed):
+    base = _l7.untyped_count(world, typed)
+    typed.prompt(pane, "WAKE-BUSY-C go")
+    served = _l5.await_step(world, "c-busy", 30)
+    world.check("c: the busy turn was served", served is not None)
+    n2 = _l6.send(world, sender, thread, "WAKE-N2 mid turn", "--nudge")
+    world.check("c: N2 was sent during the busy step", bool(n2))
+    after = _l5.await_step(world, "c-after", 40)
+    world.check("c: N2 is delivered in-turn at the next PreInvocation",
+                after is not None and n2 in _l7.body_frames(world, after),
+                "frames=%s n2=%s" % (_l7.body_frames(world, after), n2))
+    settle(world, pane, "c")
+    follow_up = [r for r in observe.main_requests(world) if r.get("seq", 0) > (served or {}).get("seq", 0)][:1]
+    world.artifact("c-follow-up-body.json", _l7.body_json(world, follow_up[0]) if follow_up else None)
+    world.artifact("c-receipts.json", {"N2": _l6.receipt(world, n2), "tables": _l6.tables(world, "receipt_state")})
+    lines, seen = [], set()
+    for path in pane.transcripts():
+        try:
+            text = path.read_text(errors="replace")
+        except OSError:
+            continue
+        for line in text.splitlines():
+            if n2 and n2 in line and line not in seen:
+                seen.add(line)
+                lines.append(line)
+    world.artifact("c-transcript-n2.jsonl", "\n".join(lines) + "\n")
+    settled = observe.wait_until(lambda: _l6.receipt(world, n2).get("provenance") == "cooperative_hook_delivery", 20)
+    world.check("c: N2 settles (cooperative_hook_delivery) after the post-tool-call injection", bool(settled),
+                "N2=%s" % _l6.receipt(world, n2))
+    record = _l6.downgrade_record(world)
+    world.check("c: no injection miss is recorded and the identity is not downgraded",
+                record is None or (not record.get("misses") and record.get("downgraded_at") is None),
+                "downgrade.json=%s" % record)
+    world.check("c: no untyped user request during or after the busy turn", _l7.untyped_count(world, typed) == base,
+                "untyped %s -> %s" % (base, _l7.untyped_count(world, typed)))
+
+
+def phase_d(world, pane, sender, thread, typed):
+    base, requests = _l7.untyped_count(world, typed), len(observe.main_requests(world))
+    pane.draft(DRAFT)
+    observe.wait_until(lambda: DRAFT in pane.read_detection(), 10)
+    n3 = _l6.send(world, sender, thread, "WAKE-N3 while drafting", "--nudge")
+    world.check("d: N3 was sent", bool(n3))
+    added, untyped = _l7.quiet_window(world, typed)
+    detection = pane.read_detection()
+    world.artifact("d-detection.txt", detection)
+    world.check("d: no wake while a draft is in the composer", added == 0 and untyped == 0,
+                "added=%s untyped=%s" % (added, untyped))
+    world.check("d: the draft is intact in the detection text", DRAFT in detection)
+    world.check("d: no request was served while drafting", len(observe.main_requests(world)) == requests)
+    typed.submit_draft(pane, DRAFT)
+    served = _l5.await_step(world, "d-draft", 30)
+    world.check("d: the submitted draft is the turn that delivers N3",
+                served is not None and n3 in _l7.frames_of(served), "frames=%s" % _l7.frames_of(served))
+    settle(world, pane, "d")
+    world.check("d: still no untyped user request", _l7.untyped_count(world, typed) == base)
+
+
+def phase_e(world, pane, sender, thread, typed):
+    typed.prompt(pane, "WAKE-SETON go")
+    called = _l5.await_step(world, "e-set", 30)
+    world.check("e: the model's wake-on call was served", called is not None)
+    done = _l5.await_step(world, "e-done", 30)
+    world.check("e: the request after the call carries a run_command functionResponse",
+                done is not None and any(r.get("name") == "run_command" for r in done.get("function_responses") or []),
+                "responses=%s" % (done or {}).get("function_responses"))
+    settle(world, pane, "e")
+    rc, data = _l6.ht_json(world, ["wake-on"], pane=pane.pane_id)
+    world.artifact("e-wake-on.json", {"rc": rc, "data": data})
+    world.check("e: the seat's wake preference is now all", "all" in str(data), "data=%s" % data)
+    base = _l7.untyped_count(world, typed)
+    z2 = _l6.send(world, sender, thread, "WAKE-Z2 lazy", "--lazy")
+    world.check("e: Z2 was sent", bool(z2))
+    wake = _l7.await_wake(world, typed, base)
+    world.check("e: lazy Z2 wakes the idle agent", wake is not None, "untyped=%s" % _l7.untyped_count(world, typed))
+    world.check("e: the woken request holds Z2's frame", z2 in _l7.frames_of(wake), "frames=%s" % _l7.frames_of(wake))
+    settle(world, pane, "e")
+
+
+def subagent_phase(world, pane, sender, thread, typed, tag, prompt, child_step, final_step, body, window,
+                   after=True):
+    """The parent finishes at once while the child is held (research B), so Herdr reports the pane idle
+    with an ``Agent(<name>)`` row live: no wake may type into it. Once the row is gone the pending
+    note is owed (a wake, or an in-turn delivery)."""
+    base = _l7.untyped_count(world, typed)
+    typed.prompt(pane, prompt)
+    child = _l5.await_step(world, child_step, 40)
+    world.check("%s: the child request was served" % tag, child is not None)
+    note = _l6.send(world, sender, thread, body, "--nudge")
+    world.check("%s: the note was sent" % tag, bool(note))
+    time.sleep(2)
+    live = _l7.agent_row_live(pane)
+    world.artifact("%s-detection.txt" % tag, pane.read_detection())
+    world.check("%s: the Agent(<name>) row is live" % tag, live, "detection tail=%s" % pane.read_detection()[-300:])
+    requests, untyped = _l7.quiet_window(world, typed, window)
+    world.check("%s: no wake while the Agent row is live" % tag, untyped == 0,
+                "main requests added=%s untyped=%s" % (requests, untyped))
+    world.check("%s: the parent finished its turn" % tag, _l5.await_step(world, final_step, 60) is not None)
+    if not after:
+        # A blocked tool keeps the row until agy exits: the row stays live and still nothing wakes.
+        requests, untyped = _l7.quiet_window(world, typed, window)
+        world.check("%s: the row is still live and still no wake" % tag, untyped == 0 and _l7.agent_row_live(pane),
+                    "main requests added=%s untyped=%s" % (requests, untyped))
+        return
+    gone = observe.wait_until(lambda: not _l7.agent_row_live(pane), 90)
+    world.check("%s: the Agent row cleared" % tag, bool(gone))
+    wake = _l7.await_wake(world, typed, base)
+    delivered = [r for r in observe.main_requests(world) if note in _l7.frames_of(r)]
+    world.artifact("%s-after.json" % tag, {"note": note, "wake": bool(wake), "delivered_in": [r.get("seq") for r in delivered]})
+    world.check("%s: once the row is gone the pending note is delivered" % tag, bool(delivered),
+                "wake=%s untyped=%s" % (bool(wake), _l7.untyped_count(world, typed)))
+    settle(world, pane, tag)
+
+
+def run(world):
+    setup = _l6.setup(world)
+    world.check("setup agy succeeds", setup.returncode == 0, (setup.stderr or setup.stdout).strip()[:200])
+    sender = world.sender()
+    typed = _l7.Typed()
+    pane = _l6.start_agy(world)
+    scenario = _l7.load(world, "wake")
+    typed.prompt(pane, "WAKE-WARM hello")
+    _l5.await_step(world, "warm", 30)
+    pane.wait("idle", 30)
+    binding = _l5.await_binding(world, lambda b: True)
+    world.check("the agy seat is enrolled", binding is not None)
+    if binding is None:
+        return
+    thread = _l6.create_thread(world, sender, "gate-wake")
+    invite, accept = _l6.join(world, sender, pane, thread, binding["seat_id"])
+    world.check("the sender invited the agy seat and it accepted", invite.returncode == 0 and accept.returncode == 0,
+                "invite=%s accept=%s" % (invite.stderr.strip(), accept.stderr.strip()))
+    _l5.await_step(world, "wake-join", 10)
+    settle(world, pane, "join")
+    phase_a(world, pane, sender, thread, typed)
+    phase_b(world, pane, sender, thread, typed)
+    phase_c(world, pane, sender, thread, typed)
+    phase_d(world, pane, sender, thread, typed)
+    phase_e(world, pane, sender, thread, typed)
+    world.check("wake: every step consumed", not _l6.unconsumed(world, scenario, ("wake-join",)),
+                "unconsumed=%s" % _l6.unconsumed(world, scenario, ("wake-join",)))
+    sub = _l7.load(world, "wake-subagent", thread=thread)
+    subagent_phase(world, pane, sender, thread, typed, "f", "WAKE-PGEN go", "f-child", "f-parent-final",
+                   "WAKE-N4 during a generating subagent", 12)
+    subagent_phase(world, pane, sender, thread, typed, "g", "WAKE-PTOOL go", "g-child-call", "g-parent-final",
+                   "WAKE-N5 during a subagent tool", 12, after=False)
+    world.check("subagent: every step consumed", not _l6.unconsumed(world, sub, OPTIONAL_SUB),
+                "unconsumed=%s" % _l6.unconsumed(world, sub, OPTIONAL_SUB))
+    clean, detail = observe.backend_clean(world)
+    world.check("no unmatched or template-error request", clean, detail)
+    world.artifact("requests.json", world.backend.requests())
+    pane.exit()
+
+
+FLOW = Flow(name="wake", requires=("ht-poh.4.5", "ht-poh.5", "ht-poh.3.4", "ht-poh.3.6"), run=run)
diff --git a/scripts/agy-gate/gate.py b/scripts/agy-gate/gate.py
