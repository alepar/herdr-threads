+mod.files_written: [".claude-plugin/plugin.json","hooks/hooks.json","hooks/register.js","types/index.d.ts"]
+mod.managed_policy: {"state":"none"}
+mod.note: an install does not prove any session loaded the mod
+mod.settings_value: <root>/state/claude-mod/herdr-threads
+mod.shell_env: none
+note: installed is not observed: run `herdr-threads doctor` for native evidence. Claude sessions that run with another CLAUDE_CONFIG_DIR, or with --setting-sources excluding `user`, do not load these hooks
+observed: unknown
+permissions.action: advised
+permissions.allow: []
+permissions.ask: []
+permissions.manifest: <root>/state/setup/claude-permissions-<hash32>.json
