index 00000000..c63914a3
--- /dev/null
+++ b/tests/delivery/promotion.rs
@@ -0,0 +1,112 @@
+//! Push-channel promotion of `wake_on: all` lazy rows (delivery-policy DP8):
+//! the wire omits `wakes` when false, and the drain emits a waking lazy row as
+//! a `message` item with no ACK to run.
+use super::*;
+use crate::delivery::assemble::{Assembler, DeliveryKind};
+use crate::protocol::{
+    ids::{MessageId, SeatId, ThreadId},
+    pagination::{Consistency, Page, StopReason},
+    results::InboxBatchV2Item,
+    watch::{WatchItem, truncation_marker_for},
+};
+
+fn lazy(id: &str, body: &str, wakes: bool) -> InboxBatchV2Item {
+    InboxBatchV2Item::LazyMessage {
+        thread: ThreadId::new("t1"),
+        topic_data: "topic".into(),
+        message: MessageId::new(id),
+        sequence: 1,
+        sender: Some(SeatId::new("sender")),
+        author_role: None,
+        relays_user: false,
+        user_intent: None,
+        author_role_backfilled: false,
+        body: body.into(),
+        body_start: 0,
+        body_end: body.len() as u64,
+        body_len: body.len() as u64,
+        wakes,
+    }
+}
+
+struct One(Option<Page<InboxBatchV2Item>>);
+impl PageSource for One {
+    fn page(&mut self, _cursor: Option<String>) -> Result<Page<InboxBatchV2Item>, PageError> {
+        Ok(self.0.take().expect("one page"))
+    }
+}
+
+fn drain(items: Vec<InboxBatchV2Item>) -> Vec<DeliveryItem> {
+    let mut source = One(Some(Page {
+        items,
+        next_cursor: None,
+        next_argv: None,
+        high_water_ordinal: 0,
+        scope_revision: None,
+        has_more: false,
+        stop_reason: StopReason::Complete,
+        consistency: Consistency::BoundedLive,
+    }));
+    let mut out = Vec::new();
+    drain_pages::<()>(&mut source, &mut Assembler::new(None), 1, 4, |event| {
+        if let DrainEvent::Item(item) = event {
+            out.push(item);
+        }
+        Ok(Stop::Continue)
+    })
+    .unwrap();
+    out
+}
+
+#[test]
+fn wire_omits_wakes_when_false_and_carries_it_when_true() {
+    let quiet = serde_json::to_value(lazy("m", "b", false)).unwrap();
+    assert!(quiet.as_object().unwrap().get("wakes").is_none(), "{quiet}");
+    assert_eq!(quiet["kind"], "lazy_message");
+    let waking = serde_json::to_value(lazy("m", "b", true)).unwrap();
+    assert_eq!(waking["wakes"], serde_json::json!(true));
+    // An older daemon's line (no `wakes` key) reads as not waking.
+    let back: InboxBatchV2Item = serde_json::from_value(quiet).unwrap();
+    assert_eq!(back, lazy("m", "b", false));
+    let back: InboxBatchV2Item = serde_json::from_value(waking).unwrap();
+    assert_eq!(back, lazy("m", "b", true));
+}
+
+#[test]
+fn non_waking_lazy_row_keeps_its_lazy_line() {
+    let items = drain(vec![lazy("quiet", "hello", false)]);
+    assert_eq!(items.len(), 1);
+    assert_eq!(items[0].kind, DeliveryKind::Lazy);
+    assert!(!items[0].message.ack_required);
+}
+
+#[test]
+fn waking_lazy_row_is_a_message_without_ack() {
+    let items = drain(vec![lazy("loud", "hello", true)]);
+    assert_eq!(items.len(), 1);
+    assert_eq!(items[0].kind, DeliveryKind::Message);
+    assert_eq!(items[0].id, MessageId::new("loud"));
+    assert!(!items[0].message.ack_required);
+    assert_eq!(items[0].message.body, "hello");
+    // The cli maps the kind to the frozen watch item.
+    assert!(matches!(
+        match items[0].kind {
+            DeliveryKind::Lazy => WatchItem::Lazy(items[0].message.clone()),
+            DeliveryKind::Message => WatchItem::Message(items[0].message.clone()),
+        },
+        WatchItem::Message(_)
+    ));
+}
+
+#[test]
+fn promoted_row_truncation_marker_names_body_only() {
+    let body = "x".repeat(BODY_LIMIT_BYTES + 10);
+    let items = drain(vec![lazy("long", &body, true)]);
+    assert!(items[0].message.truncated);
+    assert!(!items[0].message.ack_required);
+    assert!(items[0].message.body.ends_with(&truncation_marker_for(
+        &[],
+        &MessageId::new("long"),
+        true
+    )));
+}
diff --git a/tests/delivery/push_channel.rs b/tests/delivery/push_channel.rs
new file mode 100644
index 00000000..5ad21f84
--- /dev/null
+++ b/tests/delivery/push_channel.rs
@@ -0,0 +1,155 @@
+//! The Claude push-channel re-fit (delivery-policy DP3, DP7, DP10): the neutral
+//! `NO_PUSH_CHANNEL` constants keep the frozen wire spelling, the `watch
+//! --harness` list is registry-derived and still `["claude"]`, and an idle
+//! wake is suppressed only for a channel whose policy says `Channel`.
+use super::*;
+use crate::ports::{ModSeatView, ModStoreReads};
+use crate::{
+    harness::{
+        adapter::{DeliveryMechanism, IdleWake},
+        registry::builtins,
+    },
+    protocol::{
+        ids::NativeSessionId,
+        results::ApiError,
+        time::MonoInstant,
+        watch::{WatchRefusalReason, WatchStatusReason},
+    },
+};
+use std::sync::atomic::AtomicI64;
+
+struct TestClock(AtomicI64);
+impl Clock for TestClock {
+    fn utc_now(&self) -> UtcMillis {
+        UtcMillis(self.0.load(Ordering::SeqCst))
+    }
+    fn monotonic_now(&self) -> MonoInstant {
+        MonoInstant(self.0.load(Ordering::SeqCst) as u64)
+    }
+}
+struct NoReads;
+impl ModStoreReads for NoReads {
+    fn mod_seat_view(
+        &self,
+        _seat: &SeatId,
+        _budget: &CallBudget,
+    ) -> Result<Option<ModSeatView>, ApiError> {
+        Ok(None)
+    }
+    fn mod_stall_oldest(
+        &self,
+        _seat: &SeatId,
+        _at_or_before: UtcMillis,
+        _body_limit: usize,
+        _budget: &CallBudget,
+    ) -> Result<Option<UtcMillis>, ApiError> {
+        Ok(None)
+    }
+}
+struct NullSink;
+impl ModChannelSink for NullSink {
+    fn push(&self, _frame: WatchFrame) -> bool {
+        true
+    }
+}
+
+fn registry(clock: &Arc<TestClock>) -> ModChannelRegistry {
+    ModChannelRegistry::new(
+        clock.clone(),
+        Arc::new(NoReads),
+        "instance".into(),
+        Arc::new(|| {}),
+        ModDeliverySetting::On,
+    )
+}
+fn register(registry: &ModChannelRegistry, seat: &str, idle_wake: IdleWake) {
+    registry
+        .register(
+            ModChannelRegistration {
+                seat: SeatId::new(seat),
+                binding_generation: 1,
+                native_session: NativeSessionId::new("native"),
+                harness: Harness::Claude,
+                idle_wake,
+                registered_at: UtcMillis(1_000),
+            },
+            Arc::new(NullSink),
+        )
+        .unwrap();
+}
+
+#[test]
+fn no_push_channel_keeps_the_frozen_not_claude_wire_spelling() {
+    assert_eq!(
+        serde_json::to_string(&WatchRefusalReason::NO_PUSH_CHANNEL).unwrap(),
+        "\"not_claude\""
+    );
+    assert_eq!(
+        serde_json::to_string(&WatchStatusReason::NO_PUSH_CHANNEL).unwrap(),
+        "\"not_claude\""
+    );
+    // A refusal still maps onto the same status reason.
+    assert_eq!(
+        WatchStatusReason::from(WatchRefusalReason::NO_PUSH_CHANNEL),
+        WatchStatusReason::NO_PUSH_CHANNEL
+    );
+}
+
+#[test]
+fn watch_harness_possible_values_are_exactly_claude() {
+    let command = crate::cli::commands::command_for_registry(builtins());
+    let watch = command.find_subcommand("watch").expect("watch subcommand");
+    let arg = watch
+        .get_arguments()
+        .find(|arg| arg.get_long() == Some("harness"))
+        .expect("--harness");
+    let values: Vec<String> = arg
+        .get_possible_values()
+        .iter()
+        .map(|value| value.get_name().to_owned())
+        .collect();
+    assert_eq!(values, ["claude"]);
+}
+
+#[test]
+fn only_claude_declares_the_push_channel_policy() {
+    let policy = builtins().delivery_policy("claude").expect("claude policy");
+    assert_eq!(policy.mechanism(), DeliveryMechanism::PushChannel);
+    assert_eq!(
+        policy.provenance(),
+        crate::protocol::authority::COOPERATIVE_MOD_DELIVERY_PROVENANCE
+    );
+    assert_eq!(policy.provenance(), "cooperative_mod_delivery");
+    assert_eq!(policy.idle_wake(), IdleWake::Channel);
+    assert!(builtins().delivery_policy("codex").is_none());
+    assert!(builtins().delivery_policy("hermes").is_none());
+}
+
+#[test]
+fn wake_suppressed_follows_the_registered_idle_wake() {
+    let clock = Arc::new(TestClock(AtomicI64::new(1_000)));
+    let registry = registry(&clock);
+    let native = SeatId::new("native-seat");
+    let channel = SeatId::new("channel-seat");
+    let absent = SeatId::new("absent-seat");
+    register(&registry, "native-seat", IdleWake::Native);
+    register(&registry, "channel-seat", IdleWake::Channel);
+    // Both channels are live, but only a `Channel` policy suppresses native wake.
+    assert!(registry.seat_live(&native));
+    assert!(!registry.wake_suppressed(&native));
+    assert!(registry.seat_live(&channel));
+    assert!(registry.wake_suppressed(&channel));
+    assert!(!registry.wake_suppressed(&absent));
+}
+
+#[test]
+fn wake_suppressed_ends_when_the_channel_grace_expires() {
+    let clock = Arc::new(TestClock(AtomicI64::new(1_000)));
+    let registry = registry(&clock);
+    let seat = SeatId::new("channel-seat");
+    register(&registry, "channel-seat", IdleWake::Channel);
+    let channel = registry.status().unwrap().channels.len();
+    assert_eq!(channel, 1);
+    registry.close(&seat, WatchCloseReason::Retired, UtcMillis(1_000));
+    assert!(!registry.wake_suppressed(&seat));
+}
