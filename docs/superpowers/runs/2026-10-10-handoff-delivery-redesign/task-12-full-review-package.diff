index 00000000..ab97f0bb
--- /dev/null
+++ b/scripts/agy-gate/flows/_l5.py
@@ -0,0 +1,137 @@
+"""Helpers shared by the L5 flows (enroll, subagent, clear, resume); not a flow itself.
+
+Flow-local DB queries over the read-only daemon database (test-infra spec D6 observation 1) and
+the request-log accessors the four flows share. The leading underscore keeps ``gate.discover`` from
+loading this module as a flow.
+"""
+from __future__ import annotations
+
+import json
+import sqlite3
+import sys
+from pathlib import Path
+
+GATE_DIR = Path(__file__).resolve().parent.parent
+for _dir in (GATE_DIR, GATE_DIR.parent / "agy-sandbox"):
+    if str(_dir) not in sys.path:
+        sys.path.insert(0, str(_dir))
+
+import observe  # noqa: E402
+
+# Opening words of ``harness::TOP_LEVEL_INSTRUCTION``: the startup check-in a top-level SessionStart injects.
+STARTUP_MARK = "Use inbox; follow its next: commands"
+# Opening words of ``harness::CHILD_RESTRICTION``: the restriction every role's context carries.
+CHILD_MARK = "Subagents may discover, read and summarize"
+SKILL_PATH = "skills/herdr-threads/SKILL.md"
+
+BINDING_SQL = ("SELECT seat_id, ordinal, generation, harness, native_session, observation_provenance "
+               "FROM occupant_bindings WHERE harness='agy' AND ended_at IS NULL "
+               "ORDER BY seat_id, ordinal DESC")
+
+
+def load_scenario(path):
+    return json.loads(Path(path).read_text())
+
+
+def query(world, sql):
+    """Rows of a read-only query as dicts; ``[]`` before the database or its tables exist."""
+    try:
+        conn = observe.db(world)
+        if conn is None:
+            return []
+        try:
+            return [dict(row) for row in conn.execute(sql).fetchall()]
+        finally:
+            conn.close()
+    except sqlite3.Error:
+        return []
+
+
+def live_bindings(world):
+    """The live (not ended) agy binding of each seat: the highest ordinal per seat."""
+    seen, out = set(), []
+    for row in query(world, BINDING_SQL):
+        if row["seat_id"] not in seen:
+            seen.add(row["seat_id"])
+            out.append(row)
+    return out
+
+
+def live_binding(world):
+    rows = live_bindings(world)
+    return rows[0] if len(rows) == 1 else None
+
+
+def seat_count(world):
+    rows = query(world, "SELECT count(*) AS n FROM seats")
+    return rows[0]["n"] if rows else None
+
+
+def presence_ids(world):
+    base = world.agy_data / "presence"
+    return sorted(p.name[:-len(".lock")] for p in base.glob("*.lock")) if base.is_dir() else []
+
+
+def subagent_listings(world, parent):
+    base = world.agy_data / "brain" / parent / ".system_generated" / "subagents"
+    return sorted(p.stem for p in base.glob("*.json")) if base.is_dir() else []
+
+
+def request_for(world, label):
+    """The first main request that consumed scenario step ``label``, or None."""
+    for request in observe.main_requests(world):
+        if request.get("step") == label:
+            return request
+    return None
+
+
+def await_step(world, label, timeout=30):
+    return observe.wait_until(lambda: request_for(world, label), timeout)
+
+
+def await_binding(world, pred, timeout=20):
+    return observe.wait_until(lambda: (lambda b: b if b is not None and pred(b) else None)(live_binding(world)),
+                              timeout)
+
+
+def run_turn(world, pane, text, label, timeout=30):
+    """Send a prompt, wait for the scripted step ``label`` to be served, then for the agent to idle."""
+    pane.prompt(text)
+    request = await_step(world, label, timeout)
+    settled = pane.wait("idle", timeout)
+    return request, settled
+
+
+def startup_count(request):
+    return sum(m.count(STARTUP_MARK) for m in request.get("system_messages", []))
+
+
+def has_startup(request):
+    return startup_count(request) > 0
+
+
+def has_child_restriction(request):
+    return any(CHILD_MARK in m for m in request.get("system_messages", []))
+
+
+def system_instruction_text(world, request):
+    """The request body's system instruction as JSON text ('' when the body was not saved)."""
+    rel = request.get("body")
+    if not rel:
+        return ""
+    try:
+        body = json.loads((Path(world.ctl) / rel).read_text())
+    except (OSError, ValueError):
+        return ""
+    instruction = body.get("systemInstruction") or body.get("system_instruction") or {}
+    return json.dumps(instruction)
+
+
+def finish_checks(world, scenario):
+    """Every step consumed, nothing unmatched, no template error (spec D7 closing rule)."""
+    clean, detail = observe.backend_clean(world)
+    world.check("no unmatched or template-error request", clean, detail)
+    used = {r.get("step") for r in observe.main_requests(world)}
+    missing = [s["label"] for s in scenario["steps"] if s["label"] not in used]
+    world.check("every scenario step was consumed", not missing, "unconsumed steps: %s" % missing)
+    world.artifact("requests.json", world.backend.requests())
diff --git a/scripts/agy-gate/flows/_l6.py b/scripts/agy-gate/flows/_l6.py
new file mode 100644
index 00000000..e00ba606
--- /dev/null
+++ b/scripts/agy-gate/flows/_l6.py
@@ -0,0 +1,246 @@
+"""Helpers shared by the L6 flows (delivery, downgrade); not a flow itself.
+
+Thread and message setup over the herdr-threads CLI, flow-local read-only queries over the daemon
+database (test-infra spec D6 observation 1), transcript reads, and the ``hooks.json`` edit that puts
+``step_mutator.py`` in front of the ``PreInvocation`` hook (spec D3). The leading underscore keeps
+``gate.discover`` from loading this module as a flow.
+"""
+from __future__ import annotations
+
+import json
+import re
+import shlex
+import sys
+from pathlib import Path
+
+GATE_DIR = Path(__file__).resolve().parent.parent
+for _dir in (GATE_DIR, GATE_DIR / "flows", GATE_DIR.parent / "agy-sandbox"):
+    if str(_dir) not in sys.path:
+        sys.path.insert(0, str(_dir))
+
+import _l4  # noqa: E402
+import _l5  # noqa: E402
+import agyenv  # noqa: E402
+import observe  # noqa: E402
+
+MUTATOR = GATE_DIR / "step_mutator.py"
+PYTHON = "/usr/bin/python3"
+# The D4 frame header (delivery-policy spec DP2), as the fake server and the daemon see it.
+_NAME = r'(?: "(?:[^"\\]|\\.)*")?'
+HEADER = re.compile(r"^\[herdr-threads\] (\S+) (\S+) in (\S+)" + _NAME + r" from (\S+)" + _NAME + r"(.*):$", re.M)
+OVERSIZE = 10 * 1024  # over the 8 KiB page budget, so the frame is truncated
+
+load_scenario = _l5.load_scenario
+query = _l5.query
+
+
+def data_of(doc):
+    """``result.data`` of a ``--json`` envelope (or the object itself)."""
+    if isinstance(doc, dict) and isinstance(doc.get("result"), dict) and "data" in doc["result"]:
+        return doc["result"]["data"]
+    return doc
+
+
+def ht_json(world, argv, pane=None, human=False):
+    """Run ``herdr-threads --json <argv>``; ``(returncode, decoded data or {})``."""
+    result = world.ht(["--json"] + list(argv), pane=pane, check=False, human=human)
+    try:
+        return result.returncode, data_of(json.loads(result.stdout))
+    except ValueError:
+        return result.returncode, {"_stdout": result.stdout, "_stderr": result.stderr}
+
+
+def screen_tail(pane, lines=30):
+    return "\n".join(pane.read_pane(80).splitlines()[-lines:])
+
+
+SURVEY = agyenv.SURVEY
+
+
+def dismiss_onboarding(pane, limit=10):
+    """Walk agy's first-run wizard (see ``AgyPane.dismiss_onboarding``)."""
+    return pane.dismiss_onboarding(limit)
+
+
+def dismiss_survey(pane):
+    """Skip agy's feedback survey (see ``AgyPane.dismiss_survey``)."""
+    return pane.dismiss_survey()
+
+
+def start_agy(world, **kwargs):
+    """``world.start_agy``, which already walks the first-run wizard."""
+    return world.start_agy(**kwargs)
+
+
+def setup(world):
+    """``setup agy --with-permissions`` as the operator of the isolated world (``World.setup_agy``)."""
+    return world.setup_agy()
+
+
+def first_id(data, keys):
+    """An id string from a result: the value itself, or the first of ``keys`` (searched depth first)."""
+    if isinstance(data, str):
+        return data
+    for key in keys:
+        hit = _l4.find(data, key)
+        if isinstance(hit, str):
+            return hit
+    if isinstance(data, dict) and len(data) == 1:
+        return first_id(next(iter(data.values())), keys)
+    return None
+
+
+def create_thread(world, sender, topic):
+    rc, data = ht_json(world, ["thread", "create", "--topic", topic], pane=sender.pane_id, human=True)
+    world.artifact("thread-create-%s.json" % topic, {"rc": rc, "data": data})
+    return first_id(data, ("thread_id", "thread", "id"))
+
+
+def join(world, sender, pane, thread, seat):
+    """The sender invites the agy seat and the agy pane accepts."""
+    invite = world.ht(["invite", thread, "--seat", seat], pane=sender.pane_id, check=False, human=True)
+    accept = world.ht(["accept", thread], pane=pane.pane_id, check=False)
+    return invite, accept
+
+
+def send(world, sender, thread, body, *flags):
+    """Send ``body``; the new message id (None when the send failed)."""
+    rc, data = ht_json(world, ["send", thread, "--body", body] + list(flags), pane=sender.pane_id, human=True)
+    world.artifact("send-%s.json" % re.sub(r"\W+", "_", body[:12]), {"rc": rc, "data": data})
+    return first_id(data, ("message_id", "message", "id")) if rc == 0 else None
+
+
+def tables(world, *names):
+    return {name: query(world, "SELECT * FROM %s" % name) for name in names}
+
+
+def receipt(world, message_id):
+    """``{state, actor, provenance}`` of the one recipient's receipt for ``message_id`` (``{}`` when none).
+
+    ``provenance`` is the ``action_provenance`` of the recorded ACK observation (None while pending)."""
+    rows = query(world, "SELECT state, ack_actor_seat_id, ack_observation FROM receipt_state "
+                        "WHERE message_id='%s'" % message_id)
+    if not rows:
+        return {}
+    try:
+        observation = json.loads(rows[0]["ack_observation"] or "{}")
+    except ValueError:
+        observation = {}
+    return {"state": rows[0]["state"], "actor": rows[0]["ack_actor_seat_id"],
+            "provenance": observation.get("action_provenance"), "observation": observation}
+
+
+def lazy_state(world, message_id):
+    """``pending`` or ``displayed`` (a completed lazy delivery); None when the message is not lazy."""
+    rows = query(world, "SELECT state FROM lazy_recipients WHERE message_id='%s'" % message_id)
+    return rows[0]["state"] if rows else None
+
+
+def transcript_text(pane):
+    """Concatenated text of every transcript file the pane's agy wrote."""
+    out, seen = [], set()
+    for path in pane.transcripts():
+        try:
+            text = path.read_text(errors="replace")
+        except OSError:
+            continue
+        if text not in seen:  # brain/ and conversations/ may expose the same file twice
+            seen.add(text)
+            out.append(text)
+    return "\n".join(out)
+
+
+def system_texts(request):
+    return list((request or {}).get("system_messages") or [])
+
+
+def frame_ids_in(texts):
+    ids = []
+    for text in texts:
+        ids.extend(m.group(2) for m in HEADER.finditer(text))
+    return ids
+
+
+def hooks_path(world):
+    return _l4.plugin_dir(world) / "hooks.json"
+
+
+def install_mutator(world):
+    """Prefix the ``PreInvocation`` command with ``step_mutator.py --ctl <ctl> --`` (spec D3).
+
+    Returns the original ``hooks.json`` bytes, to restore byte-identically."""
+    path = hooks_path(world)
+    original = path.read_bytes()
+    doc = json.loads(original.decode("utf-8"))
+    prefix = " ".join(shlex.quote(p) for p in (PYTHON, "-I", str(MUTATOR), "--ctl", str(world.ctl), "--"))
+    for entries in doc.values():
+        for handler in entries["PreInvocation"]:
+            handler["command"] = prefix + " " + handler["command"]
+    path.write_bytes((json.dumps(doc, separators=(",", ":")) + "\n").encode("utf-8"))
+    return original
+
+
+def restore_hooks(world, original):
+    hooks_path(world).write_bytes(original)
+
+
+def arm(world, mode="abort"):
+    fired = Path(world.ctl) / "mutate-fired"
+    if fired.exists():
+        fired.unlink()
+    (Path(world.ctl) / ("mutate-armed" if mode == "abort" else "mutate-armed-ignore")).write_text("")
+
+
+def fired(world):
+    path = Path(world.ctl) / "mutate-fired"
+    try:
+        return json.loads(path.read_text())
+    except (OSError, ValueError):
+        return None
+
+
+def doctor_delivery(world):
+    """The ``hooks.agy.delivery`` projection of ``doctor --json`` (``{}`` when absent).
+
+    Doctor resolves ``agy`` on ``PATH`` to judge whether a recorded downgrade still applies, so the
+    call puts the world's current executable clone first: the identity a running agy's hooks record."""
+    clone = world.root / "agybin" / str(world.stage_count)
+    env = {"PATH": "%s:%s" % (clone, world.herdr_env().get("PATH", "/usr/bin:/bin"))}
+    result = world.ht(["--json", "doctor"], check=False, env=env)
+    try:
+        data = data_of(json.loads(result.stdout))
+    except ValueError:
+        return {}
+    return _l4.find(data, "delivery") or {}
+
+
+def state_files(world):
+    """Adapter state files (delivery conversations and downgrade record) as ``{relative path: text}``."""
+    out = {}
+    for base in sorted(world.state.glob("**/adapter-state/agy")):
+        for path in sorted(base.rglob("*.json")):
+            try:
+                out[str(path.relative_to(base))] = path.read_text()
+            except OSError:
+                pass
+    return out
+
+
+def downgrade_record(world):
+    """The parsed ``downgrade.json`` of the adapter state (None when the adapter wrote none)."""
+    text = state_files(world).get("downgrade.json")
+    try:
+        return json.loads(text) if text else None
+    except ValueError:
+        return None
+
+
+def frame_in_transcript(text, message_id):
+    """True when a frame header line for ``message_id`` is in the transcript text."""
+    return re.search(r"\[herdr-threads\] \S+ %s in " % re.escape(message_id), text) is not None
+
+
+def unconsumed(world, scenario, optional=()):
+    """Labels of ``scenario`` steps no main request consumed, minus ``optional``."""
+    used = {r.get("step") for r in observe.main_requests(world)}
+    return [s["label"] for s in scenario["steps"] if s["label"] not in used and s["label"] not in optional]
diff --git a/scripts/agy-gate/flows/_l7.py b/scripts/agy-gate/flows/_l7.py
new file mode 100644
index 00000000..920c6520
--- /dev/null
+++ b/scripts/agy-gate/flows/_l7.py
@@ -0,0 +1,133 @@
+"""Helpers for the L7 wake flow; not a flow itself (the leading underscore keeps ``gate.discover`` out).
+
+A wake is a ``<USER_REQUEST>`` the gate did not type (test-infra spec D7, row ``wake``). The fake
+server logs every ``<USER_REQUEST>`` of a request's whole history, so the count of untyped entries
+in the longest such list is monotonic, and a wake is a rise of that count over a baseline.
+"""
+from __future__ import annotations
+
+import sys
+import time
+from pathlib import Path
+
+GATE_DIR = Path(__file__).resolve().parent.parent
+for _dir in (GATE_DIR, GATE_DIR / "flows", GATE_DIR.parent / "agy-sandbox"):
+    if str(_dir) not in sys.path:
+        sys.path.insert(0, str(_dir))
+
+import _l5  # noqa: E402
+import _l6  # noqa: E402
+import observe  # noqa: E402
+
+SCEN = GATE_DIR / "scenarios"
+QUIET_WINDOW = 15  # seconds a "no wake" check watches (spec D7 (b), (d))
+WAKE_WINDOW = 60  # seconds a wake may take (spec D7 (a), (e))
+
+
+class Typed(object):
+    """Every prompt the gate submitted, so a ``<USER_REQUEST>`` it did not type is exactly a wake."""
+
+    def __init__(self):
+        self.texts = []
+
+    def prompt(self, pane, text):
+        self.texts.append(text.strip())
+        return pane.prompt(text)
+
+    def submit_draft(self, pane, text):
+        """Enter on a draft the gate typed with ``pane.draft``: from now on it counts as typed."""
+        self.texts.append(text.strip())
+        return pane.keys("Enter")
+
+    def untyped(self, request):
+        return untyped_entries(request, self.texts)
+
+
+def untyped_entries(request, typed):
+    """The request's ``<USER_REQUEST>`` entries that contain none of the ``typed`` prompts."""
+    return [u for u in (request or {}).get("user_requests") or []
+            if not any(t and t in u for t in typed)]
+
+
+def untyped_count(world, typed):
+    """The most untyped entries any main request has carried so far."""
+    return max([len(untyped_entries(r, typed.texts)) for r in observe.main_requests(world)] or [0])
+
+
+def first_wake(world, typed, baseline):
+    """The first main request whose untyped entries exceed ``baseline`` (the wake's request), or None."""
+    for request in observe.main_requests(world):
+        if len(typed.untyped(request)) > baseline:
+            return request
+    return None
+
+
+def await_wake(world, typed, baseline, timeout=WAKE_WINDOW):
+    return observe.wait_until(lambda: first_wake(world, typed, baseline), timeout)
+
+
+def quiet_window(world, typed, seconds=QUIET_WINDOW):
+    """Watch ``seconds``; ``(main requests added, untyped entries added)`` over it."""
+    requests, untyped = len(observe.main_requests(world)), untyped_count(world, typed)
+    deadline = time.monotonic() + seconds * observe.TIMEOUT_SCALE
+    while time.monotonic() < deadline:
+        time.sleep(0.5)
+        if len(observe.main_requests(world)) != requests:
+            break
+    return len(observe.main_requests(world)) - requests, untyped_count(world, typed) - untyped
+
+
+def frames_of(request):
+    """Message ids framed in any of the request's system messages."""
+    return _l6.frame_ids_in(_l6.system_texts(request))
+
+
+def agent_row_live(pane):
+    """True while the pane's live region shows an ``Agent(<name>)`` row (the composer is Unreadable)."""
+    return any(line.strip().lstrip("●").strip().startswith("Agent(") for line in pane.read_detection().splitlines())
+
+
+def load(world, name, **variables):
+    scenario = _l6.load_scenario(SCEN / (name + ".json"))
+    scenario["vars"] = dict(scenario.get("vars", {}), cwd=str(world.ws), **variables)
+    world.backend.load(scenario)
+    return scenario
+
+
+await_step = _l5.await_step
+
+
+def body_json(world, request):
+    """The saved request body of ``request`` (None when it was not saved or does not parse)."""
+    import json
+    rel = (request or {}).get("body")
+    try:
+        return json.loads((Path(world.ctl) / rel).read_text())
+    except (OSError, TypeError, ValueError):
+        return None
+
+
+def body_frames(world, request):
+    """Message ids framed anywhere in the request body, including inside a ``functionResponse``.
+
+    A ``PreInvocation`` injection after a tool call rides in the tool result's ``output`` (genuine agy
+    1.3.2), where the fake server's ``system_messages`` (text parts only) does not see it."""
+    return frame_ids_in_body(body_json(world, request))
+
+
+def strings_of(node):
+    """Every string in a decoded JSON value, keys excluded."""
+    if isinstance(node, str):
+        yield node
+    elif isinstance(node, list):
+        for item in node:
+            for text in strings_of(item):
+                yield text
+    elif isinstance(node, dict):
+        for item in node.values():
+            for text in strings_of(item):
+                yield text
+
+
+def frame_ids_in_body(body):
+    return _l6.frame_ids_in(list(strings_of(body)))
diff --git a/scripts/agy-gate/flows/allow_rewrite.py b/scripts/agy-gate/flows/allow_rewrite.py
new file mode 100644
index 00000000..1ddb9c13
--- /dev/null
+++ b/scripts/agy-gate/flows/allow_rewrite.py
@@ -0,0 +1,73 @@
+"""``allow-rewrite``: does agy drop the allow member when the user trusts a workspace (test-infra spec D7)?
+
+Starts agy in an untrusted workspace ``ws2``, accepts the trust prompt, and records whether agy
+rewrote ``settings.json`` without the owned member. Either outcome is a finding, written to the
+``allow-rewrite-finding.json`` artifact and the check detail. When agy did drop it, ``setup-status``
+must say ``missing`` and a plain ``setup agy`` (the consent-free Ask path, keeping the recorded grant)
+must add it back as ``owned``.
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+GATE_DIR = Path(__file__).resolve().parent.parent
+for _dir in (GATE_DIR, GATE_DIR / "flows", GATE_DIR.parent / "agy-sandbox"):
+    if str(_dir) not in sys.path:
+        sys.path.insert(0, str(_dir))
+
+import _l4  # noqa: E402
+from gate import Flow  # noqa: E402
+
+SCENARIO = GATE_DIR / "scenarios" / "allow-rewrite.json"
+TRUST_WORDS = ("trust", "do you want")
+
+
+def run(world):
+    scenario = _l4.load_scenario(SCENARIO)
+    world.backend.load(scenario)
+    world.check("setup agy succeeds", world.setup_agy().returncode == 0)
+    world.check("allow entry is owned before agy runs",
+                _l4.allow_state(_l4.setup_status(world)) == "owned")
+    ws2 = world.root / "ws2"
+    ws2.mkdir(exist_ok=True)
+    trusted_before = (_l4.read_settings(world) or {}).get("trustedWorkspaces")
+    world.check("ws2 is not trusted yet", str(ws2) not in (trusted_before or []), "trusted=%s" % trusted_before)
+
+    shell = _l4.shell_pane(world, "agy-ws2", cwd=ws2)
+    pane = _l4.adopt_agy_pane(world, shell)
+    world.start_agy(pane=shell)
+    screen = pane.read_pane()
+    prompted = any(word in screen.lower() for word in TRUST_WORDS)
+    world.artifact("trust-prompt-screen.txt", screen)
+    if prompted:
+        pane.keys("Enter")
+    pane.wait("idle", 30)
+    pane.exit()
+
+    settings = _l4.read_settings(world) or {}
+    trusted_after = settings.get("trustedWorkspaces") or []
+    dropped = _l4.ALLOW_RULE not in _l4.allow_members(world)
+    status = _l4.setup_status(world)
+    finding = {"trust_prompt_seen": prompted, "ws2_trusted_after": str(ws2) in trusted_after,
+               "agy_dropped_allow_member": dropped, "allow_state": _l4.allow_state(status),
+               "settings_keys": sorted(settings), "allow": _l4.allow_members(world)}
+    world.artifact("allow-rewrite-finding.json", finding)
+    world.check("finding recorded: agy %s the allow member on trust accept" %
+                ("dropped" if dropped else "kept"), True, finding)
+    world.check("ws2 is trusted after accepting the prompt", str(ws2) in trusted_after or not prompted,
+                "trusted=%s prompted=%s" % (trusted_after, prompted))
+    if dropped:
+        world.check("setup-status reports the allow entry missing", _l4.allow_state(status) == "missing",
+                    status.get("allow_entry"))
+        rc, _ = _l4.setup_json(world, permissions=False)
+        world.check("plain setup agy keeps the recorded grant and re-adds the member", rc == 0 and _l4.ALLOW_RULE in _l4.allow_members(world),
+                    "allow=%s" % _l4.allow_members(world))
+        world.check("the re-added member is owned", _l4.allow_state(_l4.setup_status(world)) == "owned")
+    else:
+        world.check("setup-status still reports the allow entry owned", _l4.allow_state(status) == "owned",
+                    status.get("allow_entry"))
+    _l4.finish_checks(world, scenario)
+
+
+FLOW = Flow(name="allow-rewrite", requires=("ht-poh.4.4",), run=run)
diff --git a/scripts/agy-gate/flows/boot.py b/scripts/agy-gate/flows/boot.py
new file mode 100644
index 00000000..bb2ef580
--- /dev/null
+++ b/scripts/agy-gate/flows/boot.py
@@ -0,0 +1,86 @@
+"""``boot``: the infrastructure self-proof flow (test-infra spec D7). No setup.
+
+Prompt "hi"; the scenario replies BOOT-OK. Checks Herdr detects agent ``agy``, exactly one
+main request reached the fake server, BOOT-OK is on the pane, and the sandbox denies the
+real ``~/.gemini`` and a non-loopback connect with EPERM.
+"""
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+GATE_DIR = Path(__file__).resolve().parent.parent
+for _dir in (GATE_DIR, GATE_DIR.parent / "agy-sandbox"):
+    if str(_dir) not in sys.path:
+        sys.path.insert(0, str(_dir))
+
+import agyenv  # noqa: E402
+import observe  # noqa: E402
+from gate import Flow  # noqa: E402
+
+SCENARIO = GATE_DIR / "scenarios" / "boot.json"
+CONNECT = ("import errno,socket,sys\n"
+           "s=socket.socket(); s.settimeout(5)\n"
+           "try:\n    s.connect(('192.0.2.1',443))\n"
+           "except OSError as e:\n    print(errno.errorcode.get(e.errno,'?')); sys.exit(0)\n"
+           "print('CONNECTED')\n")
+
+
+def sandboxed(world, argv, profile=None, timeout=30):
+    profile = str(profile or world.root / "loopback.sb")
+    return subprocess.run([agyenv.SANDBOX_EXEC, "-f", profile] + argv, stdin=subprocess.DEVNULL,
+                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True,
+                          timeout=timeout)
+
+
+def eperm(result):
+    return result.returncode != 0 and "Operation not permitted" in result.stderr
+
+
+def sandbox_self_test(world):
+    """The rendered profile denies the real ~/.gemini and any non-loopback connect with EPERM.
+
+    A missing real ~/.gemini yields ENOENT before the sandbox is consulted, so the rule is also
+    proven against a sentinel ``.gemini`` under a stand-in home inside the root."""
+    gemini = Path(agyenv.real_home()) / ".gemini"
+    denied = sandboxed(world, ["/bin/ls", str(gemini)])
+    absent = not gemini.exists()
+    world.check("sandbox denies the real ~/.gemini", eperm(denied) or (absent and denied.returncode != 0),
+                "exists=%s rc=%s stderr=%s" % (not absent, denied.returncode, denied.stderr.strip()[:200]))
+    fake_home = world.root / "fakehome"
+    (fake_home / ".gemini").mkdir(parents=True, exist_ok=True)
+    (fake_home / ".gemini" / "sentinel").write_text("x")
+    profile = world.root / "sentinel.sb"
+    profile.write_text(agyenv.render_profile(world.root, fake_home))
+    sentinel = sandboxed(world, ["/bin/ls", str(fake_home / ".gemini")], profile=profile)
+    world.check("sandbox profile denies a present .gemini with EPERM", eperm(sentinel),
+                "rc=%s stderr=%s" % (sentinel.returncode, sentinel.stderr.strip()[:200]))
+    probe = sandboxed(world, ["/usr/bin/python3", "-I", "-c", CONNECT])
+    world.check("sandbox denies a non-loopback connect with EPERM",
+                probe.stdout.strip() == "EPERM",
+                "stdout=%s stderr=%s" % (probe.stdout.strip(), probe.stderr.strip()[:200]))
+
+
+def run(world):
+    scenario = json.loads(SCENARIO.read_text())
+    world.backend.load(scenario)
+    pane = world.start_agy()
+    detected = pane.agent_name()
+    world.check("herdr detects agent agy", detected == "agy", "agent=%r" % (detected,))
+    pane.prompt("hi")
+    shown = observe.wait_until(lambda: "BOOT-OK" in pane.read_pane(), 30)
+    pane.wait("idle", 30)
+    world.artifact("pane-final.txt", pane.read_pane())
+    world.check("BOOT-OK appears in the pane", bool(shown))
+    mains = observe.main_requests(world)
+    world.check("exactly one main request reached the fake server", len(mains) == 1,
+                "main requests=%d" % len(mains))
+    clean, detail = observe.backend_clean(world)
+    world.check("no unmatched or template-error request", clean, detail)
+    sandbox_self_test(world)
+    world.artifact("requests.json", world.backend.requests())
+
+
+FLOW = Flow(name="boot", requires=("ht-poh.6.1",), run=run)
diff --git a/scripts/agy-gate/flows/clear.py b/scripts/agy-gate/flows/clear.py
new file mode 100644
index 00000000..5b40a540
--- /dev/null
+++ b/scripts/agy-gate/flows/clear.py
@@ -0,0 +1,58 @@
+"""``clear``: ``agent prompt /clear``, then a prompt (test-infra spec D7).
+
+Same seat, binding generation +1, native session equal to the new conversation id, and the
+startup check-in appears again in the post-clear conversation.
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+GATE_DIR = Path(__file__).resolve().parent.parent
+for _dir in (GATE_DIR, GATE_DIR / "flows", GATE_DIR.parent / "agy-sandbox"):
+    if str(_dir) not in sys.path:
+        sys.path.insert(0, str(_dir))
+
+import _l5  # noqa: E402
+from gate import Flow  # noqa: E402
+
+SCENARIO = GATE_DIR / "scenarios" / "clear.json"
+
+
+def run(world):
+    scenario = _l5.load_scenario(SCENARIO)
+    world.backend.load(scenario)
+    setup = world.setup_agy()
+    world.check("setup agy succeeds", setup.returncode == 0, (setup.stderr or setup.stdout).strip()[:200])
+    pane = world.start_agy()
+    pre, _ = _l5.run_turn(world, pane, "PRE-CLEAR-PROMPT hello", "pre-clear")
+    world.check("the pre-clear step was served", pre is not None)
+    before = _l5.await_binding(world, lambda b: True)
+    world.check("the seat is enrolled before /clear", before is not None, "bindings=%s" % _l5.live_bindings(world))
+    pre_startup = pre is not None and _l5.has_startup(pre)
+    world.check("the pre-clear request carries the startup check-in", pre_startup)
+    pane.prompt("/clear")
+    pane.wait("idle", 30)
+    post, settled = _l5.run_turn(world, pane, "POST-CLEAR-PROMPT hello", "post-clear")
+    world.check("the post-clear step was served", post is not None)
+    world.check("agy returned to idle", settled)
+    if before is not None:
+        after = _l5.await_binding(world, lambda b: b["generation"] != before["generation"])
+        world.check("same seat after /clear", after is not None and after["seat_id"] == before["seat_id"],
+                    "before=%s after=%s" % (before, after))
+        world.check("binding generation advanced by one",
+                    after is not None and after["generation"] == before["generation"] + 1,
+                    "before=%s after=%s" % (before["generation"], (after or {}).get("generation")))
+        new_ids = [i for i in _l5.presence_ids(world) if i != before["native_session"]]
+        world.check("native session is the new conversation id",
+                    after is not None and after["native_session"] != before["native_session"]
+                    and after["native_session"] in new_ids,
+                    "after=%s new_locks=%s" % ((after or {}).get("native_session"), new_ids))
+    world.check("no new seat exists", _l5.seat_count(world) == 1, "seats=%s" % _l5.seat_count(world))
+    world.check("the startup check-in appears again after /clear", post is not None and _l5.has_startup(post),
+                "system_messages=%s" % (post or {}).get("system_messages"))
+    pane.exit()
+    _l5.finish_checks(world, scenario)
+
+
+FLOW = Flow(name="clear", requires=("ht-poh.4.3",), run=run)
diff --git a/scripts/agy-gate/flows/delivery.py b/scripts/agy-gate/flows/delivery.py
new file mode 100644
index 00000000..4fe76ea0
--- /dev/null
+++ b/scripts/agy-gate/flows/delivery.py
@@ -0,0 +1,197 @@
+"""``delivery``: hook-pull delivery with transcript confirmation (test-infra spec D7, row ``delivery``).
+
+One world, four scenarios in turn, each on the same enrolled agy seat and thread. A phase keeps the
+agent busy on a scripted turn while the sender sends, so nothing wakes the idle agent early; the next
+turn's first invocation then finds every item pending and the ``PreInvocation`` hook injects them.
+
+1. ``delivery-stop``: an item injected on a turn's only model call is settled at ``Stop``
+   (``cooperative_hook_delivery``) and no idle wake follows.
+2. ``delivery-cancel``: an Esc-cancelled turn that injected an item records no injection miss.
+3. ``delivery-error``: a turn whose model call the fake server fails records no injection miss.
+4. ``delivery``: lazy L1, ordinary O1, ACK-required A1 and an oversize T1 arrive in one page; inv0
+   holds, so nothing is settled before the confirm; the model ACKs A1 through ``run_command`` (the
+   allow entry, no permission prompt); O1 settles at the next ``PreInvocation``, L1 completes, T1
+   stays pending, and the frame headers are in the transcript.
+"""
+from __future__ import annotations
+
+import sys
+import time
+from pathlib import Path
+
+GATE_DIR = Path(__file__).resolve().parent.parent
+for _dir in (GATE_DIR, GATE_DIR / "flows", GATE_DIR.parent / "agy-sandbox"):
+    if str(_dir) not in sys.path:
+        sys.path.insert(0, str(_dir))
+
+import _l4  # noqa: E402
+import _l5  # noqa: E402
+import _l6  # noqa: E402
+import observe  # noqa: E402
+from gate import Flow  # noqa: E402
+
+SCEN = GATE_DIR / "scenarios"
+HOOK_PROVENANCE = "cooperative_hook_delivery"
+
+
+def load(world, name):
+    scenario = _l6.load_scenario(SCEN / (name + ".json"))
+    scenario["vars"] = dict(scenario.get("vars", {}), cwd=str(world.ws))
+    world.backend.load(scenario)
+    return scenario
+
+
+def busy_turn_send(world, pane, sender, thread, prompt, busy_label, sends):
+    """Start a scripted busy turn, send ``sends`` (a list of ``(body, flags)``) while it runs, wait for
+    its end. Returns the sent message ids, in order."""
+    if _l6.dismiss_survey(pane):
+        world.check("%s: the feedback survey was dismissed" % busy_label, _l6.SURVEY not in _l6.screen_tail(pane, 20))
+    pane.prompt(prompt)
+    served = _l5.await_step(world, busy_label, 30)
+    world.check("%s: the busy turn was served" % busy_label, served is not None)
+    ids = [_l6.send(world, sender, thread, body, *flags) for body, flags in sends]
+    world.check("%s: every send succeeded" % busy_label, all(ids), "ids=%s" % ids)
+    world.check("%s: the busy turn ended" % busy_label, pane.wait("idle", 40))
+    return ids
+
+
+def no_miss(world, label):
+    record = _l6.downgrade_record(world)
+    world.check("%s: no injection miss is recorded and the identity is not downgraded" % label,
+                record is None or (not record.get("misses") and record.get("downgraded_at") is None),
+                "downgrade.json=%s" % record)
+
+
+def frames_in(request):
+    """Message ids framed in the request's ``PreInvocation`` system messages."""
+    return _l6.frame_ids_in([m for m in _l6.system_texts(request) if _l6.HEADER.search(m)])
+
+
+def stop_phase(world, pane, sender, thread, scenario):
+    [o2] = busy_turn_send(world, pane, sender, thread, "STOP-BUSY start", "stop-busy",
+                          [("STOP-NOTE ordinary", ("--nudge",))])
+    pane.prompt("STOP-GO now")
+    request = _l5.await_step(world, "stop-inv0", 30)
+    world.check("stop: the injecting turn's request was served", request is not None)
+    world.check("stop: the item's frame is in that request", o2 in frames_in(request), "ids=%s" % frames_in(request))
+    world.check("stop: the agent returned to idle", pane.wait("idle", 30))
+    settled = observe.wait_until(lambda: _l6.receipt(world, o2).get("provenance") == HOOK_PROVENANCE, 8)
+    world.check("stop: the item injected on the turn's last model call is settled at Stop "
+                "(cooperative_hook_delivery)", bool(settled), "receipt=%s" % _l6.receipt(world, o2))
+    count = len(observe.main_requests(world))
+    time.sleep(10)
+    world.check("stop: no idle wake followed", len(observe.main_requests(world)) == count,
+                "requests %s -> %s" % (count, len(observe.main_requests(world))))
+    world.check("stop: frame header is in the transcript", _l6.frame_in_transcript(_l6.transcript_text(pane), o2))
+    world.check("stop: every step consumed", not _l6.unconsumed(world, scenario, ("stop-tail",)),
+                "unconsumed=%s" % _l6.unconsumed(world, scenario, ("stop-tail",)))
+
+
+def cancel_phase(world, pane, sender, thread):
+    scenario = load(world, "delivery-cancel")
+    busy_turn_send(world, pane, sender, thread, "CANCEL-BUSY start", "cancel-busy",
+                   [("CANCEL-NOTE ordinary", ("--nudge",))])
+    pane.prompt("CANCEL-GO now")
+    request = _l5.await_step(world, "cancel-inv0", 30)
+    world.check("cancel: the injecting turn's request was served", request is not None)
+    started = time.monotonic()
+    pane.keys("Escape")
+    world.check("cancel: Esc ended the held turn", pane.wait("idle", 15))
+    world.check("cancel: the turn ended well before the 20 s hold", time.monotonic() - started < 15,
+                "took %.1fs" % (time.monotonic() - started))
+    time.sleep(3)
+    no_miss(world, "cancel")
+    world.check("cancel: every step consumed", not _l6.unconsumed(world, scenario, ("cancel-tail",)))
+
+
+def error_phase(world, pane, sender, thread):
+    scenario = load(world, "delivery-error")
+    busy_turn_send(world, pane, sender, thread, "ERROR-BUSY start", "error-busy",
+                   [("ERROR-NOTE ordinary", ("--nudge",))])
+    pane.prompt("ERROR-GO now")
+    request = _l5.await_step(world, "error-inv0", 30)
+    world.check("error: the failing request was served", request is not None)
+    world.check("error: the agent returned to idle", pane.wait("idle", 40))
+    time.sleep(3)
+    world.artifact("error-pane.txt", pane.read_pane(40))
+    no_miss(world, "error")
+    world.check("error: every step consumed", not _l6.unconsumed(world, scenario, ("error-tail",)))
+
+
+def main_phase(world, pane, sender, thread, seat):
+    scenario = load(world, "delivery")
+    ids = busy_turn_send(world, pane, sender, thread, "DELIV-BUSY start", "busy", [
+        ("MAIN-L1 lazy note", ("--lazy",)),
+        ("MAIN-O1 ordinary note", ("--nudge",)),
+        ("MAIN-A1 ack me", ("--require-ack-pane", pane.pane_id)),
+        ("MAIN-T1 " + "T" * _l6.OVERSIZE, ("--require-ack-pane", pane.pane_id)),
+    ])
+    l1, o1, a1, t1 = ids
+    pane.prompt("MAIN-GO now")
+    request = _l5.await_step(world, "inv0", 30)
+    snapshot = {i: _l6.receipt(world, i) for i in (o1, a1, t1)}
+    lazy_mid = _l6.lazy_state(world, l1)
+    world.check("delivery: inv0 was served", request is not None)
+    framed = frames_in(request)
+    world.check("delivery: inv0's system messages hold frames for L1, O1, A1 and T1",
+                all(i in framed for i in ids), "framed=%s ids=%s" % (framed, ids))
+    texts = " ".join(_l6.system_texts(request))
+    world.check("delivery: T1's frame is truncated", "truncated; run herdr-threads body %s" % t1 in texts)
+    world.check("delivery: nothing is settled during the hold",
+                all(r.get("state") == "pending" for r in snapshot.values()) and lazy_mid == "pending",
+                "receipts=%s lazy=%s" % (snapshot, lazy_mid))
+    blocked = []
+    final = observe.wait_until(lambda: (blocked.append(pane.agent_status() == "blocked"), _l5.request_for(world, "inv1"))[1], 40)
+    world.check("delivery: the ACK ran under the allow entry with no permission prompt",
+                final is not None and not any(blocked), "inv1=%s blocked=%s" % (final is not None, any(blocked)))
+    responses = (final or {}).get("function_responses") or []
+    world.check("delivery: the request after the ACK carries a run_command functionResponse",
+                any(r.get("name") == "run_command" for r in responses), "responses=%s" % responses)
+    world.check("delivery: the agent returned to idle", pane.wait("idle", 40))
+    observe.wait_until(lambda: _l6.receipt(world, o1).get("state") == "acked", 10)
+    r_o1, r_a1, r_t1 = (_l6.receipt(world, i) for i in (o1, a1, t1))
+    world.artifact("receipts.json", {"O1": r_o1, "A1": r_a1, "T1": r_t1})
+    world.check("delivery: O1 is settled with provenance cooperative_hook_delivery",
+                r_o1.get("state") == "acked" and r_o1.get("provenance") == HOOK_PROVENANCE, "O1=%s" % r_o1)
+    world.check("delivery: L1 is completed", _l6.lazy_state(world, l1) == "displayed")
+    world.check("delivery: A1 is ACKed by the agy seat", r_a1.get("state") == "acked" and r_a1.get("actor") == seat,
+                "A1=%s seat=%s" % (r_a1, seat))
+    world.check("delivery: T1 is still pending", r_t1.get("state") == "pending", "T1=%s" % r_t1)
+    transcript = _l6.transcript_text(pane)
+    world.check("delivery: frame headers for L1, O1, A1 are in the transcript",
+                all(_l6.frame_in_transcript(transcript, i) for i in (l1, o1, a1)))
+    world.check("delivery: every step consumed", not _l6.unconsumed(world, scenario, ("main-tail",)),
+                "unconsumed=%s" % _l6.unconsumed(world, scenario, ("main-tail",)))
+
+
+def run(world):
+    setup = _l6.setup(world)
+    world.check("setup agy succeeds", setup.returncode == 0, (setup.stderr or setup.stdout).strip()[:200])
+    sender = world.sender()
+    pane = _l6.start_agy(world)
+    stop_scenario = load(world, "delivery-stop")
+    _l5.run_turn(world, pane, "DELIV-WARM hello", "warm")
+    binding = _l5.await_binding(world, lambda b: True)
+    world.check("the agy seat is enrolled", binding is not None)
+    if binding is None:
+        return
+    seat = binding["seat_id"]
+    thread = _l6.create_thread(world, sender, "gate-delivery")
+    invite, accept = _l6.join(world, sender, pane, thread, seat)
+    world.check("the sender invited the agy seat and it accepted", invite.returncode == 0 and accept.returncode == 0,
+                "invite=%s accept=%s" % (invite.stderr.strip(), accept.stderr.strip()))
+    joined = _l5.await_step(world, "wake-join", 45)
+    world.check("the join's idle wake was served (wake-join on 'herdr-threads: wake up')", joined is not None)
+    pane.wait("idle", 30)
+    stop_phase(world, pane, sender, thread, stop_scenario)
+    cancel_phase(world, pane, sender, thread)
+    error_phase(world, pane, sender, thread)
+    main_phase(world, pane, sender, thread, seat)
+    clean, detail = observe.backend_clean(world)
+    world.check("no unmatched or template-error request", clean, detail)
+    world.artifact("requests.json", world.backend.requests())
+    world.artifact("state-files.json", _l6.state_files(world))
+    pane.exit()
+
+
+FLOW = Flow(name="delivery", requires=("ht-poh.5", "ht-poh.3.4"), run=run)
diff --git a/scripts/agy-gate/flows/downgrade.py b/scripts/agy-gate/flows/downgrade.py
new file mode 100644
index 00000000..cece46eb
--- /dev/null
+++ b/scripts/agy-gate/flows/downgrade.py
@@ -0,0 +1,218 @@
+"""``downgrade``: the forced downgrade to ``userMessage`` and its recovery (test-infra spec D7, D3).
+
+``step_mutator.py`` sits in front of the ``PreInvocation`` hook in the isolated HOME's owned
+``hooks.json``. Armed, it turns the hook's ``systemMessage`` step into a step agy rejects (``abort``)
+or silently ignores (``ignore``). The flow walks, on one enrolled seat:
+
+1. abort: the turn that injects M1 dies (no model request, an error in the pane), ``Stop`` records the
+   downgrade and ``doctor`` reports it for the executable identity;
+2. downgraded: M2 arrives as a ``user_requests`` entry (in no ``system_messages``) and settles;
+3. ``restage_agy()`` (a new executable identity) and ``--conversation <id>``: M3 is a
+   ``system_messages`` entry again;
+4. ignored step: one turn whose frame never reaches the transcript is one miss and no downgrade; a
+   miss on a second, distinct turn downgrades;
+5. ``hooks.json`` is restored byte-identically and ``setup-status`` reports ``current``.
+"""
+from __future__ import annotations
+
+import sys
+import time
+from pathlib import Path
+
+GATE_DIR = Path(__file__).resolve().parent.parent
+for _dir in (GATE_DIR, GATE_DIR / "flows", GATE_DIR.parent / "agy-sandbox"):
+    if str(_dir) not in sys.path:
+        sys.path.insert(0, str(_dir))
+
+import _l4  # noqa: E402
+import _l5  # noqa: E402
+import _l6  # noqa: E402
+import observe  # noqa: E402
+from gate import Flow  # noqa: E402
+
+SCEN = GATE_DIR / "scenarios"
+HOOK_PROVENANCE = "cooperative_hook_delivery"
+
+
+def load(world, name):
+    scenario = _l6.load_scenario(SCEN / (name + ".json"))
+    scenario["vars"] = dict(scenario.get("vars", {}), cwd=str(world.ws))
+    world.backend.load(scenario)
+    return scenario
+
+
+def busy_then(world, pane, sender, thread, label, busy_prompt, busy_step, body, go_prompt, arm=None, arm_late=None):
+    """A scripted busy turn during which ``body`` is sent (``arm`` arms the mutator once the busy
+    request is served, so the busy turn's own empty hook output cannot consume it; ``arm_late`` arms it
+    after the busy turn has ended and before ``go_prompt`` is typed, so the go turn's first hook
+    invocation is guaranteed to find it armed, ht-poh.46); then the turn
+    ``go_prompt`` starts, whose first invocation finds the item pending. Returns the message id."""
+    if _l6.dismiss_survey(pane):
+        world.check("%s: the feedback survey was dismissed" % label, _l6.SURVEY not in _l6.screen_tail(pane, 20))
+    pane.prompt(busy_prompt)
+    served = _l5.await_step(world, busy_step, 30)
+    world.check("%s: the busy turn was served" % label, served is not None)
+    if arm:
+        _l6.arm(world, arm)
+    message = _l6.send(world, sender, thread, body, "--nudge")
+    world.check("%s: the send succeeded" % label, bool(message))
+    world.check("%s: the busy turn ended" % label, pane.wait("idle", 40))
+    if arm_late:
+        _l6.arm(world, arm_late)
+    pane.prompt(go_prompt)
+    return message
+
+
+def delivery_downgrade(world):
+    """The ``downgrade`` object of ``doctor --json``'s delivery section (``{}`` when none)."""
+    return _l6.doctor_delivery(world).get("downgrade") or {}
+
+
+def abort_phase(world, pane, sender, thread, scenario):
+    m1 = busy_then(world, pane, sender, thread, "abort", "DOWN-BUSY1 start", "busy1",
+                   "DOWN-M1 abort me", "DOWN-GO1 now", arm="abort")
+    fired = observe.wait_until(lambda: _l6.fired(world), 20)
+    world.check("abort: the mutator fired", fired is not None)
+    world.artifact("abort-fired.json", fired or {})
+    world.check("abort: it recorded the original hook output with M1's frame",
+                bool(fired) and m1 in fired.get("frame_ids", []) and "systemMessage" in fired.get("original_stdout", ""),
+                "fired=%s" % str(fired)[:300])
+    record = observe.wait_until(lambda: (_l6.downgrade_record(world) or {}).get("downgraded_at"), 25)
+    world.check("abort: Stop recorded a downgrade", bool(record), "downgrade.json=%s" % _l6.downgrade_record(world))
+    time.sleep(3)
+    asked = [r.get("seq") for r in observe.main_requests(world) if (r.get("user_requests") or [""])[-1].startswith("DOWN-GO1")]
+    world.check("abort: no main request was made for the aborted turn", not asked, "requests=%s" % asked)
+    screen = pane.read_pane(60)
+    world.artifact("abort-pane.txt", screen)
+    world.check("abort: the pane shows the injection error",
+                any(word in screen.lower() for word in ("inject", "hook", "error")), screen[-300:])
+    down = observe.wait_until(lambda: delivery_downgrade(world), 10)
+    world.artifact("doctor-delivery-abort.json", _l6.doctor_delivery(world))
+    world.check("abort: doctor reports the downgrade (abort) for the identity",
+                (down or {}).get("reason") == "abort" and (down or {}).get("identity_current") is True, "downgrade=%s" % down)
+    return m1
+
+
+def user_message_phase(world, pane, sender, thread, scenario):
+    m2 = busy_then(world, pane, sender, thread, "downgraded", "DOWN-BUSY2 start", "busy2",
+                   "DOWN-M2 user message", "DOWN-GO2 now")
+    request = _l5.await_step(world, "m2-inv0", 40)
+    world.check("downgraded: M2's turn request was served", request is not None)
+    users = (request or {}).get("user_requests", [])
+    systems = _l6.system_texts(request)
+    world.check("downgraded: M2's frame is inside a user_requests entry",
+                any(m2 in u and "[herdr-threads]" in u for u in users), "user_requests=%s" % [u[:80] for u in users])
+    world.check("downgraded: M2's frame is in no system_messages entry", not any(m2 in s for s in systems))
+    world.check("downgraded: the agent returned to idle", pane.wait("idle", 30))
+    settled = observe.wait_until(lambda: _l6.receipt(world, m2).get("provenance") == HOOK_PROVENANCE, 15)
+    world.check("downgraded: M2 settles (cooperative_hook_delivery)", bool(settled), "M2=%s" % _l6.receipt(world, m2))
+    return m2
+
+
+def restage_phase(world, pane, sender, thread, conversation):
+    pane.exit()
+    world.restage_agy()
+    pane = _l6.start_agy(world, args=["--conversation", conversation], pane=pane.pane_id)
+    down = delivery_downgrade(world)
+    world.artifact("doctor-delivery-restaged.json", _l6.doctor_delivery(world))
+    world.check("restaged: the recorded downgrade no longer applies to the new executable identity",
+                not down or down.get("identity_current") is False, "downgrade=%s" % down)
+    m3 = busy_then(world, pane, sender, thread, "restaged", "DOWN-BUSY3 start", "busy3",
+                   "DOWN-M3 system message", "DOWN-GO3 now")
+    request = _l5.await_step(world, "m3-inv0", 40)
+    world.check("restaged: M3's turn request was served", request is not None)
+    world.check("restaged: M3 is in system_messages again",
+                any(m3 in s for s in _l6.system_texts(request)), "system=%s" % [s[:60] for s in _l6.system_texts(request)])
+    world.check("restaged: M3's frame is in no user_requests entry",
+                not any(m3 in u for u in (request or {}).get("user_requests", [])))
+    world.check("restaged: the agent returned to idle", pane.wait("idle", 30))
+    settled = observe.wait_until(lambda: _l6.receipt(world, m3).get("provenance") == HOOK_PROVENANCE, 15)
+    world.check("restaged: M3 settles (cooperative_hook_delivery)", bool(settled), "M3=%s" % _l6.receipt(world, m3))
+    return pane, m3
+
+
+def ignore_phase(world, pane, sender, thread):
+    scenario = load(world, "downgrade-ignore")
+    m4 = busy_then(world, pane, sender, thread, "ignored-1", "DOWN-IBUSY1 start", "ign-busy1",
+                   "DOWN-M4 ignored once", "DOWN-IGO1 now", arm="ignore")
+    fired = observe.wait_until(lambda: _l6.fired(world), 20)
+    world.check("ignored-1: the mutator fired in ignore mode", bool(fired) and fired.get("mode") == "ignore"
+                and m4 in fired.get("frame_ids", []), "fired=%s" % str(fired)[:300])
+    request = _l5.await_step(world, "ign-go1", 30)
+    world.check("ignored-1: the turn was served normally (agy ignored the step, no Stop error)", request is not None)
+    world.check("ignored-1: M4 is in no system_messages entry", not any(m4 in s for s in _l6.system_texts(request)))
+    world.check("ignored-1: the agent returned to idle", pane.wait("idle", 30))
+    time.sleep(3)
+    record = _l6.downgrade_record(world) or {}
+    world.check("ignored-1: one miss is recorded and nothing is downgraded",
+                len(record.get("misses", [])) == 1 and record.get("downgraded_at") is None, "downgrade.json=%s" % record)
+    world.check("ignored-1: M4's frame is absent from the transcript",
+                not _l6.frame_in_transcript(_l6.transcript_text(pane), m4))
+    world.check("ignored-1: doctor reports no downgrade", not delivery_downgrade(world))
+    # The second busy turn runs unarmed; the mutator is armed between that turn's end and IGO2, so the miss comes from IGO2.
+    m5 = busy_then(world, pane, sender, thread, "ignored-2", "DOWN-IBUSY2 start", "ign-busy2",
+                   "DOWN-M5 ignored twice", "DOWN-IGO2 now", arm_late="ignore")
+    request = _l5.await_step(world, "ign-go2", 40)
+    world.check("ignored-2: the second turn was served", request is not None)
+    world.check("ignored-2: the agent returned to idle", pane.wait("idle", 30))
+    downgraded = observe.wait_until(lambda: (_l6.downgrade_record(world) or {}).get("downgraded_at"), 15)
+    record = _l6.downgrade_record(world) or {}
+    world.check("ignored-2: misses on two distinct turns downgrade (misses)",
+                bool(downgraded) and record.get("reason") == "misses", "downgrade.json=%s" % record)
+    down = delivery_downgrade(world)
+    world.check("ignored-2: doctor reports the downgrade (misses)", down.get("reason") == "misses", "downgrade=%s" % down)
+    world.check("ignored-2: M5's frame is absent from the transcript",
+                not _l6.frame_in_transcript(_l6.transcript_text(pane), m5))
+    world.check("ignored: every step consumed", not _l6.unconsumed(world, scenario, ("ign-tail",)),
+                "unconsumed=%s" % _l6.unconsumed(world, scenario, ("ign-tail",)))
+
+
+def run(world):
+    scenario = load(world, "downgrade")
+    setup = _l6.setup(world)
+    world.check("setup agy succeeds", setup.returncode == 0, (setup.stderr or setup.stdout).strip()[:200])
+    sender = world.sender()
+    original = _l6.install_mutator(world)
+    world.check("the mutator prefixes the PreInvocation command",
+                "step_mutator.py" in _l6.hooks_path(world).read_text() and _l6.hooks_path(world).read_bytes() != original)
+    pane = _l6.start_agy(world)
+    _l5.run_turn(world, pane, "DOWN-WARM hello", "warm")
+    binding = _l5.await_binding(world, lambda b: True)
+    world.check("the agy seat is enrolled", binding is not None)
+    if binding is None:
+        return
+    seat, conversation = binding["seat_id"], binding["native_session"]
+    thread = _l6.create_thread(world, sender, "gate-downgrade")
+    # The idle wake exists only while the invitation is pending: an accept that lands first removes the
+    # reason to wake (ht-poh.46), so the wake is awaited between the invite and the accept.
+    invite = world.ht(["invite", thread, "--seat", seat], pane=sender.pane_id, check=False, human=True)
+    joined = _l5.await_step(world, "wake-join", 45)
+    world.check("the join's idle wake was served (wake-join on 'herdr-threads: wake up')", joined is not None)
+    pane.wait("idle", 30)
+    accept = world.ht(["accept", thread], pane=pane.pane_id, check=False)
+    world.check("the sender invited the agy seat and it accepted", invite.returncode == 0 and accept.returncode == 0,
+                "invite=%s accept=%s" % (invite.stderr.strip(), accept.stderr.strip()))
+
+    abort_phase(world, pane, sender, thread, scenario)
+    user_message_phase(world, pane, sender, thread, scenario)
+    pane, _ = restage_phase(world, pane, sender, thread, conversation)
+    world.check("downgrade: every step consumed", not _l6.unconsumed(world, scenario, ("tail",)),
+                "unconsumed=%s" % _l6.unconsumed(world, scenario, ("tail",)))
+    ignore_phase(world, pane, sender, thread)
+
+    pane.exit()
+    status = _l4.setup_status(world)
+    world.artifact("setup-status-mutated.json", status)
+    _l6.restore_hooks(world, original)
+    world.check("hooks.json is restored byte-identically", _l6.hooks_path(world).read_bytes() == original)
+    status = _l4.setup_status(world)
+    world.artifact("setup-status-restored.json", status)
+    world.check("setup-status reports current after the restore", status.get("plugin", {}).get("current") is True,
+                status.get("plugin"))
+    clean, detail = observe.backend_clean(world)
+    world.check("no unmatched or template-error request", clean, detail)
+    world.artifact("requests.json", world.backend.requests())
+    world.artifact("state-files.json", _l6.state_files(world))
+
+
+FLOW = Flow(name="downgrade", requires=("ht-poh.5", "ht-poh.4.7"), run=run)
