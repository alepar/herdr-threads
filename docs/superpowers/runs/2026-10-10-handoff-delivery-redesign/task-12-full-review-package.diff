+    )?;
+    tx.execute(
+        "INSERT INTO direct_threads(instance_id,seat_a,seat_b,thread_id) VALUES(?1,?2,?3,?4)",
+        params![instance, a.as_str(), b.as_str(), thread.as_str()],
