+    let (bearing, bytes) = out(AgyAdapter.encode(&admitted(), &event, &offer("T")).unwrap());
+    assert!(bearing);
+    let parsed: Value = serde_json::from_slice(&bytes).unwrap();
+    assert_eq!(
