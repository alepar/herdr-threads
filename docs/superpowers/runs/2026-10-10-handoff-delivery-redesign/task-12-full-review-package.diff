+def run(fx, *extra, base=None, head=None):
+    return subprocess.run(
+        [
+            SCRIPT,
+            "--base",
+            base or fx.sha_base,
+            "--head",
+            head or fx.sha_head,
+            "--repo",
+            fx.dir,
