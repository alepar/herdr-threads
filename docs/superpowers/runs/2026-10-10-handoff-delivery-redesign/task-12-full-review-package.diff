+            &view.fingerprint,
+            if carried_all {
+                None
+            } else {
+                view.newest_pending_notice
+            },
+        );
+        if with_attention {
+            blocks.push(FrameItem {
+                kind: "attention".to_owned(),
+                id: version.to_string(),
