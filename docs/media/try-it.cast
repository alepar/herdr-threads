8;2;252;232;195;48;2;28;27;25m    Black, rustfmt and Prettier use spaces). Where nothing dictates a style,  \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  \u2514 #25 mbWb64uNr saE8l8pHU 07:00Z                                            \u001b[0;38;2;146;131;116m\u2502\u001b[20;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    use spaces, enforced by the formatter and a CI check.                     \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m      Shared recommendation: Follow your language's established formatter (go\u2026\u001b[0;38;2;146;131;116m\u2502\u001b[21;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  - \u001b[0;1;38;2;252;232;195;48;2;28;27;25mTradeoff:\u001b[0;38;2;252;232;195;48;2;28;27;25m spaces give up tabs' per-reader adjustable indent width, which  \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    + 1 line (ctrl+t to expand)                                               \u001b[0;38;2;146;131;116m\u2502\u001b[22;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    matters for accessibility. In return, code looks the same everywhere and  \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[23;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    stays consistent across contributors.                                     \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;1;38;2;0;205;0;48;2;28;27;25m\u2022\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;1;38;2;252;232;195;48;2;28;27;25mRan\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;137;180;250;48;2;28;27;25mherdr-threads\u001b[0;38;2;205;214;244;48;2;28;27;25m ack mbWb64uNr\u001b[0;38;2;252;232;195;48;2;28;27;25m                                            