2;252;232;195;48;2;28;27;25m \u001b[0;38;2;137;180;250;48;2;28;27;25mherdr-threads\u001b[0;38;2;205;214;244;48;2;28;27;25m send t8HK3GC0u\u001b[0;38;2;147;153;178;48;2;28;27;25m --\u001b[0;38;2;235;160;172;48;2;28;27;25mbody\u001b[0;38;2;205;214;244;48;2;28;27;25m \u001b[0;38;2;166;227;161;48;2;28;27;25m'Bob 3: YAML forbids indentation ta\u2026\u001b[0;38;2;146;131;116m\u2502\u001b[18;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;255;255;255;48;2;28;27;25m\u23fa\u001b[0;38;2;252;232;195;48;2;28;27;25m Bob 3 came in and I posted the Shared recommendation (message mOegAr5Rz),   \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  \u2514 message_sent                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[19;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  with an acknowledgement requested from Bob.                                 \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    value: \"mnGcVl8qR\"                                                        \u001b[0;38;2;146;131;116m\u2502\u001b[21;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  - \u001b[0;1;38;2;252;232;195;48;2;28;27;25mBob 3:\u001b[0;38;2;252;232;195;48;2;28;27;25m He conceded that spaces survive copy-paste better and that YAML    \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[22;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    doesn't allow tab indentation. He also corrected my weak claim: indent    \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m\u2022 Posted Bob 3, addressing copy-paste and YAML constraints. Waiting for       \u001b[0;38;2;146;131;116m\u2502\u001b[23;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    guides don't change how wide spaces display. His last concern was forcing \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  Alice\u2019s Shared recommendation.                                              \u001b[0;38;2;146;131;116m\u2502\u001b[24;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    one convention on languages whose formatter already requires tabs.        \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[25;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  - \u001b[0;1;38;2;252;232;195;48;2;28;27;25mRecommendation:\u001b[0;38;2;252;232;195;48;2;28;27;25m Use spaces by default, enforced through the formatter and \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  Worked for 18s \u2022 08:13                                                      \u001b[0;38;2;146;131;116m\u2502\u001b[26;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    \u001b[0;38;2;175;215;255;48;2;28;27;25m.editorconfig\u001b[0;38;2;252;232;195;48;2;28;27;25m. Where a language's formatter requires tabs, as with gofmt  \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[27;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    and Makefiles, follow it.                                                 \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[28;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  - \u001b[0;1;38;2;252;232;195;48;2;28;27;25mTradeoff:\u001b[0;38;2;252;232;195;48;2;28;27;25m Spaces travel well and keep line-length limits consistent, but  \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;1;38;2;252;232;195;48;2;28;27;25m\u203a \u001b[0;38;2;252;232;195;48;2;28;27;25mherdr-threads: attention pending; run herdr-threads inbox                   \u001b[0;38;2;146;131;116m\u2502\u001b[29;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    readers can no longer set their own indent width. I conceded that indent  \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[30;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    guides don't solve this.                                                  \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[32;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  Now I'm waiting for Bob to confirm or name a remaining tradeoff.            \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  tradeoff.                                                                   \u001b[0;38;2;146;131;116m\u2502\u001b[33;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[34;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;148;148;148;48;2;28;27;25m\u273b\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;148;148;148;48;2;28;27;25mCogitated for 10s \u00b7 done 8:13 AM\u001b[0;38;2;252;232;195;48;2;28;27;25m                                  