[220.333333, "o", "\u001b[?25l\u001b[26;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;148;148;148;48;2;28;27;25m \u001b[0;38;2;252;232;195;48;2;28;27;25m Reading pending thread mail                                                 \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;1;38;2;0;205;0;48;2;28;27;25m\u2022\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;1;38;2;252;232;195;48;2;28;27;25mRan\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;137;180;250;48;2;28;27;25mherdr-threads\u001b[0;38;2;205;214;244;48;2;28;27;25m send t8HK3GC0u\u001b[0;38;2;147;153;178;48;2;28;27;25m --\u001b[0;38;2;235;160;172;48;2;28;27;25mbody\u001b[0;38;2;205;214;244;48;2;28;27;25m \u001b[0;38;2;166;227;161;48;2;28;27;25m'Bob 2: Mixed whitespace needs form\u2026\u001b[0;38;2;146;131;116m\u2502\u001b[33;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;215;135;135;48;2;28;27;25m\u2736\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;215;135;135;48;2;28;27;25mUnraveling\u2026 \u001b[0;38;2;148;148;148;48;2;28;27;25m(6s \u00b7 \u2193\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;148;148;148;48;2;28;27;25m175 tokens)\u001b[0;38;2;252;232;195;48;2;28;27;25m                                             \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[0m\u001b[60;2H\u001b[?25h"]
[220.416667, "o", "\u001b[?25l\u001b[3;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;255;255;255;48;2;28;27;25m\u23fa\u001b[0;38;2;252;232;195;48;2;28;27;25m Bob said he was ready, so I posted Alice 1 (message mxmIOH83e) and asked Bob\u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[4;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  to acknowledge it. My point was that spaces look the same in every tool,    \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m\u2022 Posted Bob 1, addressing alignment and asking about reader control and      \u001b[0;38;2;146;131;116m\u2502\u001b[5;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  while tabs break the alignment of wrapped lines and comments when people use\u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  accessibility. Waiting for Alice 2.                                         \u001b[0;38;2;146;131;116m\u2502\u001b[6;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  different tab widths. Now I'm waiting for Bob 1.                            \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[7;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  Worked for 22s \u2022 08:12                                                      \u001b[0;38;2;146;131;116m\u2502\u001b[8;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;148;148;148;48;2;28;27;25m\u273b\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;148;148;148;48;2;28;27;25mBaked for 9s \u00b7 done 8:11 AM\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                 \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[10;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;148;148;148;48;2;58;58;58m\u276f \u001b[0;38;2;255;255;255;48;2;58;58;58mherdr-threads: attention pending; run herdr-threads inbox\u001b[0;38;2;252;232;195;48;2;58;58;58m                   \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;1;38;2;252;232;195;48;2;28;27;25m\u203a \u001b[0;38;2;252;232;195;48;2;28;27;25mherdr-threads: attention pending; run herdr-threads inbox                   \u001b[0;38;2;146;131;116m\u2502\u001b[11;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[13;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m\u2022 I\u2019ll read Alice\u2019s next reply and address it.                                \u001b[0;38;2;146;131;116m\u2502\u001b[15;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  had argued that tabs let each reader choose their own indent width, which   \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;1;38;2;0;205;0;48;2;28;27;25m\u2022\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;1;38;2;252;232;195;48;2;28;27;25mRan\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;137;180;250;48;2;28;27;25mherdr-threads\u001b[0;38;2;205;214;244;48;2;28;27;25m inbox\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                     \u001b[0;38;2;146;131;116m\u2502\u001b[16;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  helps accessibility. I granted that, but said mixing tabs for indentation   \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  \u2514 message mQekLWib2 t8HK3GC0u#19 from sbOVgRcCC bytes 0..280/280: Tabs or s\u2026\u001b[0;38;2;146;131;116m\u2502\u001b[17;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  with spaces for alignment is fragile because the mix can't be seen. I also  \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m      Alice 2: Accessibility is fair, but tabs-indent/spaces-align is fragile\u2026\u001b[0;38;2;146;131;116m\u2502\u001b[18;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  noted that most formatters default to spaces, except gofmt. My new point is \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    + 2 lines (ctrl+t to expand)                                              \u001b[0;38;2;146;131;116m\u2502\u001b[19;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  that with tabs, a line-length limit like 80 columns can't be pinned down,   \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[20;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  since each reader's tab width differs. Now I'm waiting for Bob 2.           \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;1;38;2;0;205;0;48;2;28;27;25m\u2022\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;1;38;2;252;232;195;48;2;28;27;25mRan\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;137;180;250;48;2;28;27;25mherdr-threads\u001b[0;38;2;205;214;244;48;2;28;27;25m send t8HK3GC0u\u001