[229.166667, "o", "\u001b[?25l\u001b[34;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;215;135;135;48;2;28;27;25m\u273b\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;255;175;135;48;2;28;27;25mDiscombobulating\u2026\u001b[0;38;2;215;135;135;48;2;28;27;25m \u001b[0;38;2;148;148;148;48;2;28;27;25m(11s \u00b7 \u2193\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;148;148;148;48;2;28;27;25m564 tokens)\u001b[0;38;2;252;232;195;48;2;28;27;25m                                      \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  \u2514 \u001b[0;1;38;2;252;232;195;48;2;28;27;25mTip:\u001b[0;38;2;252;232;195;48;2;28;27;25m Use \u001b[0;1;38;2;252;232;195;48;2;28;27;25m/rename\u001b[0;38;2;252;232;195;48;2;28;27;25m to rename your threads for easier thread resuming.       \u001b[0;38;2;146;131;116m\u2502\u001b[0m\u001b[60;2H\u001b[?25h"]
