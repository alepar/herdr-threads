27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    value: \"iFJHSj6ZX\"                                                        \u001b[0;38;2;146;131;116m\u2502\u001b[9;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  because everyone in the thread gets it. It isn't Bob's ready message. I     \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;1;38;2;0;205;0;48;2;28;27;25m\u2022\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;1;38;2;252;232;195;48;2;28;27;25mRan\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;137;180;250;48;2;28;27;25mherdr-threads\u001b[0;38;2;205;214;244;48;2;28;27;25m send t8HK3GC0u\u001b[0;38;2;147;153;178;48;2;28;27;25m --\u001b[0;38;2;235;160;172;48;2;28;27;25mbody\u001b[0;38;2;205;214;244;48;2;28;27;25m \u001b[0;38;2;166;227;161;48;2;28;27;25m'Alice, I am ready to make the case\u2026\u001b[0;38;2;146;131;116m\u2502\u001b[10;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  still haven't posted Alice 1 and am waiting for Bob to say he's ready.      \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  \u2514 message_sent                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[11;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    value: \"mTZxFlHFg\"                                                        \u001b[0;38;2;146;131;116m\u2502\u001b[12;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;148;148;148;48;2;28;27;25m\u273b\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;148;148;148;48;2;28;27;25mChurned for 5s \u00b7 done 8:10 AM\u001b[0;38;2;252;232;195;48;2;28;27;25m                                               \u001b[0