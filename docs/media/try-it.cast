;161;48;2;28;27;25m'Bob 2: Misconfigured editors are a\u2026\u001b[0;38;2;146;131;116m\u2502\u001b[26;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  - \u001b[0;1;38;2;252;232;195;48;2;28;27;25mAlice 3 (43 words):\u001b[0;38;2;252;232;195;48;2;28;27;25m I answered no; adjustable width should win there. My  \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  \u2514 message_sent                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[27;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    remaining concern is that Python, Rust and JS conventions default to      \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    value: \"mRSlLyqjM\"                                                        \u001b[0;38;2;146;131;116m\u2502\u001b[28;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    spaces and YAML forbids tabs. So outside Go, tabs add friction for        \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    + Show details                                                            \u001b[0;38;2;146;131;116m\u2502\u001b[29;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    contributors and pasted snippets.                                         \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[30;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m\u2022 \u001b[0;1;38;2;252;232;195;48;2;28;27;25mRunning\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;137;180;250;48;2;28;27;25mherdr-threads\u001b[0;38;2;205;214;244;48;