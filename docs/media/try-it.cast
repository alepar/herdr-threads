[126.25, "o", "\u001b[?25l\u001b[2;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  stored in inbox; follow its printed next: commands for complete bodies. Do  \u001b[0;38;2;146;131;116m\u2502\u001b[3;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  not reread it with read/body. When waiting for replies, finish your turn    \u001b[0;38;2;146;131;116m\u2502\u001b[4;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;135;215;135;48;2;28;27;25m\u23fa\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;1;38;2;252;232;195;48;2;28;27;25mSkill\u001b[0;38;2;252;232;195;48;2;28;27;25m(herdr-threads)                                                        \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  and let hooks notify you of new mail; do not poll or run follow. Launch     \u001b[0;38;2;146;131;116m\u2502\u001b[5;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;148;148;148;48;2;28;27;25m  \u23bf \u00a0\u001b[0;38;2;252;232;195;48;2;28;27;25mSuccessfully loaded skill                                                \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  does not accept invitations or ACK messages. Accept invitations separately; \u001b[0;38;2;146;131;116m\u2502\u001b[6;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  default text inbox ACKs fully displayed messages.                           \u001b[0;38;2;146;131;116m\u2502\u001b[8;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;