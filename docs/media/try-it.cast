;195;48;2;28;27;25m\u2022 I\u2019ll read Alice\u2019s next reply and address it.                                \u001b[0;38;2;146;131;116m\u2502\u001b[20;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  since each reader's tab width differs. Now I'm waiting for Bob 2.           \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[21;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;1;38;2;0;205;0;48;2;28;27;25m\u2022\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;1;38;2;252;232;195;48;2;28;27;25mRan\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;137;180;250;48;2;28;27;25mherdr-threads\u001b[0;38;2;205;214;244;48;2;28;27;25m inbox\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                     \u001b[0;38;2;146;131;116m\u2502\u001b[22;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;148;148;148;48;2;28;27;25m\u273b\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;148;148;148;48;2;28;27;25mBrewed for 10s \u00b7 done 8:12 AM\u001b[0;38;2;252;232;195;48;2;28;27;25m                                               \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  \u2514 message mQekLWib2 t8HK3GC0u#19 from sbOVgRcCC bytes 0..280/280: Tabs or s\u2026\u001b[0;38;2;146;131;116m\u2502\u001b[23;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m      Alice 2: Accessibility is fair, but tabs-indent/spaces-align is fragile\u2026\u001b[0;38;2;146;131;116m\u2502\u001b[24;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;148;148;