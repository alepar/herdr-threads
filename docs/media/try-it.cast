[212.0, "o", "\u001b[?25l\u001b[3;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    alignment (\"smart tabs\"), and asked how spaces help readers who need wider\u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  before posting the next turn.                                               \u001b[0;38;2;146;131;116m\u2502\u001b[4;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    indentation for accessibility. I've acknowledged receiving it.            \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[5;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  - \u001b[0;1;38;2;252;232;195;48;2;28;27;25mAlice 2 (40 words):\u001b[0;38;2;252;232;195;48;2;28;27;25m I conceded that accessibility is the strongest        \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m\u25e6 \u001b[0;1;38;2;252;232;195;48;2;28;27;25mRunning\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;137;180;250;48;2;28;27;25mherdr-threads\u001b[0;38;2;205;214;244;48;2;28;27;25m follow tfvkDs0mf\u001b[0;38;2;147;153;178;48;2;28;27;25m --\u001b[0;38;2;235;160;172;48;2;28;27;25mrecent\u001b[0;38;2;205;214;244;48;2;28;27;25m 0\u001b[0;38;2;252;232;195;48;2;28;27;25m                           \u001b[0;38;2;146;131;116m\u2502\u001b[6;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    argument for tabs, since spaces only have weaker workarounds. My next     \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  \u2514 {\"message\":\"eodlA8DbS\",\"thread\":\"tfvkDs0mf\",\"author\":null,\"event_author\":\u2026\u001b[0;38;2;146;131;116m\u2502\u001b[7;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    concern is that smart tabs are fragile: one misconfigured editor breaks   \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    {\"message\":\"m7Eb5EfIu\",\"thread\":\"tfvkDs0mf\",\"author\":\"saE8l8pHU\",\"event_a\u2026\u001b[0;38;2;146;131;116m\u2502\u001b[8;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    the alignment, and keeping it consistent needs linters most teams lack.   \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    + 2 lines (ctrl+t to expand)                                              \u001b[0;38;2;146;131;116m\u2502\u001b[9;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[10;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  I'm waiting for Bob 2 without polling. I'll then answer his objection in    \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;1;38;2;0;205;0;48;2;28;27;25m\u2022\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;1;38;2;252;232;195;48;2;28;27;25mRan\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;137;180;250;48;2;28;27;25mherdr-threads\u001b[0;38;2;205;214;244;48;2;28;27;25m body m7Eb5EfIu\u001b[0;38;2;252;232;195;48;2;28;27;25m                                            \u001b[0;38;2;146;131;116m\u2502\u001b[11;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  Alice 3, and post the shared recommendation after Bob 3.                    \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  \u2514 #17 m7Eb5EfIu saE8l8pHU 06:59Z                                            \u001b[0;38;2;146;131;116m\u2502\u001b[12;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                               