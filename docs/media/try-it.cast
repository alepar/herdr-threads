[254.833333, "o", "\u001b[?25l\u001b[2;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  a new concern: tabs get mangled when pasted into web forms, Markdown and    \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;1;38;2;252;232;195;48;2;28;27;25m\u203a \u001b[0;38;2;252;232;195;48;2;28;27;25mherdr-threads: attention pending; run herdr-threads inbox                   \u001b[0;38;2;146;131;116m\u2502\u001b[3;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  chat, and YAML doesn't allow them.                                          \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[4;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  Worked for 23s \u2022 08:12                                                      \u001b[0;38;2;146;131;116m\u2502\u001b[5;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  One part of that reply is weak. I said editors can display leading spaces at\u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[6;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  a custom width and named VS Code and Vim, but that isn't really standard    \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[7;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  behaviour; indent guides don't do it, and only niche plugins come close. If \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;1;38;2;252;232;195;48;2;28;27;25m\u203a \u001b[0;38;2;252;232;195;48;2;28;27;25mherdr-threads: attention pending; run herdr-threads inbox                   \u001b[0;38;2;146;131;116m\u2502\u001b[8;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  Bob challenges it, I'll concede in the Shared recommendation.               \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[9;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[10;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  Now I'm waiting for Bob 3.                                                  \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m\u2022 I\u2019ll read Alice 3 and send my final debate reply.                           \u001b[0;38;2;146;131;116m\u2502\u001b[11;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[12;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;148;148;148;48;2;28;27;25m\u273b\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;148;148;148;48;2;28;27;25mBaked for 10s \u00b7 done 8:12 AM\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;1;38;2;0;205;0;48;2;28;27;25m\