[227.083333, "o", "\u001b[?25l\u001b[2;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;1;38;2;252;232;195;48;2;28;27;25m\u203a \u001b[0;38;2;252;232;195;48;2;28;27;25mherdr-threads: attention pending; run herdr-threads inbox                   \u001b[0;38;2;146;131;116m\u2502\u001b[3;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;148;148;148;48;2;58;58;58m\u276f \u001b[0;38;2;255;255;255;48;2;58;58;58mherdr-threads: attention pending; run herdr-threads inbox\u001b[0;38;2;252;232;195;48;2;58;58;58m                   \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  Worked for 22s \u2022 08:12                                                      \u001b[0;38;2;146;131;116m\u2502\u001b[5;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  \u001b[0;38;2;148;148;148;48;2;28;27;25mRan \u001b[0;1;38;2;148;148;148;48;2;28;27;25m2\u001b[0;38;2;148;148;148;48;2;28;27;25m shell commands \u001b[0;38;2;252;232;195;48;2;28;27;25m                                                       \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[6;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;1;38;2;252;232;195;48;2;28;27;25m\u203a \u001b[0;38;2;252;232;195;48;2;28;27;25mherdr-threads: attention pending; run herdr-threads inbox                   \u001b[0;38;2;146;131;116m\u2502\u001b[8;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  had argued that tabs let each reader choose their own indent width, which   \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[9;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  helps accessibility. I granted that, but said mixing tabs for indentation   \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m\u2022 I\u2019ll read Alice\u2019s next reply and address it.                                \u001b[0;38;2;146;131;116m\u2502\u001b[10;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  with spaces for alignment is fragile because the mix can't be seen. I also  \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[11;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  noted that most formatters default to spaces, except gofmt. My new point is \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;1;38;2;0;205;0;48;2;28;27;25m\u2022\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;1;38;2;252;232;195;48;2;28;27;25mRan\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;137;180;250;48;2;28;27;25mherdr-threads\u001b[0;38;2;205;214;244;48;2;28;27;25m inbox\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                     \u001b[0;38;2;146;131;116m\u2502\u001b[12;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  that with tabs, a line-length limit like 80 columns can't be pinned down,   \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  \u2514 message mQekLWib2 t8HK3GC0u#19 from sbOVgRcCC bytes 0..280/280: Tabs or s\u2026\u001b[0;38;2;146;131;116m\u2502\u001b[13;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  since each reader's tab width differs. Now I'm waiting for Bob 2.           \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m      Alice 2: Accessibility is fair, but tabs-indent/spaces-align is fragile\u2026\u001b[0;38;2;146;131;116m\u2502\u001b[14;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    + 2 lines (ctrl+t to expand)                                              \u001b[0;38;2;146;131;116m\u2502\u001b[15;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;148;148;148;48;2;28;27;25m\u273b\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;148;148;148;48;2;28;27;25mBrewed for 10s \u00b7 done 8:12 AM\u001b[0;38;2;252;232;195;48;2;28;27;25m                                               \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[16;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;1;38;2;0;205;0;48;2;28;27;25m\u2022\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;1;38;2;252;232;195;48;2;28;27;25mRan\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;137;180;250;48;2;28;27;25mherdr-threads\u001b[0;38;2;205;214;244;48;2;28;27;25m send t8HK3GC0u\u001b[0;38;2;147;153;178;48;2;28;27;25m --\u001b[0;38;2;235;160;172;48;2;28;27;25mbody\u001b[0;38;2;205;214;244;48;2;28;27;25m \u001b[0;38;2;166;227;161;48;2;28;27;25m'Bob 2: Mixed whitespace needs form\u2026\u001b[0;38;2;146;131;116m\u2502\u001b[17;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;148;148;148;48;2;58;58;58m\u276f \u001b[0;38;2;255;255;255;48;2;58;58;58mherdr-threads: attention pending; run herdr-threads inbox\u001b[0;38;2;252;232;195;48;2;58;58;58m                   \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  \u2514 message_sent                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[18;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    value: \"msAHSS5dQ\"                                                        \u001b[0;38;2;146;131;116m\u2502\u001b[19;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  \u001b[0;38;2;148;148;148;48;2;28;27;25mRan \u001b[0;1;38;2;148;148;148;48;2;28;27;25m2\u001b[0;38;2;148;148;148;48;2;28;27;25m shell commands \u001b[0;38;2;252;232;195;48;2;28;27;25m                                                       \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    + Show details                                                            \u001b[0;38;2;146;131;116m\u2502\u001b[20;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[21;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;255;255;255;48;2;28;27;25m\u23fa\u001b[0;38;2;252;232;195;48;2;28;27;25m I posted Alice 3 (message mAcm7uxbx) and asked Bob to acknowledge it. Bob   \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m\u2022 Posted Bob 2, addressing formatter support and line-length checks. Waiting  \u001b[0;38;2;146;131;116m\u2502\u001b[22;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  asked whether requiring spaces shuts out readers who need wider or narrower \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  for Alice 3.                                                                \u001b[0;38;2;146;131;116m\u2502\u001b[23;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  indentation. I replied that the risk is real but can be reduced, and raised \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[24;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  a new concern: tabs get mangled when pasted into web forms, Markdown and    \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  Worked for 23s \u2022 08:12                                                      \u001b[0;38;2;146;131;116m\u2502\u001b[26;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[27;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  One part of that reply is weak. I said editors can display leading spaces at\u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;1;38;2;252;232;195;48;2;28;27;25m\u203a \u001b[0;38;2;252;232;195;48;2;28;27;25mherdr-threads: attention pending; run herdr-threads inbox                   \u001b[0;38;2;146;131;116m\u2502\u001b[29;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  behaviour; indent guides don't do it, and only niche plugins come close. If \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[30;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  Bob challenges it, I'll concede in the Shared recommendation.               \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m\u2022 I\u2019ll read Alice 3 and send my final debate reply.                           \u001b[0;38;2;146;131;116m\u2502\u001b[31;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[32;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  Now I'm waiting for Bob 3.                                                  \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m\u2022 \u001b[0;1;38;2;252;232;195;48;2;28;27;25mRunning\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;137;180;250;48;2;28;27;25mherdr-threads\u001b[0;38;2;205;214;244;48;2;28;27;25m inbox\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                 \u001b[0;38;2;146;131;116m\u2502\u001b[33;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[34;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;148;148;148;48;2;28;27;25m\u273b\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;148;148;148;48;2;28;27;25mBaked for 10s \u00b7 done 8:12 AM\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m\u25e6 Working (6s \u2022 \u001b[0;1;38;2;252;232;195;48;2;28;27;25mesc\u001b[0;38;2;252;232;195;48;2;28;27;25m to interrupt)                                             \u001b[0;38;2;146;131;116m\u2502\u001b[0m\u001b[60;2H\u001b[?25h"]
[227.25, "o", "\u001b[?25l\u001b[2;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[3;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;148;148;148;48;2;58;58;58m\u276f \u001b[0;38;2;255;255;255;48;2;58;58;58mherdr-threads: attention pending; run herdr-threads inbox\u001b[0;38;2;252;232;195;48;2;58;58;58m                   \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;1;38;2;252;232;195;48;2;28;27;25m\u203a \u001b[0;38;2;252;232;195;48;2;28;27;25mherdr-threads: attention pending; run herdr-threads inbox                   \u001b[0;38;2;146;131;116m\u2502\u001b[6;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m\u2022 I\u2019ll read Alice\u2019s next reply and address it.                                \u001b[0;38;2;146;131;116m\u2502\u001b[8;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  had argued that tabs let each reader choose their own indent width, which   \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;1;38;2;0;205;0;48;2;28;27;25m\u2022\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;1;38;2;252;232;195;48;2;28;27;25mRan\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;137;180;250;48;2;28;27;25mherdr-threads\u001b[0;38;2;205;214;244;48;2;28;27;25m inbox\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                     \u001b[0;38;2;146;131;116m\u2502\u001b[9;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  helps accessibility. I granted that, but said mixing tabs for indentation   \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  \u2514 message mQekLWib2 t8HK3GC0u#19 from sbOVgRcCC bytes 0..280/280: Tabs or s\u2026\u001b[0;38;2;146;131;116m\u2502\u001b[10;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  with spaces for alignment is fragile because the mix can't be seen. I also  \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m      Alice 2: Accessibility is fair, but tabs-indent/spaces-align is fragile\u2026\u001b[0;38;2;146;131;116m\u2502\u001b[11;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  noted that most formatters default to spaces, except gofmt. My new point is \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    + 2 lines (ctrl+t to expand)                                              \u001b[0;38;2;146;131;116m\u2502\u001b[12;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  that with tabs, a line-length limit like 80 columns can't be pinned down,   \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[13;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  since each reader's tab width differs. Now I'm waiting for Bob 2.           \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;1;38;2;0;205;0;48;2;28;27;25m\u2022\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;1;38;2;252;232;195;48;2;28;27;25mRan\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;137;180;250;48;2;28;27;25mherdr-threads\u001b[0;38;2;205;214;244;48;2;28;27;25m send t8HK3GC0u\u001b[0;38;2;147;153;178;48;2;28;27;25m --\u001b[0;38;2;235;160;172;48;2;28;27;25mbody\u001b[0;38;2;205;214;244;48;2;28;27;25m \u001b[0;38;2;166;227;161;48;2;28;27;25m'Bob 2: Mixed whitespace needs form\u2026\u001b[0;38;2;146;131;116m\u2502\u001b[14;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  \u2514 message_sent                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[15;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;148;148;148;48;2;28;27;25m\u273b\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;148;148;148;48;2;28;27;25mBrewed for 10s \u00b7 done 8:12 AM\u001b[0;38;2;252;232;195;48;2;28;27;25m                                               \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    value: \"msAHSS5dQ\"                                                        \u001b[0;38;2;146;131;116m\u2502\u001b[16;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    + Show details                                                            \u001b[0;38;2;146;131;116m\u2502\u001b[17;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;148;148;148;48;2;58;58;58m\u276f \u001b[0;38;2;255;255;255;48;2;58;58;58mherdr-threads: attention pending; run herdr-threads inbox\u001b[0;38;2;252;232;195;48;2;58;58;58m                   \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[18;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m\u2022 Posted Bob 2, addressing formatter support and line-length checks. Waiting  \u001b[0;38;2;146;131;116m\u2502\u001b[19;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  \u001b[0;38;2;148;148;148;48;2;28;27;25mRan \u001b[0;1;38;2;148;148;148;48;2;28;27;25m2\u001b[0;38;2;148;148;148;48;2;28;27;25m shell commands \u001b[0;38;2;252;232;195;48;2;28;27;25m                                                       \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  for Alice 3.                                                                \u001b[0;38;2;146;131;116m\u2502\u001b[21;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;255;255;255;48;2;28;27;25m\u23fa\u001b[0;38;2;252;232;195;48;2;28;27;25m I posted Alice 3 (message mAcm7uxbx) and asked Bob to acknowledge it. Bob   \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  Worked for 23s \u2022 08:12                                                      \u001b[0;38;2;146;131;116m\u2502\u001b[22;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  asked whether requiring spaces shuts out readers who need wider or narrower \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u001b[24;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  a new concern: tabs get mangled when pasted into web forms, Markdown and    \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;1;38;2;252;232;195;48;2;28;27;25m\u203a \u001b[0;38;2;252;232;195;48;2;28;27;25mherdr-threads: attention pending; run herdr-threads inbox                   \u001b[0;38;2;146;131;116m\u2502\u001b[27;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  One part of that reply is weak. I said editors can display leading spaces at\u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m\u2022 I\u2019ll read Alice 3 and send my final debate reply.                           \u001b[0;38;2;146;131;116m\u2502\u001b[29;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  behaviour; indent guides don't do it, and only niche plugins come close. If \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;1;38;2;0;205;0;48;2;28;27;25m\u2022\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;1;38;2;252;232;195;48;2;28;27;25mRan\u001b[0;38;2;252;232;195;48;2;28;27;25m \u001b[0;38;2;137;180;250;48;2;28;27;25mherdr-threads\u001b[0;38;2;205;214;244;48;2;28;27;25m inbox\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                     \u001b[0;38;2;146;131;116m\u2502\u001b[30;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  Bob challenges it, I'll concede in the Shared recommendation.               \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  \u2514 message mAcm7uxbx t8HK3GC0u#23 from sbOVgRcCC bytes 0..263/263: Tabs or s\u2026\u001b[0;38;2;146;131;116m\u2502\u001b[31;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m                                                                              \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m      Alice 3: Exclusion risk is real but mitigable: editors can render leadi\u2026\u001b[0;38;2;146;131;116m\u2502\u001b[32;1H\u001b[0;38;2;146;131;116m\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m  Now I'm waiting for Bob 3.                                                  \u001b[0;38;2;146;131;116m\u2502\u2502\u001b[0;38;2;252;232;195;48;2;28;27;25m    + 2 lines (ctrl+t to expand)                                              \u001b[0;38;2;146;131;116m\u2502\u001b[0m\u001b[60;2H\u001b[?25h"]
